def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def din(v):
    """Formata dinheiro em reais de forma curta."""
    v = float(v)
    s = "-" if v < 0 else ""
    v = abs(v)
    if v >= 1_000_000_000:
        return "%sR$ %.2f bi" % (s, v / 1_000_000_000)
    if v >= 1_000_000:
        return "%sR$ %.2f mi" % (s, v / 1_000_000)
    if v >= 1_000:
        return "%sR$ %.0f mil" % (s, v / 1_000)
    return "%sR$ %.0f" % (s, v)


def poisson(lmbda):
    lmbda = max(0.05, min(6.0, lmbda))
    L = exp(-lmbda)
    k, p = 0, 1.0
    while True:
        p *= rng.random()
        if p <= L:
            return k
        k += 1
        if k > 12:
            return k


