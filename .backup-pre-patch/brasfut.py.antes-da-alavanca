def renovar(G):
    j = escolher_do_elenco(G, "Quem voce quer renovar? (0 cancela): ",
                           filtro=lambda x: not x.get("dono"))
    if not j:
        return
    ficha(G, j)
    pedido = int(j["salario"] * rng.uniform(1.05, 1.45))
    if j["idade"] <= 23 and j["pot"] - j["ovr"] > 8:
        pedido = int(pedido * 1.15)
    print("Ele pede algo perto de %s por mes para renovar." % cor(din(pedido), "neg"))
    for rodada in range(3):
        sal = ler_int("Salario oferecido (0 desiste): ", G, 0)
        if not sal:
            return
        if sal >= pedido:
            anos = ler_int("Anos (1 a 5): ", G, 1, 5) or 3
            j["salario"] = sal
            j["contrato"] = anos
            j["moral"] = clamp(j["moral"] + 12, 5, 100)
            print(cor("Renovado por %d ano(s)." % anos, "ok"))
            return
        if rodada == 2:
            print(cor("Ele recusou e vai ouvir o mercado.", "ruim"))
            j["moral"] = clamp(j["moral"] - 8, 5, 100)
            return
        print(cor("Recusado. O empresario insiste nos %s." % din(pedido), "av"))


def rescindir(G):
    c = G["clubes"][G["clube"]]
    j = escolher_do_elenco(G, "Quem voce quer dispensar? (0 cancela): ",
                           filtro=lambda x: not x.get("dono"))
    if not j:
        return
    multa = int(j["salario"] * 4 * max(1, j["contrato"]) * 0.5)
    print("Rescindir custa %s de multa e libera %s por mes." % (cor(din(multa), "ruim"), din(j["salario"])))
    if not ler("Confirmar? (s/n) ", G).lower().startswith("s"):
        return
    if multa > c["dinheiro"]:
        print(cor("Caixa insuficiente para pagar a multa.", "ruim"))
        return
    c["dinheiro"] -= multa
    c["elenco"].remove(j["id"])
    if j["id"] in c.get("escalacao", []):
        c["escalacao"].remove(j["id"])
    j["clube"] = None
    j["listado"] = 0
    j["emp_listado"] = 0
    G["livres"].append(j["id"])
    print(cor("%s foi dispensado." % j["nome"], "ok"))



