    dir2 = "caixa %s %s folha %s" % (cor(din(c["dinheiro"]), caixa_cor), p,
                                     din(folha_semanal(G, c) * 4))
    esp2 = LARG - 4 - visivel(dir2)
    if visivel(esq) > esp2:
        esq = esq[:max(0, esp2 - 1)] + tr("pt")
    linhas.append(pad(esq, esp2) + dir2)
