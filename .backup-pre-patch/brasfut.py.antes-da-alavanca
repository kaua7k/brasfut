def ler(txt, G=None):
    try:
        return input(txt).strip()
    except EOFError:
        if G is not None:
            G["auto"] = True
        return ""


def ler_int(txt, G=None, minimo=None, maximo=None):
    s = ler(txt, G)
    try:
        v = int(s.replace(".", "").replace(",", ""))
    except ValueError:
        return None
    if minimo is not None and v < minimo:
        return None
    if maximo is not None and v > maximo:
        return None
    return v


