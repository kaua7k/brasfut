def sorteia_autor(G, esc, pesos):
    cand, w = [], []
    for pid in esc:
        j = G["jogadores"][pid]
        peso = pesos[j["pos"]] * (0.55 + j["ovr"] / 100.0)
        if peso > 0:
            cand.append(pid)
            w.append(peso)
    if not cand:
        return None
    return rng.choices(cand, weights=w)[0]


def publico_e_renda(G, casa, fora, comp):
    cap = casa["capacidade"]
    rel = fora["reputacao"] / max(30.0, casa["reputacao"])
    atrat = 0.30 + 0.22 * min(1.6, rel) + 0.0035 * casa["reputacao"]
    if comp != "liga":
        atrat += 0.06
    preco_ref = clamp(casa["reputacao"] * 0.9, 12, 95)
    elast = clamp(1.35 - 0.55 * (casa["preco"] / max(8.0, preco_ref)), 0.15, 1.35)
    taxa = clamp(atrat * elast * rng.uniform(0.82, 1.18), 0.05, 0.99)
    pub = int(cap * taxa)
    renda = int(pub * casa["preco"])
    return pub, renda


def simular(G, casa_id, fora_id, comp="liga", neutro=False):
    casa, fora = G["clubes"][casa_id], G["clubes"][fora_id]
    at_c, de_c, esc_c = forcas(G, casa, comp)
    at_f, de_f, esc_f = forcas(G, fora, comp)
    # quem estava de gancho nesta competicao cumpre um jogo por ficar de fora
    cumprir_suspensao(G, casa, comp)
    cumprir_suspensao(G, fora, comp)

    pub, renda = (0, 0)
    fator_casa = 1.0
    if not neutro:
        pub, renda = publico_e_renda(G, casa, fora, comp)
        ocup = pub / max(1, casa["capacidade"])
        fator_casa = 1.10 + 0.10 * ocup
        casa["dinheiro"] += renda

    xg_c = 1.22 * ((at_c / max(25.0, de_f)) ** EXP_FORCA) * fator_casa
    xg_f = 1.10 * ((at_f / max(25.0, de_c)) ** EXP_FORCA)
    xg_c *= rng.uniform(0.80, 1.22)
    xg_f *= rng.uniform(0.80, 1.22)

    gc, gf = poisson(xg_c), poisson(xg_f)
    eventos = []
    for lado, gols, esc in ((0, gc, esc_c), (1, gf, esc_f)):
        for _ in range(gols):
            autor = sorteia_autor(G, esc, GOL_W)
            assist = sorteia_autor(G, esc, ASS_W)
            if assist == autor:
                assist = None
            if autor:
                G["jogadores"][autor]["g"] += 1
                G["jogadores"][autor]["car_g"] += 1
            if assist and assist != autor:
                G["jogadores"][assist]["a"] += 1
            eventos.append((rng.randint(1, 92), lado, "gol", autor, assist))

    # desgaste, cartoes, lesoes
    for esc, dono, lado in ((esc_c, casa, 0), (esc_f, fora, 1)):
        fad_min, fad_max, mult_cartao = CUSTO_TATICA.get(dono["tatica"], (9, 20, 1.0))
        for pid in esc:
            j = G["jogadores"][pid]
            j["j"] += 1
            j["car_j"] += 1
            j["j_mes"] = j.get("j_mes", 0) + 1
            j["cond"] = clamp(j["cond"] - rng.randint(fad_min, fad_max), 5, 100)
            peso_cartao = RISCO_CARTAO[j["pos"]] * mult_cartao
            if rng.random() < 0.214 * peso_cartao:
                j["ca"] += 1
                j["amar"][comp] = j["amar"].get(comp, 0) + 1
                eventos.append((rng.randint(1, 92), lado, "amarelo", pid, None))
                if j["amar"][comp] >= 3:
                    j["amar"][comp] = 0
                    j["susp"][comp] = j["susp"].get(comp, 0) + 1
                    sincronizar_suspensao(j)
            if rng.random() < 0.013 * peso_cartao:
                j["cv"] += 1
                j["susp"][comp] = j["susp"].get(comp, 0) + 1 + rng.randint(0, 2)
                sincronizar_suspensao(j)
                eventos.append((rng.randint(1, 92), lado, "vermelho", pid, None))
            clube = G["clubes"][j["clube"]] if j["clube"] else None
            risco = 0.026 * (1.0 - 0.05 * (clube["medico"] if clube else 3))
            # rampa continua: jogar acabado dobra o risco, em vez de um degrau
            risco *= 1.0 + 1.6 * max(0.0, (55 - j["cond"]) / 55.0)
            if rng.random() < risco:
                j["lesao"] = rng.choice([1, 1, 2, 2, 3, 4, 6, 8, 12]) + 1
                eventos.append((rng.randint(1, 92), lado, "lesao", pid, None))

    aplicar_moral(G, esc_c, gc, gf)
    aplicar_moral(G, esc_f, gf, gc)
    eventos.sort(key=lambda e: e[0])
    return {"casa": casa_id, "fora": fora_id, "gc": gc, "gf": gf,
            "pub": pub, "renda": renda, "eventos": eventos, "comp": comp}


def aplicar_moral(G, esc, pro, contra):
    if pro > contra:
        dm, df = 3, 3
    elif pro == contra:
        dm, df = 1, 1
    else:
        dm, df = -3, -3
    for pid in esc:
        j = G["jogadores"][pid]
        m = j["moral"] + dm + rng.randint(-2, 2)
        f = j["forma"] + df + rng.randint(-6, 6)
        # puxao de volta para a media: sem isto, moral vira espiral divergente e
        # o campeonato passa a separar times por historico em vez de por elenco.
        j["moral"] = clamp(m + 0.12 * (65 - m), 5, 100)
        j["forma"] = clamp(f + 0.12 * (65 - f), 5, 100)


def penaltis(G: Mundo, a: int, b: int, comp: str = "liga") -> int:
    at_a, de_a, _ = forcas(G, G["clubes"][a], comp)
    at_b, de_b, _ = forcas(G, G["clubes"][b], comp)
    fa, fb = at_a + de_a, at_b + de_b
    p = fa / (fa + fb)
    return a if rng.random() < p * 0.92 + 0.04 else b


