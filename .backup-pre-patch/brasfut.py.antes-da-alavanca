def fim_temporada(G):
    c = G["clubes"][G["clube"]]
    div_antes = c["divisao"]
    pos_final = posicao_na_liga(G, c["id"])
    liga = G["ligas"][div_antes]
    campeao = classificacao(G, liga)[0]

    titulo("fim da temporada %d" % G["temporada"])
    tela_tabela(G, div_antes)
    linhas = ["Campeao da Serie %s: %s" % (div_antes, cor(G["clubes"][campeao]["nome"], "des"))]
    for cp in G["copas"].values():
        if cp["campeao"]:
            linhas.append("%-16s %s" % (cp["nome"] + ":", G["clubes"][cp["campeao"]]["nome"]))
    caixa(linhas)
    print("Seu clube terminou em %s. Objetivo era %s." %
          (cor("%do lugar" % pos_final, "neg"), G["objetivo"]))

    for d in "ABCD":
        cid = classificacao(G, G["ligas"][d])[0]
        cl = G["clubes"][cid]
        cl["titulos"]["Brasileirao Serie " + d] = cl["titulos"].get("Brasileirao Serie " + d, 0) + 1
    G["historico"].append("%d %s Serie %s: campeao %s %s %s terminou em %do" %
                          (G["temporada"], tr("pt"), div_antes, G["clubes"][campeao]["nome"],
                           tr("pt"), c["nome"], pos_final))

    premiacao(G)
    investimentos_ia(G)
    ok, msg = avaliar_diretoria(G, pos_final)
    print("\n" + cor(msg, "ok" if ok else "ruim"))
    movs = acesso_rebaixamento(G)
    minhas = [m for m in movs if m[0] == G["clube"]]
    if minhas:
        _, de, para = minhas[0]
        if "ABCD".index(para) < "ABCD".index(de):
            print(cor("ACESSO. Seu clube sobe para a Serie %s." % para, "ok"))
        else:
            print(cor("REBAIXAMENTO. Seu clube cai para a Serie %s." % para, "ruim"))

    voltando = [G["jogadores"][p]["nome"] for p in c.get("emprestados", []) if p in G["jogadores"]]
    saindo = [G["jogadores"][p]["nome"] for p in c["elenco"] if G["jogadores"][p].get("dono")]
    devolver_todos(G)
    if voltando:
        print(cor("Voltam de emprestimo: ", "fraco") + ", ".join(voltando))
    if saindo:
        print(cor("Fim do emprestimo, voltam aos donos: ", "fraco") + ", ".join(saindo))

    usados = set(j["nome"] for j in G["jogadores"].values())
    evoluir_jogadores(G)
    fim_de_contrato(G)
    for cl in G["clubes"].values():
        if cl["divisao"] != "EX":
            novos = base_gera(G, cl, usados)
            if cl["id"] == G["clube"]:
                for j in novos:
                    print(cor("Base: %s (%s, %d anos, overall %d, potencial %d) subiu ao profissional." %
                              (j["nome"], j["pos"], j["idade"], j["ovr"], j["pot"]), "ok"))
    repor_elencos(G, usados)

    G["temporada"] += 1
    G["semana"] = 0
    G["fase"] = "entretemporada"
    G["ligas"] = {d: nova_liga(G, d) for d in "ABCD"}
    montar_copas(G)
    for cl in G["clubes"].values():
        cl["escalacao"] = []
        cl["esc_stamp"] = ""
    definir_objetivo(G)
    if not ok:
        return trocar_de_clube(G)
    return True


def trocar_de_clube(G):
    titulo("sem clube")
    cands = [cl for cl in G["clubes"].values()
             if cl["divisao"] in "BCD" and cl["id"] != G["clube"]]
    cands.sort(key=lambda cl: -cl["reputacao"])
    ofertas = rng.sample(cands[:30], min(4, len(cands)))
    tabela([("#", 3, ">"), ("CLUBE", 24, "<"), ("SERIE", 5, "<"), ("REP", 3, ">"),
            ("CAIXA", 12, ">"), ("ELENCO", 6, ">")],
           [(i, cl["nome"][:24], cl["divisao"], cl["reputacao"], din(cl["dinheiro"]), len(cl["elenco"]))
            for i, cl in enumerate(ofertas, 1)])
    print("  0  encerrar a carreira")
    k = ler_int("Escolha: ", G, 0, len(ofertas))
    if k is None and G["auto"]:
        k = 1
    if not k:
        titulo("carreira encerrada")
        for h in G["historico"]:
            print("  " + h)
        return False
    G["clube"] = ofertas[k - 1]["id"]
    definir_objetivo(G)
    print(cor("Novo clube: %s. Objetivo: %s." % (ofertas[k - 1]["nome"], G["objetivo"]), "ok"))
    return True


def iniciar_temporada(G):
    c = G["clubes"][G["clube"]]
    saindo = [p for p in c["elenco"] if G["jogadores"][p]["contrato"] <= 0
              and not G["jogadores"][p].get("dono")]
    for pid in saindo:
        j = G["jogadores"][pid]
        c["elenco"].remove(pid)
        if pid in c.get("escalacao", []):
            c["escalacao"].remove(pid)
        j["clube"] = None
        j["listado"] = 0
        G["livres"].append(pid)
        print(cor("Contrato encerrado: %s deixou o clube." % j["nome"], "av"))
    G["semana"] = 1
    G["fase"] = "liga"
    c["escalacao"] = auto_escalar(G, c)
    salvar_auto(G)
    print(cor("\nTemporada %d comecando. Objetivo: %s." % (G["temporada"], G["objetivo"]), "neg"))


