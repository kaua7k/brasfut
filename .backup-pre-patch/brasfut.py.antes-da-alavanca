def salario_de(ovr):
    return int(max(8_000, 1500 * (1.16 ** (ovr - 40))))


def fator_idade(idade):
    if idade <= 20:
        return 1.45
    if idade <= 23:
        return 1.35
    if idade <= 26:
        return 1.20
    if idade <= 29:
        return 1.00
    if idade <= 31:
        return 0.72
    if idade <= 33:
        return 0.48
    return 0.25


def valor_de(ovr, idade, pot):
    base = salario_de(ovr) * 30.0
    base *= fator_idade(idade)
    base *= 1.0 + max(0, pot - ovr) * 0.035
    return int(base / 1000) * 1000


