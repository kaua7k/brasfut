        j["pos"],
        j["nome"][:16],
        j["idade"],
        cor(str(j["ovr"]), cor_ovr(j["ovr"])),
        scout(G, j),
        j["cond"],
        j["forma"],
        j["moral"],
        "%d/%d" % (j["j"], j["g"]),
        din(j["salario"]),
        j["contrato"],
        situacao(G, j),
    )


