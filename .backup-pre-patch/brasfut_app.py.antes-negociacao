        self.e_opcao.insert(0, "0")
        self.e_opcao.pack(anchor="w")
        rotulo(self.corpo, "Quanto do salario voce banca? (0 a 100)", fonte=FONTE_B).pack(anchor="w", pady=(10, 2))
        self.entrada = tk.Entry(self.corpo, width=8, bg=TEMA["painel"], fg=TEMA["txt"],
                                relief="flat", font=MONO, insertbackground=TEMA["txt"])
        self.entrada.pack(anchor="w")
        self.entrada.bind("<Return>", lambda e: self.enviar())
        botao(self.corpo, "Propor", self.enviar, cor=TEMA["acao"]).pack(anchor="w", pady=8)
        self.dialogo = tk.Text(self.corpo, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO,
                               relief="flat", wrap="word", padx=10, pady=8, height=6)
        self.dialogo.pack(fill="both", expand=True, pady=6)
        self.entrada.focus_set()

    def fala(self, t):
        self.dialogo.configure(state="normal")
        self.dialogo.insert("end", t + "\n")
        self.dialogo.configure(state="disabled")

    def enviar(self):
        try:
            pct = int(self.entrada.get())
        except ValueError:
            return
        try:
            opcao = int(self.e_opcao.get().replace(".", "").replace(",", ""))
        except ValueError:
            opcao = 0
        self.entrada.delete(0, "end")
        prop = eng.Proposta(jogador=self.j["id"], comprador=self.c["id"], pct_salario=pct,
                            opcao_compra=opcao, tipo=eng.TIPO_EMPRESTIMO)
        r = eng.avaliar_emprestimo(self.G, prop)
        self.fala(r.motivo)
        if r.aceita:
            self.resultado = eng.fechar_emprestimo(self.G, prop)
            self.fala(self.resultado)
            self.after(900, self.destroy)
            return
        if r.encerrada:
            self.resultado = r.motivo
            self.after(900, self.destroy)
            return
        self.rodada += 1
        if self.rodada >= 3:
            self.resultado = "Emprestimo de %s nao saiu." % self.j["nome"]
            self.fala(self.resultado)
            self.after(900, self.destroy)


class CederEmprestimo(Dialogo):
    def __init__(self, pai, G, j):
        super().__init__(pai, "Ceder " + j["nome"], 600, 400)
        self.G, self.j = G, j
        c = G["clubes"][G["clube"]]
        interessados = [cl for cl in G["clubes"].values()
                        if cl["divisao"] != "EX" and cl["id"] != c["id"]
                        and cl["reputacao"] <= c["reputacao"] + 6
                        and eng.conta_posicao(G, cl, j["pos"]) <= eng.ELENCO_PADRAO[j["pos"]] + 1]
        interessados.sort(key=lambda cl: -cl["reputacao"])
        self.ofertas = []
        for cl in interessados[:6]:
            cap = eng.clamp(cl["dinheiro"] / max(1, j["salario"] * 12) * 30, 15, 95)
            self.ofertas.append((cl, int(eng.clamp(cap * eng.rng.uniform(0.7, 1.2), 10, 100))))
        rotulo(self.corpo, "Ceder %s por emprestimo" % j["nome"], fonte=FONTE_T).pack(anchor="w")
        rotulo(self.corpo, "Ele volta no fim da temporada. Quem receber assume parte do salario de %s."
               % din(j["salario"]), cor=TEMA["fraco"]).pack(anchor="w", pady=(0, 8))
        if not self.ofertas:
            rotulo(self.corpo, "Nenhum clube demonstrou interesse neste jogador.",
                   cor=TEMA["av"]).pack(anchor="w", pady=10)
            botao(self.corpo, "Fechar", self.destroy).pack(anchor="e")
            return
        q, self.tv = grade(self.corpo, [("nome", "Clube", 180, "w"), ("div", "Serie", 50, "center"),
                                        ("rep", "Rep", 45, "center"), ("pct", "Assume", 70, "center"),
                                        ("sobra", "Sobra pra voce", 110, "e")], altura=6)
        q.pack(fill="both", expand=True, pady=6)
        for i, (cl, pct) in enumerate(self.ofertas):
            self.tv.insert("", "end", iid=str(i),
                           values=(cl["nome"], cl["divisao"], cl["reputacao"], "%d%%" % pct,
                                   din(j["salario"] * (100 - pct) // 100)))
        f = tk.Frame(self.corpo, bg=TEMA["fundo"])
        f.pack(fill="x", pady=6)
        botao(f, "Aceitar proposta", self.confirmar, cor=TEMA["acao"]).pack(side="right")
        botao(f, "Cancelar", self.destroy).pack(side="right", padx=8)

    def confirmar(self):
        sel = self.tv.selection()
        if not sel:
            return
        cl, pct = self.ofertas[int(sel[0])]
        eng.emprestar(self.G, self.j["id"], cl["id"], pct)
        eng.noticia(self.G, "%s cedeu %s ao %s por emprestimo."
                    % (self.G["clubes"][self.G["clube"]]["nome"], self.j["nome"], cl["nome"]))
        self.resultado = "%s cedido ao %s, que assume %d%% do salario." % (self.j["nome"], cl["nome"], pct)
        messagebox.showinfo("Emprestimo", self.resultado)
        self.destroy()


