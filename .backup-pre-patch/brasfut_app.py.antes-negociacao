    def investir(self, chave, custo):
        c = self.G["clubes"][self.G["clube"]]
        if custo > c["dinheiro"]:
            messagebox.showwarning("BRASFUT", "Caixa insuficiente.")
            return
        c["dinheiro"] -= custo
        c[chave] += 1
        self.log("Investimento de %s feito. %s agora esta no nivel %d."
                 % (din(custo), chave.upper(), c[chave]))
        self.atualizar_topo()
        self.mostrar("infra")

