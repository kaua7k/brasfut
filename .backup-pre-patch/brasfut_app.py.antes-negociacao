    def _alavanca(self, pai, ligada):
        """Nao existe switch no tkinter: sao dois rotulos que se revezam."""
        cx = tk.Frame(pai, bg=TEMA["borda"])
        for texto, valor in (("AUTO", True), ("MANUAL", False)):
            ativo = (valor == ligada)
            lb = tk.Label(cx, text=texto, width=8, pady=2, cursor="hand2",
                          bg=TEMA["acao"] if ativo else TEMA["borda"],
                          fg="white" if ativo else TEMA["fraco"],
                          font=FONTE_PB if ativo else FONTE_P)
            lb.pack(side="left", padx=2, pady=2)
            lb.bind("<Button-1>", lambda _e, v=valor: self.alternar_auto_escalacao(v))
            if not ativo:
                lb.bind("<Enter>", lambda e: e.widget.configure(bg=TEMA["linha"]))
                lb.bind("<Leave>", lambda e: e.widget.configure(bg=TEMA["borda"]))
        return cx

    def alternar_auto_escalacao(self, ligada):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        if eng.escalacao_automatica(G, c) == ligada:
            return
        eng.definir_escalacao_automatica(G, ligada)
        self.atualizar_topo()
        self.mostrar(self.view)
        self.status("escalacao automatica ligada - o XI foi remontado" if ligada
                    else "escalacao manual ligada - voce responde pelo XI",
                    TEMA["ok"] if ligada else TEMA["av"])

    def _pastilhas(self, d):
        """Ordem fixa. Posicao estavel e o que ensina o olho a varrer."""
        esc = d["escalacao"]
        fora = [p for p, v in d["improvisados"]]
        n_desf = len(d["desfalques"])
        graves = bool(d["graves"])
        curto = not self._painel_largo
        gol_ok = d["afinidade_minima"] >= 0.60
        return [
            ("%d/11" % len(esc) if curto else "%d/11 EM CAMPO" % len(esc),
             "ok" if len(esc) >= 11 else "ruim"),
            (("GOL OK" if gol_ok else "GOL IMPROV") if curto else
             ("GOLEIRO OK" if gol_ok else "GOL IMPROVISADO"),
             "ok" if gol_ok else "ruim"),
            (("%d IMPROV" % len(fora) if curto else "%d IMPROVISADO(S)" % len(fora))
             if fora else ("SEM IMPROV" if curto else "SEM IMPROVISO"),
             "ok" if not fora else ("ruim" if graves else "av")),
            (("%d DESF" % n_desf if curto else "%d DESFALQUE(S)" % n_desf)
             if n_desf else ("SEM DESF" if curto else "SEM DESFALQUE"),
             "ok" if not n_desf else ("ruim" if n_desf >= 4 or d["aptos"] < 14 else "av")),
        ]

    def _linhas_xi(self, d):
        """Cada titular em uma linha, com a vaga real e o preco do improviso."""
        jogs = self.G["jogadores"]
        linhas = []
        for pid, vaga in d["vagas"]:
            j = jogs[pid]
            improvisado = vaga != j["pos"]
            afin = eng.AFINIDADE[j["pos"]][vaga]
            tag_vaga = "txt"
            if improvisado:
                tag_vaga = "ruim" if afin < 0.60 else "av"
            obs, tag_obs = "", "fraco"
            if improvisado:
                obs, tag_obs = "rende %d%%" % int(afin * 100), tag_vaga
            elif j["cond"] < 45:
                obs, tag_obs = "desgastado", "ruim"
            elif j.get("amar", {}).get("liga", 0) >= 2:
                obs, tag_obs = "pendurado", "av"
            tag_fis = "ruim" if j["cond"] < 45 else ("av" if j["cond"] < 65 else "txt")
            tag_nome = tag_ovr(j["ovr"]) or "txt"
            linhas.append([
                ("%-11s" % ("%s > %s" % (j["pos"], vaga) if improvisado else j["pos"]), tag_vaga),
                ("%-23s" % corta(j["nome"], 22), tag_nome),
                ("%3d" % j["ovr"], tag_nome),
                ("  fis %3d  " % j["cond"], tag_fis),
                (obs, tag_obs)])
        for _ in range(11 - len(d["vagas"])):
            linhas.append([("%-11s" % "---", "ruim"), ("%-23s" % "VAGA ABERTA", "ruim"),
                           (" --", "ruim"), ("  fis  --  ", "ruim"),
                           ("sem jogador apto", "ruim")])
        return linhas

