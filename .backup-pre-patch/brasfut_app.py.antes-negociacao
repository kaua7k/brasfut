    def acao_jogador(self, qual):
        j = self.selecionado()
        if not j:
            return
        if qual == "opcao":
            preco = eng.opcao_disponivel(self.G, j, self.G["clube"])
            if preco <= 0:
                messagebox.showinfo("BRASFUT", "%s nao tem opcao de compra combinada." % j["nome"])
                return
            if messagebox.askyesno("Opcao de compra",
                                   "Comprar %s em definitivo por %s?" % (j["nome"], din(preco))):
                self.log(eng.exercer_opcao(self.G, j["id"], self.G["clube"]))
            self.atualizar_topo()
            self.mostrar("elenco")
            return
        if j.get("dono"):
            messagebox.showinfo("BRASFUT", "%s esta emprestado, o passe nao e seu." % j["nome"])
            return
        if qual == "venda":
            PorAVenda(self, self.G, j).esperar()
        elif qual == "emprestar":
            CederEmprestimo(self, self.G, j).esperar()
        elif qual == "renovar":
            Renovar(self, self.G, j).esperar()
        elif qual == "rescindir":
            self.rescindir(j)
        self.atualizar_topo()
        self.mostrar("elenco")

    def rescindir(self, j):
        c = self.G["clubes"][self.G["clube"]]
        multa = int(j["salario"] * 4 * max(1, j["contrato"]) * 0.5)
        if not messagebox.askyesno("Rescindir", "Dispensar %s custa %s de multa e libera %s por mes.\nConfirma?"
                                   % (j["nome"], din(multa), din(j["salario"]))):
            return
        if multa > c["dinheiro"]:
            messagebox.showwarning("Rescindir", "Caixa insuficiente para a multa.")
            return
        c["dinheiro"] -= multa
        c["elenco"].remove(j["id"])
        if j["id"] in c.get("escalacao", []):
            c["escalacao"].remove(j["id"])
        j["clube"] = None
        j["listado"] = 0
        self.G["livres"].append(j["id"])
        self.log("%s foi dispensado por %s de multa." % (j["nome"], din(multa)))

