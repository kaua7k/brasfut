CORES_ESTADO = {"ok": "ok", "atencao": "av", "critico": "ruim", "neutro": "fraco"}


def cor_estado(estado):
    """Traduz o estado do diagnostico para o token de cor do tema."""
    return TEMA[CORES_ESTADO.get(estado, "fraco")]


def din(v):
    return eng.din(v)


def limpar_texto(txt):
    """Tira as molduras de terminal do motor e deixa o texto limpo para a janela."""
    saida, vazias = [], 0
    for bruto in txt.splitlines():
        linha = bruto.rstrip()
        nu = linha.strip()
        if nu and set(nu) <= set("-=+|.,: "):
            continue
        if nu.startswith("|"):
            nu = nu[1:]
            if nu.endswith("|"):
                nu = nu[:-1]
            linha = "  " + nu.strip()
        if not linha.strip():
            vazias += 1
            if vazias > 1:
                continue
        else:
            vazias = 0
        saida.append(linha)
    return "\n".join(saida).strip()


def capturar(func, *a, **kw):
    """Roda uma funcao do motor e devolve (retorno, texto impresso ja limpo)."""
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        ret = func(*a, **kw)
    return ret, limpar_texto(eng.re.sub(r"\033\[[0-9;]*m", "", buf.getvalue()))


class Dialogo(tk.Toplevel):
    """Janela modal simples com corpo montado pela subclasse."""

    def __init__(self, pai, titulo, largura=560, altura=420):
        super().__init__(pai)
        self.resultado = None
        self.title(titulo)
        self.configure(bg=TEMA["fundo"])
        self.transient(pai)
        self.resizable(False, False)
        self.corpo = tk.Frame(self, bg=TEMA["fundo"], padx=16, pady=14)
        self.corpo.pack(fill="both", expand=True)
        self.geometry("%dx%d" % (largura, altura))
        self.update_idletasks()
        x = pai.winfo_rootx() + (pai.winfo_width() - largura) // 2
        y = pai.winfo_rooty() + (pai.winfo_height() - altura) // 3
        self.geometry("+%d+%d" % (max(0, x), max(0, y)))

    def esperar(self):
        self.grab_set()
        self.wait_window(self)
        return self.resultado


def rotulo(pai, txt, cor=None, fonte=None, **kw):
    return tk.Label(pai, text=txt, bg=kw.pop("bg", TEMA["fundo"]),
                    fg=cor or TEMA["txt"], font=fonte or FONTE,
                    anchor=kw.pop("anchor", "w"), **kw)


def botao(pai, txt, cmd, cor=None, largura=None):
    b = tk.Button(pai, text=txt, command=cmd, font=FONTE_B, relief="flat",
                  bg=cor or TEMA["painel"], fg=TEMA["txt"], activebackground=TEMA["acao"],
                  activeforeground="white", cursor="hand2", padx=12, pady=6,
                  highlightthickness=0, bd=0)
    if largura:
        b.configure(width=largura)
    return b


def grade(pai, colunas, altura=14):
    """Treeview com o visual do tema. colunas = [(id, titulo, largura, ancora)]"""
    quadro = tk.Frame(pai, bg=TEMA["fundo"])
    tv = ttk.Treeview(quadro, columns=[c[0] for c in colunas], show="headings",
                      height=altura, selectmode="browse")
    for cid, tit, larg, anc in colunas:
        tv.heading(cid, text=tit)
        tv.column(cid, width=larg, anchor=anc, stretch=False)
    barra = ttk.Scrollbar(quadro, orient="vertical", command=tv.yview)
    tv.configure(yscrollcommand=barra.set)
    tv.pack(side="left", fill="both", expand=True)
    barra.pack(side="right", fill="y")
    tv.tag_configure("bom", foreground=TEMA["ok"])
    tv.tag_configure("top", foreground=TEMA["top"])
    tv.tag_configure("ruim", foreground=TEMA["ruim"])
    tv.tag_configure("aviso", foreground=TEMA["av"])
    tv.tag_configure("meu", foreground=TEMA["av"])
    tv.tag_configure("fraco", foreground=TEMA["fraco"])
    return quadro, tv


def corta(txt, n):
    """Corta o texto no limite da coluna sem deixar palavra pela metade feia."""
    return txt if len(txt) <= n else txt[:n - 3] + "..."


def tag_ovr(ovr):
    if ovr >= 78:
        return "top"
    if ovr >= 68:
        return "bom"
    if ovr >= 55:
        return ""
    return "fraco"


def estilo_ttk(raiz):
    st = ttk.Style(raiz)
    try:
        st.theme_use("clam")
    except Exception:
        pass
    st.configure("Treeview", background=TEMA["painel"], fieldbackground=TEMA["painel"],
                 foreground=TEMA["txt"], rowheight=22, borderwidth=0, font=MONO)
    st.configure("Treeview.Heading", background=TEMA["linha"], foreground=TEMA["fraco"],
                 relief="flat", font=(FONTE[0], 9, "bold"))
    st.map("Treeview", background=[("selected", TEMA["acao"])],
           foreground=[("selected", "white")])
    st.configure("TCombobox", fieldbackground=TEMA["painel"], background=TEMA["painel"],
                 foreground=TEMA["txt"], arrowcolor=TEMA["txt"])
    st.configure("Vertical.TScrollbar", background=TEMA["linha"], troughcolor=TEMA["fundo"],
                 bordercolor=TEMA["fundo"], arrowcolor=TEMA["fraco"])


