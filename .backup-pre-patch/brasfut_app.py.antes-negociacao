        eng.ESTILO["uni"] = False
        self.G = None
        self.modo = "visual"
        self.view = "painel"
        self.historico_console = []
        self.resumos = []      # o que o painel conta como acontecimento
        self._monta_estrutura()
        self._inicio = self.after(60, self.abrir_jogo)

    # ---------------------------------------------------------------- estrutura
    def _monta_estrutura(self):
