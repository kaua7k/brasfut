        self.rodape.pack(fill="x", side="bottom")
        self.lb_status = rotulo(self.rodape, "", cor=TEMA["fraco"], bg=TEMA["painel"])
        self.lb_status.pack(side="left", padx=14)

    def diagnostico(self, recarregar=False):
        """O veredito da semana, calculado uma vez e distribuido pela interface.

        Regua do topo, cor do botao, faixa do painel e rodape leem daqui. Cinco
        pontos da tela discordando entre si e pior do que nenhum aviso.
        """
        if self.G is None:
            return None
        if recarregar or getattr(self, "_diag", None) is None:
            self._diag = eng.diagnostico_escalacao(self.G)
        return self._diag

    def status(self, txt, cor=None):
        self.lb_status.configure(text=txt, fg=cor or TEMA["fraco"])

    def log(self, txt):
        if not txt:
            return
        self.historico_console.append(txt.rstrip())
        self.txt_console.configure(state="normal")
        self.txt_console.insert("end", txt.rstrip() + "\n\n")
        self.txt_console.see("end")
        self.txt_console.configure(state="disabled")

    # ------------------------------------------------------------------- inicio
    def abrir_jogo(self):
        G = None
        if os.path.exists(eng.SAVE):
            if messagebox.askyesno("BRASFUT", "Existe um jogo salvo.\nQuer continuar de onde parou?"):
                try:
                    G = eng.carregar()
                except Exception as e:
                    messagebox.showwarning("BRASFUT", "Nao consegui abrir o save (%s).\nVou comecar um jogo novo." % e)
        if G is None:
            G, texto = capturar(eng.criar_mundo, "Tecnico")
            self.log(texto)
            cid = NovoJogo(self, G).esperar()
            if not cid:
                self.destroy()
                return
            G["clube"] = cid
            G["clubes"][cid]["escalacao"] = eng.auto_escalar(G, G["clubes"][cid])
            eng.definir_objetivo(G)
        G["auto"] = True          # impede que o motor peca input pelo terminal
        eng.trocar_de_clube = self.escolher_novo_clube
        self.G = G
        self.log("Bem-vindo ao %s. Objetivo: %s." %
                 (G["clubes"][G["clube"]]["nome"], G["objetivo"]))
        self.log(AJUDA)
        self.atualizar_topo()
        self.mostrar("painel")

    def atualizar_topo(self):
        G = self.G
        c = G["clubes"][G["clube"]]
        self.lb_clube.configure(text=c["nome"])
        if G["fase"] == "entretemporada":
            quando = "Pre-temporada %d" % G["temporada"]
            self.bt_semana.configure(text="Iniciar temporada")
        else:
            quando = "Temporada %d  |  semana %02d de %d" % (G["temporada"], G["semana"], eng.SEMANAS_LIGA)
            self.bt_semana.configure(text="Avancar semana")
        pos = ""
        liga = G["ligas"][c["divisao"]]
        if G["fase"] != "entretemporada" and liga["rodada"] > 0:
            t = liga["tabela"][str(c["id"])]
            pos = "  |  %do lugar, %d pts" % (eng.posicao_na_liga(G, c["id"]), t["p"])
        self.lb_sub.configure(text="%s  |  Serie %s  |  %s%s" % (c["estadio"], c["divisao"], quando, pos))
        self.lb_caixa.configure(
            text="Caixa %s     Folha %s/mes     Elenco %d" %
                 (din(c["dinheiro"]), din(eng.folha_semanal(G, c) * 4), len(c["elenco"])),
            fg=TEMA["ok"] if c["dinheiro"] >= 0 else TEMA["ruim"])
        self.pintar_estado()

    def pintar_estado(self):
        """Regua, botao e ponto de atencao vestem a cor do diagnostico.

        O botao nunca e desabilitado: entrar em campo quebrado e um direito do
        tecnico. Nao saber que esta quebrado e que nao e.
        """
        d = self.diagnostico(recarregar=True)
        if not d or self.G["fase"] == "entretemporada":
            self.regua.configure(bg=TEMA["borda"])
            self.lb_ponto.configure(text="")
            return
        estado = d["estado"]
        self.regua.configure(bg=TEMA["borda"] if estado in ("ok", "neutro")
                             else cor_estado(estado))
        if estado == "critico":
            self.bt_semana.configure(text="Avancar assim mesmo", bg=TEMA["ruim"],
                                     fg=TEMA["fundo"], activebackground=TEMA["ruim"],
                                     activeforeground=TEMA["fundo"])
        else:
            self.bt_semana.configure(text="Avancar semana", bg=TEMA["acao"],
                                     fg=TEMA["txt"], activebackground=TEMA["acao"],
                                     activeforeground="white")
        self.lb_ponto.configure(text="\u25cf " if estado == "atencao" else "")

    # -------------------------------------------------------------------- modos
    def alternar_modo(self):
        if self.modo == "visual":
            self.modo = "linha"
            self.lateral.pack_forget()
            self.area.pack_forget()
            self.console.pack(fill="both", expand=True)
            self.bt_modo.configure(text="Modo visual")
            self.ent_cmd.focus_set()
            self.status("modo linha: digite ajuda para ver os comandos")
        else:
            self.modo = "visual"
            self.console.pack_forget()
            self.lateral.pack(side="left", fill="y")
            self.area.pack(side="left", fill="both", expand=True)
            self.bt_modo.configure(text="Modo linha")
            self.mostrar(self.view)
            self.status("")

    def mostrar(self, chave):
        self.view = chave
        for k, b in self.bt_nav.items():
            b.configure(fg="white" if k == chave else TEMA["fraco"],
                        bg=TEMA["linha"] if k == chave else TEMA["painel"])
        for w in self.area.winfo_children():
            w.destroy()
        getattr(self, "tela_" + chave)(self.area)

    def _area_redimensionada(self, _=None):
        """So redesenha quando a janela cruza a largura que muda o layout.

        Sem essa guarda, cada pixel de arrasto redesenharia o painel inteiro.
        """
        if self.view != "painel" or self.modo != "visual" or self.G is None:
            return
        largo = self.winfo_width() >= LARGURA_CHEIA
        alto = self.area.winfo_height() >= 600
        if (largo, alto) == (getattr(self, "_painel_largo", None),
                             getattr(self, "_painel_alto", None)):
            return
        self.mostrar("painel")

    def cabecalho_tela(self, pai, titulo, sub=""):
        f = tk.Frame(pai, bg=TEMA["fundo"])
        f.pack(fill="x", padx=18, pady=(14, 6))
        rotulo(f, titulo, fonte=FONTE_T).pack(anchor="w")
        if sub:
            rotulo(f, sub, cor=TEMA["fraco"]).pack(anchor="w")
        return f

    # ------------------------------------------------------------------ semana
    def avancar(self):
        G = self.G
        d = self.diagnostico(recarregar=True)
        if d and d["estado"] == "critico" and G["fase"] != "entretemporada":
            texto = ("%s\n\nAvancar a semana agora entra em campo com esse time.\n"
                     "Ataque %.1f, defesa %.1f - com o problema ja descontado.\n\n"
                     "Avancar mesmo assim?" % (d["titulo"], d["ataque"], d["defesa"]))
            if not messagebox.askyesno("Time quebrado", texto, default="no", icon="warning"):
                self.mostrar("escalacao")
                return
        if G["fase"] == "entretemporada":
            _, txt = capturar(eng.iniciar_temporada, G)
            self.log(txt)
            self.status("temporada iniciada")
        else:
            ok, txt = capturar(eng.jogar_semana, G)
            self.log(txt)
            self.resumos = (self.resumos + [txt])[-5:]
            if ok is False:
                self.log("Carreira encerrada.")
                messagebox.showinfo("BRASFUT", "Carreira encerrada.")
                self.bt_semana.configure(state="disabled")
            self.status("semana processada e salva", TEMA["ok"])
        self.atualizar_topo()
        if self.modo == "visual":
            self.mostrar(self.view if self.view != "escalacao" else "painel")

    def salvar(self):
        try:
            eng.salvar(self.G)
            self.status("jogo salvo em %s" % os.path.basename(eng.SAVE), TEMA["ok"])
        except Exception as e:
            self.status("falha ao salvar: %s" % e, TEMA["ruim"])

    def escolher_novo_clube(self, G):
        """Substitui a versao de terminal do motor quando o tecnico e demitido."""
        cands = [cl for cl in G["clubes"].values()
                 if cl["divisao"] in "BCD" and cl["id"] != G["clube"]]
        cands.sort(key=lambda cl: -cl["reputacao"])
        ofertas = eng.rng.sample(cands[:30], min(4, len(cands)))
        cid = EscolherClube(self, G, ofertas).esperar()
        if not cid:
            return False
        antigo = G["clubes"][G["clube"]]
        G["clube"] = cid
        eng.herdar_preferencias(G, antigo)
        eng.definir_objetivo(G)
        return True

    # ------------------------------------------------------------------ painel
    def tela_painel(self, pai):
        """A tela responde uma pergunta so: posso avancar a semana agora?

        Tudo se ordena por isso. O veredito vem primeiro e ocupa a largura
        inteira; a prova (o XI que entra em campo) vem logo abaixo e e o maior
        bloco da tela; o resto e contexto da aposta e memoria.
        """
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        d = self.diagnostico(recarregar=True)
        self._medir_painel()
        self.cabecalho_tela(pai, "Painel", self._resumo_da_rodada())
        self._faixa_prontidao(pai, d)
        self.status(*self._status_do_estado(d))

        corpo = tk.Frame(pai, bg=TEMA["fundo"])
        corpo.pack(fill="both", expand=True, padx=18, pady=(0, 4))

        cima = tk.Frame(corpo, bg=TEMA["fundo"], height=self._alt_cima)
        cima.pack(fill="x")
        cima.pack_propagate(False)
        coluna = tk.Frame(cima, bg=TEMA["fundo"], width=370 if self._painel_largo else 300)
        coluna.pack(side="right", fill="y")
        coluna.pack_propagate(False)
        self._card_proximo(coluna, d).pack(fill="x")
        self._card_objetivo(coluna).pack(fill="x", pady=(10, 0))
