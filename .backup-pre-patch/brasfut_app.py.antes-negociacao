    def _card_acontecimentos(self, pai):
        """Noticia do clube, nao o eco do console: o log de comandos nao e
        historia, e ruido que ja mora no modo linha e na tela Noticias."""
        card = tk.Frame(pai, bg=TEMA["painel"])
        card.pack_propagate(False)
        topo = tk.Frame(card, bg=TEMA["painel"])
        topo.pack(fill="x", padx=14, pady=(8, 2))
        rotulo(topo, "ULTIMOS ACONTECIMENTOS", cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["painel"]).pack(side="left")
        recentes = self._acontecimentos()
        if recentes:
            link = rotulo(topo, "ver tudo", cor=TEMA["fraco"], fonte=FONTE_P,
                          bg=TEMA["painel"], cursor="hand2")
            link.pack(side="right")
            link.bind("<Button-1>", lambda _e: self.mostrar("noticias"))
        cx = tk.Text(card, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO, relief="flat",
                     wrap="word", padx=10, pady=4, height=6, highlightthickness=0)
        cx.pack(fill="both", expand=True, padx=4)
        cx.tag_configure("fraco", foreground=TEMA["fraco"])
        if not recentes:
            cx.insert("1.0", "Nada por aqui ainda. Avance a semana para comecar a historia.",
                      "fraco")
        for i, entrada in enumerate(recentes):
            limpo = eng.re.sub(r"\033\[[0-9;]*m", "", entrada).strip().replace("\n", " ")
            cx.insert("end", corta(limpo, 150) + "\n\n", "fraco" if i else "")
        cx.configure(state="disabled")
        return card

    def _acontecimentos(self):
        """O que aconteceu de fato: o placar da ultima semana e as noticias.

        O motor so gera noticia em evento forte (lesao, negocio, reposicao), e
        muita semana passa sem nenhuma. Por isso o resumo da rodada entra na
        frente: sem ele o bloco vivia vazio.
        """
        itens = []
        for bruto in (getattr(self, "resumos", []) or [])[-1:]:
            linhas = [l.strip() for l in bruto.splitlines() if l.strip()]
            if linhas:
                itens.append(" . ".join(linhas[:2]))
        itens.extend(reversed(self.G["noticias"][-2:]))
        return itens[:3]

