MONO = ("Consolas", 10) if os.name == "nt" else ("DejaVu Sans Mono", 10)
FONTE = ("Segoe UI", 10) if os.name == "nt" else ("DejaVu Sans", 10)
FONTE_B = (FONTE[0], 10, "bold")
FONTE_T = (FONTE[0], 15, "bold")
# escala do painel: 9 / 10 / 10b / 13b / 15b / 20b. Cada degrau so vale porque
