            n = len(cp["vivos"])
            vivo = G["clube"] in cp["vivos"]
            prox = cp["semanas"][cp["fase"]] if cp["fase"] < len(cp["semanas"]) else None
            txt = "%s, %d clubes na disputa" % (eng.nome_fase(n), n)
