                                    ("100%", 100)])
        self.r_pct.pack(fill="x")
        self.lb_div = rotulo(b, "", cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["painel"])
        self.lb_div.pack(anchor="w", pady=(4, 0))

        b2 = bloco(self.corpo, "OPCAO DE COMPRA")
        rotulo(b2, "Preco travado agora para comprar em definitivo no fim. 0 = sem opcao.",
               cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["painel"]).pack(anchor="w", pady=(0, 6))
        self.r_opcao = Regua(b2, "Opcao de compra", 0, maximo=max(int(mercado * 2), 10000),
                             bg=TEMA["painel"], ao_mudar=lambda v: self.reler(),
                             atalhos=[("sem opcao", 0), ("piso do dono", lambda: self.piso),
                                      ("valor de mercado", lambda: int(j["valor"])),
                                      ("pedido cheio", lambda: int(mercado))])
        self.r_opcao.pack(fill="x")
        self.lb_opcao = rotulo(b2, "", cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["painel"])
        self.lb_opcao.pack(anchor="w", pady=(4, 0))

        acoes = tk.Frame(self.corpo, bg=TEMA["fundo"])
        acoes.pack(fill="x", pady=8)
        botao(acoes, "Propor emprestimo", self.enviar, cor=TEMA["acao"]).pack(side="left")
        botao(acoes, "Desistir", self.destroy).pack(side="left", padx=6)
        self.lb_rodada = rotulo(acoes, "tentativa 1 de 3", cor=TEMA["fraco"], fonte=FONTE_P)
        self.lb_rodada.pack(side="right")

        self.dialogo = tk.Text(self.corpo, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO,
                               relief="flat", wrap="word", padx=10, pady=8, height=5,
                               state="disabled")
        self.dialogo.pack(fill="both", expand=True)
        self.reler()

    def fala(self, txt):
        self.dialogo.configure(state="normal")
        self.dialogo.insert("end", txt + "\n")
        self.dialogo.see("end")
        self.dialogo.configure(state="disabled")

    def reler(self):
        pct = self.r_pct.valor()
        minha = self.j["salario"] * pct // 100
        recado, estado = eng.leitura_oferta(pct, self.exig)
        self.r_pct.leitura("pedem %d%%  -  %s" % (self.exig, recado), cor_estado(estado))
        folha = eng.folha_semanal(self.G, self.c)
        self.lb_div.configure(text="Voce paga %s por mes, o dono paga %s.   Folha semanal: %s -> %s"
                              % (din(minha), din(self.j["salario"] - minha), din(folha),
                                 din(folha + int(minha / 4.0))))
        op = self.r_opcao.valor()
        if not op:
            self.lb_opcao.configure(text="Sem opcao: no fim da temporada ele volta ao dono.",
                                    fg=TEMA["fraco"])
        else:
            estado = "ok" if op >= self.piso else "critico"
            self.lb_opcao.configure(
                text="O dono so trava o passe a partir de %s   (valor de mercado %s)"
                     % (din(self.piso), din(self.j["valor"])), fg=cor_estado(estado))

    def enviar(self):
        prop = eng.Proposta(jogador=self.j["id"], comprador=self.c["id"],
                            pct_salario=self.r_pct.valor(), opcao_compra=self.r_opcao.valor(),
                            tipo=eng.TIPO_EMPRESTIMO)
        r = eng.avaliar_emprestimo(self.G, prop)
        self.fala(r.motivo)
        if r.aceita:
            self.resultado = eng.fechar_emprestimo(self.G, prop)
            self.fala(self.resultado)
            self.after(1100, self.destroy)
            return
        if r.encerrada:
            self.resultado = r.motivo
            self.after(1100, self.destroy)
            return
        self.rodada += 1
        if self.rodada >= 3:
            self.resultado = "Emprestimo de %s nao saiu." % self.j["nome"]
            self.fala(self.resultado)
            self.after(1100, self.destroy)
            return
        self.lb_rodada.configure(text="tentativa %d de 3" % (self.rodada + 1))


class Vitrine(Dialogo):
    """Vitrine em lote: precifica e lista varios jogadores de uma vez.

    O jeito rapido e a regua de percentual: cada um recebe o preco proporcional
    ao SEU valor de mercado, e nao um preco igual para todos. Antes era uma
    janela por jogador, um preco digitado a mao por vez.
    """

    def __init__(self, pai, G, jogadores):
        super().__init__(pai, "Por a venda", 780, 620, redimensionavel=True)
        self.G = G
        self.js = [j for j in jogadores if not j.get("dono")]
        self.precos = {j["id"]: (int(j["listado"]) or eng.preco_sugerido(G, j, 130))
                       for j in self.js}
        rotulo(self.corpo, "Vitrine", fonte=FONTE_T).pack(anchor="w")
        rotulo(self.corpo, "%d jogador(es). Pedir muito acima do valor afasta proposta; "
               "abaixo, elas chegam rapido. Marque linhas para mexer so nelas."
               % len(self.js), cor=TEMA["fraco"]).pack(anchor="w", pady=(0, 6))

        b = bloco(self.corpo, "PRECO COMO PERCENTUAL DO VALOR DE MERCADO")
        self.r_pct = Regua(b, "Pedir", 130, minimo=40, maximo=300, dinheiro=False,
                           bg=TEMA["painel"], ao_mudar=self.aplicar_pct,
                           atalhos=[("saida rapida 90%", 90), ("mercado 100%", 100),
                                    ("com lucro 130%", 130), ("so por muito 200%", 200)])
        self.r_pct.pack(fill="x")

        q, self.tv = grade(self.corpo, [("nome", "Jogador", 170, "w"), ("pos", "Pos", 45, "center"),
                                        ("ovr", "Ovr", 45, "center"), ("ct", "Contrato", 70, "center"),
                                        ("sal", "Salario", 90, "e"), ("val", "Valor", 100, "e"),
                                        ("ped", "Voce pede", 105, "e"), ("pct", "%", 50, "center")],
                           altura=9, multi=True)
        q.pack(fill="both", expand=True, pady=8)
        self.tv.bind("<<TreeviewSelect>>", lambda e: self.somar())

        b2 = bloco(self.corpo, None)
        rotulo(b2, "Preco fixo para os marcados", fonte=FONTE_B,
               bg=TEMA["painel"]).pack(side="left")
        self.campo = CampoDinheiro(b2, 0, bg=TEMA["painel"])
        self.campo.pack(side="left", padx=8)
        botao_mini(b2, "definir", self.definir_fixo).pack(side="left")
        self.lb_total = rotulo(b2, "", cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["painel"])
        self.lb_total.pack(side="right")

        f = tk.Frame(self.corpo, bg=TEMA["fundo"])
        f.pack(fill="x", pady=(6, 0))
        botao(f, "Por a venda", self.confirmar, cor=TEMA["acao"]).pack(side="left")
        botao(f, "Tirar da vitrine", self.tirar).pack(side="left", padx=6)
        botao(f, "Fechar", self.destroy).pack(side="right")
        self.desenhar()

    def alvos(self):
        sel = [int(i) for i in self.tv.selection()]
        return sel or [j["id"] for j in self.js]

    def aplicar_pct(self, pct):
        for pid in self.alvos():
            self.precos[pid] = eng.preco_sugerido(self.G, self.G["jogadores"][pid], pct)
        self.desenhar()

    def definir_fixo(self):
        v = self.campo.valor()
        if v <= 0:
            messagebox.showinfo("BRASFUT", "Digite um preco maior que zero.")
            return
        for pid in self.alvos():
            self.precos[pid] = v
        self.desenhar()

    def desenhar(self):
        """Repopula a tabela. So e chamada quando algum preco muda.

        O evento de selecao vai para somar(), nao para ca: redesenhar aqui
        refaria a selecao, o que dispararia o evento outra vez em volta.
        """
        guardada = [s for s in self.tv.selection()]
        self.tv.delete(*self.tv.get_children())
        for j in self.js:
            preco = self.precos[j["id"]]
            self.tv.insert("", "end", iid=str(j["id"]),
                           values=(j["nome"], j["pos"], j["ovr"], "%d ano(s)" % j["contrato"],
                                   din(j["salario"]), din(j["valor"]), din(preco),
                                   "%d%%" % round(100.0 * preco / max(1, j["valor"]))),
                           tags=(tag_ovr(j["ovr"]),))
        vivas = [s for s in guardada if self.tv.exists(s)]
        if vivas:
            self.tv.selection_set(vivas)
        self.somar()

    def somar(self):
        alvos = self.alvos()
        total = sum(self.precos[p] for p in alvos)
        folha = sum(self.G["jogadores"][p]["salario"] for p in alvos)
        self.lb_total.configure(text="%d na conta  |  pedido somado %s  |  folha que sairia %s/mes"
                                % (len(alvos), din(total), din(folha)))

    def confirmar(self):
        recados = [eng.por_a_venda(self.G, pid, self.precos[pid])[1] for pid in self.alvos()]
        self.resultado = "\n".join(recados)
        messagebox.showinfo("Vitrine", self.resultado)
        self.destroy()

    def tirar(self):
        recados = [eng.tirar_da_vitrine(self.G, pid)[1] for pid in self.alvos()]
        self.resultado = "\n".join(recados)
        messagebox.showinfo("Vitrine", self.resultado)
        self.destroy()


class CederEmprestimo(Dialogo):
    """Todas as propostas de emprestimo dos jogadores marcados em uma tabela.

    Uma linha por par jogador/clube: marque quantas quiser e aceite de uma vez.
    Se dois clubes quiserem o mesmo jogador, vale a primeira linha dele.
    """

    def __init__(self, pai, G, jogadores):
        super().__init__(pai, "Ceder por emprestimo", 820, 560, redimensionavel=True)
        self.G = G
        self.js = [j for j in jogadores if not j.get("dono")]
        self.linhas = []
        for j in self.js:
            for cl, pct in eng.ofertas_emprestimo(G, j):
                self.linhas.append((j, cl, pct))
        rotulo(self.corpo, "Ceder por emprestimo", fonte=FONTE_T).pack(anchor="w")
        rotulo(self.corpo, "Ele volta no fim da temporada, joga o ano inteiro e costuma voltar "
               "melhor. Quem recebe assume a fatia do salario da coluna ASSUME.",
               cor=TEMA["fraco"]).pack(anchor="w", pady=(0, 8))
        if not self.linhas:
            rotulo(self.corpo, "Nenhum clube demonstrou interesse nesses jogadores.\n"
                   "Clubes so pegam emprestado quem cabe no elenco deles e de reputacao "
                   "parecida com a sua.", cor=TEMA["av"]).pack(anchor="w", pady=10)
            botao(self.corpo, "Fechar", self.destroy).pack(anchor="e")
            return
        q, self.tv = grade(self.corpo, [("nome", "Jogador", 160, "w"), ("ovr", "Ovr", 45, "center"),
                                        ("sal", "Salario", 90, "e"),
                                        ("clube", "Interessado", 165, "w"),
                                        ("div", "Serie", 50, "center"), ("rep", "Rep", 45, "center"),
                                        ("pct", "Assume", 70, "center"),
                                        ("sobra", "Sobra pra voce", 115, "e")],
                           altura=11, multi=True)
        q.pack(fill="both", expand=True, pady=6)
        for i, (j, cl, pct) in enumerate(self.linhas):
            self.tv.insert("", "end", iid=str(i),
                           values=(j["nome"], j["ovr"], din(j["salario"]), cl["nome"],
                                   cl["divisao"], cl["reputacao"], "%d%%" % pct,
                                   din(j["salario"] * (100 - pct) // 100)),
                           tags=(tag_ovr(j["ovr"]),))
        self.tv.bind("<<TreeviewSelect>>", lambda e: self.reler())
        self.lb = rotulo(self.corpo, "", cor=TEMA["fraco"], fonte=FONTE_P)
        self.lb.pack(anchor="w")
        f = tk.Frame(self.corpo, bg=TEMA["fundo"])
        f.pack(fill="x", pady=6)
        botao(f, "Aceitar marcadas", self.confirmar, cor=TEMA["acao"]).pack(side="left")
        botao(f, "Marcar a melhor de cada um", self.marcar_melhores).pack(side="left", padx=6)
        botao(f, "Fechar", self.destroy).pack(side="right")
        self.marcar_melhores()

    def marcar_melhores(self):
        """A melhor de cada jogador e a que assume a maior fatia do salario."""
        melhor = {}
        for i, (j, _cl, pct) in enumerate(self.linhas):
            if j["id"] not in melhor or pct > self.linhas[melhor[j["id"]]][2]:
                melhor[j["id"]] = i
        self.tv.selection_set([str(i) for i in sorted(melhor.values())])
        self.reler()

    def reler(self):
        marcadas = [self.linhas[int(i)] for i in self.tv.selection()]
        vistos, alivio = set(), 0
        for j, _cl, pct in marcadas:
            if j["id"] in vistos:
                continue
            vistos.add(j["id"])
            alivio += j["salario"] * pct // 100
        self.lb.configure(text="%d jogador(es) sairiam, aliviando %s por mes na folha"
                          % (len(vistos), din(alivio)))

    def confirmar(self):
        sel = sorted(int(i) for i in self.tv.selection())
        if not sel:
            messagebox.showinfo("BRASFUT", "Marque pelo menos uma proposta.")
            return
        recados, jaf = [], set()
        for i in sel:
            j, cl, pct = self.linhas[i]
            if j["id"] in jaf:
                continue
            feito, recado = eng.ceder_por_emprestimo(self.G, j["id"], cl["id"], pct)
            if feito:
                jaf.add(j["id"])
            recados.append(recado)
        self.resultado = "\n".join(recados)
        messagebox.showinfo("Emprestimo", self.resultado)
        self.destroy()


class Renovar(Dialogo):
    """Renovacao com o motor decidindo: o pedido do empresario agora e estavel.

    Antes a tela sorteava o pedido na hora de abrir, entao fechar e reabrir ate
    sair um numero baixo era o caminho mais barato de renovar o elenco inteiro.
    """

    def __init__(self, pai, G, j):
        super().__init__(pai, "Renovar " + j["nome"], 620, 560, redimensionavel=True)
        self.G, self.j = G, j
        self.c = G["clubes"][G["clube"]]
        self.rodada = 0
        self.anos = 3
        self.exig = eng.exigencia_renovacao(G, j, self.anos)

        rotulo(self.corpo, j["nome"], fonte=FONTE_T).pack(anchor="w")
        rotulo(self.corpo, "%s, %d anos, overall %d, teto %s"
               % (eng.NOME_POS[j["pos"]], j["idade"], j["ovr"], eng.scout(G, j)),
               cor=TEMA["fraco"]).pack(anchor="w")
        imp = eng.importancia(G, j)
        peso = "reserva" if imp < 0.3 else ("titular" if imp < 0.7 else "peca central do time")
        rotulo(self.corpo, "Contrato atual: %d ano(s) a %s por mes   |   moral %d   |   e %s"
               % (j["contrato"], din(j["salario"]), j["moral"], peso),
               cor=TEMA["fraco"]).pack(anchor="w", pady=(0, 6))
        if j["contrato"] <= 1:
            rotulo(self.corpo, "Contrato acabando: se nao renovar, ele sai de graca na virada "
                   "da temporada.", cor=TEMA["ruim"]).pack(anchor="w", pady=(0, 6))

        b = bloco(self.corpo, "NOVO CONTRATO")
        fa = tk.Frame(b, bg=TEMA["painel"])
        fa.pack(fill="x")
        rotulo(fa, "Anos de contrato", fonte=FONTE_B, bg=TEMA["painel"]).pack(side="left")
        self.bt_anos = {}
        for n in range(1, 6):
            bt = botao_mini(fa, "  %d  " % n, lambda k=n: self.mudar_anos(k))
            bt.pack(side="left", padx=2)
            self.bt_anos[n] = bt
        self.r_sal = Regua(b, "Salario mensal oferecido", self.exig,
                           maximo=max(self.exig * 2, j["salario"] * 3, 10000),
                           bg=TEMA["painel"], ao_mudar=lambda v: self.reler(),
                           atalhos=[("- 10%", lambda: int(self.exig * 0.90)),
                                    ("- 5%", lambda: int(self.exig * 0.95)),
                                    ("o que ele pede", lambda: self.exig),
                                    ("+ 10%", lambda: int(self.exig * 1.10))])
        self.r_sal.pack(fill="x", pady=(8, 0))
        self.lb_sal = rotulo(b, "", cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["painel"])
        self.lb_sal.pack(anchor="w", pady=(4, 0))

        acoes = tk.Frame(self.corpo, bg=TEMA["fundo"])
        acoes.pack(fill="x", pady=8)
        botao(acoes, "Propor renovacao", self.enviar, cor=TEMA["acao"]).pack(side="left")
        botao(acoes, "Deixar pra depois", self.destroy).pack(side="left", padx=6)
        self.lb_rodada = rotulo(acoes, "tentativa 1 de 3", cor=TEMA["fraco"], fonte=FONTE_P)
        self.lb_rodada.pack(side="right")

        self.dialogo = tk.Text(self.corpo, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO,
                               relief="flat", wrap="word", padx=10, pady=8, height=5,
                               state="disabled")
        self.dialogo.pack(fill="both", expand=True)
        self.mudar_anos(3)

    def fala(self, txt):
        self.dialogo.configure(state="normal")
        self.dialogo.insert("end", txt + "\n")
        self.dialogo.see("end")
        self.dialogo.configure(state="disabled")

    def mudar_anos(self, n):
        self.anos = n
        for k, bt in self.bt_anos.items():
            bt.configure(bg=TEMA["acao"] if k == n else TEMA["linha"],
                         fg="white" if k == n else TEMA["fraco"])
        self.exig = eng.exigencia_renovacao(self.G, self.j, n)
        self.reler()

    def reler(self):
        s = self.r_sal.valor()
        recado, estado = eng.leitura_oferta(s, self.exig)
        self.r_sal.leitura("ele pede %s  -  %s" % (din(self.exig), recado), cor_estado(estado))
        folha = eng.folha_semanal(self.G, self.c)
        nova = folha + int((s - self.j["salario"]) / 4.0)
        self.lb_sal.configure(text="Folha semanal: %s  ->  %s   |   multa de rescisao ficaria %s"
                              % (din(folha), din(nova),
                                 din(int(s * 4 * max(1, self.anos) * 0.5))))

    def enviar(self):
        prop = eng.Proposta(jogador=self.j["id"], comprador=self.c["id"],
                            salario=self.r_sal.valor(), anos=self.anos,
                            tipo=eng.TIPO_RENOVACAO)
        r = eng.avaliar_renovacao(self.G, prop)
        if r.aceita:
            self.resultado = eng.fechar_renovacao(self.G, prop)
            messagebox.showinfo("Renovacao", self.resultado)
            self.destroy()
            return
        self.fala(r.motivo)
        self.exig = r.pedido or self.exig
        self.reler()
        if r.encerrada:
            self.resultado = r.motivo
            self.after(1100, self.destroy)
            return
        self.rodada += 1
        if self.rodada >= 3:
            self.resultado = eng.romper_renovacao(self.G, self.j)
            messagebox.showinfo("Renovacao", self.resultado)
            self.destroy()
            return
        self.lb_rodada.configure(text="tentativa %d de 3" % (self.rodada + 1))


class Propostas(Dialogo):
    """Propostas da semana pelos seus jogadores na vitrine, aceitas em lote."""

    def __init__(self, pai, G):
        super().__init__(pai, "Propostas recebidas", 780, 500, redimensionavel=True)
        self.G = G
        self.ofertas = eng.propostas_recebidas(G)
        rotulo(self.corpo, "Propostas desta semana", fonte=FONTE_T).pack(anchor="w")
        rotulo(self.corpo, "As mesmas ate a semana virar: nao adianta fechar e abrir. "
               "Marque quantas quiser e aceite de uma vez.",
               cor=TEMA["fraco"]).pack(anchor="w")
        rotulo(self.corpo, eng.recado_janela(G),
               cor=TEMA["ok"] if eng.mercado_aberto(G) else TEMA["av"],
               fonte=FONTE_P).pack(anchor="w", pady=(0, 8))
        q, self.tv = grade(self.corpo, [("nome", "Jogador", 165, "w"), ("pos", "Pos", 45, "center"),
                                        ("ovr", "Ovr", 45, "center"),
                                        ("clube", "Interessado", 165, "w"),
                                        ("div", "Serie", 50, "center"), ("of", "Oferta", 105, "e"),
                                        ("ped", "Voce pede", 105, "e"),
                                        ("dif", "Diferenca", 105, "e")], altura=9, multi=True)
        q.pack(fill="both", expand=True, pady=6)
        for i, (j, cl, v) in enumerate(self.ofertas):
            dif = v - j["listado"]
            self.tv.insert("", "end", iid=str(i),
                           values=(j["nome"], j["pos"], j["ovr"], cl["nome"], cl["divisao"],
                                   din(v), din(j["listado"]),
                                   ("+" if dif >= 0 else "") + din(dif)),
                           tags=("bom" if dif >= 0 else "aviso",))
        self.tv.bind("<<TreeviewSelect>>", lambda e: self.reler())
        self.lb = rotulo(self.corpo, "", cor=TEMA["fraco"], fonte=FONTE_P)
        self.lb.pack(anchor="w")
        f = tk.Frame(self.corpo, bg=TEMA["fundo"])
        f.pack(fill="x", pady=6)
        botao(f, "Aceitar marcadas", self.confirmar, cor=TEMA["acao"]).pack(side="left")
        botao(f, "Recusar marcadas", self.recusar).pack(side="left", padx=6)
        botao(f, "Fechar", self.destroy).pack(side="right")
        self.reler()

    def marcadas(self):
        return [self.ofertas[int(i)] for i in self.tv.selection()]

    def reler(self):
        m = self.marcadas()
        caixa = self.G["clubes"][self.G["clube"]]["dinheiro"]
        entra = sum(v for _j, _cl, v in m)
        folha = sum(j["salario"] for j, _cl, _v in m)
        self.lb.configure(text="%d marcada(s)  |  entram %s no caixa (%s -> %s)  |  "
                          "folha alivia %s por mes"
                          % (len(m), din(entra), din(caixa), din(caixa + entra), din(folha)))

    def confirmar(self):
        m = self.marcadas()
        if not m:
            messagebox.showinfo("BRASFUT", "Marque pelo menos uma proposta.")
            return
        recados = []
        for j, cl, v in m:
            recados.append(eng.aceitar_oferta(self.G, j["id"], cl["id"], v)[1])
        self.resultado = "\n".join(recados)
        messagebox.showinfo("Venda", self.resultado)
        self.destroy()

    def recusar(self):
        m = self.marcadas()
        if not m:
            return
        recados = [eng.recusar_oferta(self.G, j["id"])[1] for j, _cl, _v in m]
        self.resultado = "\n".join(recados)
        self.destroy()


def main():
    try:
        app = Brasfut()
        app.mainloop()
    except Exception:
        erro = traceback.format_exc()
        try:
            import tkinter.messagebox as mb
            mb.showerror("BRASFUT", "Deu problema ao abrir o jogo:\n\n" + erro[-1200:])
        except Exception:
            print(erro)


if __name__ == "__main__":
    main()
