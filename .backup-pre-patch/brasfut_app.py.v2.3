  mercado [POS]     quem esta a venda              salvar        grava o jogo
  visual            volta para a tela visual       ajuda         mostra isto
"""


class Brasfut(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("BRASFUT %s" % eng.VERSAO)
        self.geometry("1180x720")
        self.minsize(980, 620)
        self.configure(bg=TEMA["fundo"])
        estilo_ttk(self)
        eng.ESTILO["cor"] = False
        eng.ESTILO["uni"] = False
        self.G = None
        self.modo = "visual"
        self.view = "painel"
        self.historico_console = []
        self.resumos = []      # o que o painel conta como acontecimento
        self._monta_estrutura()
        self._inicio = self.after(60, self.abrir_jogo)

    # ---------------------------------------------------------------- estrutura
    def _monta_estrutura(self):
        self.topo = tk.Frame(self, bg=TEMA["painel"], height=74)
        self.topo.pack(fill="x", side="top")
        self.topo.pack_propagate(False)
        # a regua atravessa a janela inteira por baixo do botao de avancar e
        # morre na borda do alerta do painel: e o que liga o aviso a acao
        self.regua = tk.Frame(self.topo, bg=TEMA["borda"], height=4)
        self.regua.pack(side="bottom", fill="x")

        esq = tk.Frame(self.topo, bg=TEMA["painel"])
        esq.pack(side="left", padx=18, pady=10)
        self.lb_clube = rotulo(esq, "", fonte=FONTE_T, bg=TEMA["painel"])
        self.lb_clube.pack(anchor="w")
        self.lb_sub = rotulo(esq, "", cor=TEMA["fraco"], bg=TEMA["painel"])
        self.lb_sub.pack(anchor="w")

        dirf = tk.Frame(self.topo, bg=TEMA["painel"])
        dirf.pack(side="right", padx=16, pady=10)
        linha1 = tk.Frame(dirf, bg=TEMA["painel"])
        linha1.pack(anchor="e")
        self.bt_modo = botao(linha1, "Modo linha", self.alternar_modo)
        self.bt_modo.pack(side="right", padx=4)
        botao(linha1, "Ajuda", self.abrir_ajuda).pack(side="right", padx=4)
        self.bt_resumo = botao(linha1, "Resumo do ano", self.ver_resumo_temporada)
        botao(linha1, "Salvar", self.salvar).pack(side="right", padx=4)
        self.bt_semana = botao(linha1, "Avancar semana", self.avancar, cor=TEMA["acao"])
        self.bt_semana.pack(side="right", padx=4)
        self.bt_avancar_em = botao(linha1, "Avancar em...", self.abrir_avanco)
        self.bt_avancar_em.pack(side="right", padx=4)
        self.lb_ponto = rotulo(linha1, "", cor=TEMA["av"], fonte=FONTE_P, bg=TEMA["painel"])
        self.lb_ponto.pack(side="right")
        self.lb_caixa = rotulo(dirf, "", cor=TEMA["fraco"], bg=TEMA["painel"])
        self.lb_caixa.pack(anchor="e", pady=(6, 0))

        self.meio = tk.Frame(self, bg=TEMA["fundo"])
        self.meio.pack(fill="both", expand=True)

        self.lateral = tk.Frame(self.meio, bg=TEMA["painel"], width=170)
        self.lateral.pack(side="left", fill="y")
        self.lateral.pack_propagate(False)
        self.bt_nav = {}
        for chave, txt in NAV:
            b = tk.Button(self.lateral, text="  " + txt, anchor="w", font=FONTE,
                          relief="flat", bg=TEMA["painel"], fg=TEMA["fraco"],
                          activebackground=TEMA["linha"], activeforeground="white",
                          bd=0, highlightthickness=0, padx=10, pady=9, cursor="hand2",
                          command=lambda c=chave: self.mostrar(c))
            b.pack(fill="x")
            self.bt_nav[chave] = b

        self.area = tk.Frame(self.meio, bg=TEMA["fundo"])
        self.area.pack(side="left", fill="both", expand=True)
        self.area.bind("<Configure>", self._area_redimensionada)

        self.console = tk.Frame(self.meio, bg=TEMA["consfundo"])
        self.txt_console = tk.Text(self.console, bg=TEMA["consfundo"], fg=TEMA["constxt"],
                                   font=MONO, relief="flat", wrap="none", padx=12, pady=8,
                                   insertbackground=TEMA["ok"])
        sb = ttk.Scrollbar(self.console, orient="vertical", command=self.txt_console.yview)
        self.txt_console.configure(yscrollcommand=sb.set, state="disabled")
        self.txt_console.pack(side="top", fill="both", expand=True)
        sb.place(relx=1.0, rely=0, relheight=1.0, anchor="ne")
        entrada = tk.Frame(self.console, bg=TEMA["consfundo"])
        entrada.pack(side="bottom", fill="x", padx=10, pady=8)
        tk.Label(entrada, text=">", bg=TEMA["consfundo"], fg=TEMA["ok"], font=MONO).pack(side="left")
        self.ent_cmd = tk.Entry(entrada, bg=TEMA["consfundo"], fg=TEMA["constxt"], font=MONO,
                                relief="flat", insertbackground=TEMA["ok"])
        self.ent_cmd.pack(side="left", fill="x", expand=True, padx=6)
        self.ent_cmd.bind("<Return>", self.executar_comando)

        self.rodape = tk.Frame(self, bg=TEMA["painel"], height=26)
        self.rodape.pack(fill="x", side="bottom")
        self.lb_status = rotulo(self.rodape, "", cor=TEMA["fraco"], bg=TEMA["painel"])
        self.lb_status.pack(side="left", padx=14)

    def diagnostico(self, recarregar=False):
        """O veredito da semana, calculado uma vez e distribuido pela interface.

        Regua do topo, cor do botao, faixa do painel e rodape leem daqui. Cinco
        pontos da tela discordando entre si e pior do que nenhum aviso.
        """
        if self.G is None:
            return None
        if recarregar or getattr(self, "_diag", None) is None:
            self._diag = eng.diagnostico_escalacao(self.G)
        return self._diag

    def status(self, txt, cor=None):
        self.lb_status.configure(text=txt, fg=cor or TEMA["fraco"])

    def log(self, txt):
        if not txt:
            return
        self.historico_console.append(txt.rstrip())
        self.txt_console.configure(state="normal")
        self.txt_console.insert("end", txt.rstrip() + "\n\n")
        self.txt_console.see("end")
        self.txt_console.configure(state="disabled")

    # ------------------------------------------------------------------- inicio
    def abrir_jogo(self):
        G = None
        novo = True
        if os.path.exists(eng.SAVE):
            if messagebox.askyesno("BRASFUT", "Existe um jogo salvo.\nQuer continuar de onde parou?"):
                try:
                    G = eng.carregar()
                    novo = False
                except Exception as e:
                    messagebox.showwarning("BRASFUT", "Nao consegui abrir o save (%s).\nVou comecar um jogo novo." % e)
        if G is None:
            G, texto = capturar(eng.criar_mundo, "Tecnico")
            self.log(texto)
            cid = NovoJogo(self, G).esperar()
            if not cid:
                self.destroy()
                return
            G["clube"] = cid
            G["clubes"][cid]["escalacao"] = eng.auto_escalar(G, G["clubes"][cid])
            eng.definir_objetivo(G)
        G["auto"] = True          # impede que o motor peca input pelo terminal
        eng.trocar_de_clube = self.escolher_novo_clube
        self.G = G
        self.log("Bem-vindo ao %s. Objetivo: %s." %
                 (G["clubes"][G["clube"]]["nome"], G["objetivo"]))
        self.log(AJUDA)
        self.atualizar_topo()
        self.mostrar("painel")
        if novo:
            # so na carreira nova: quem ja tem save nao precisa da apresentacao
            Boas_vindas(self, G).esperar()

    def atualizar_topo(self):
        G = self.G
        c = G["clubes"][G["clube"]]
        self.lb_clube.configure(text=c["nome"])
        if G["fase"] == "entretemporada":
            quando = "PRE-TEMPORADA %d  |  o ano comeca pelo estadual" % G["temporada"]
            self.bt_semana.configure(text="Comecar o ano %d" % G["temporada"])
        elif G["fase"] == "estadual":
            est = eng.meu_estadual(G)
            quando = ("%s  |  rodada %d de %d"
                      % (est["nome"] if est else "Pre-temporada",
                         int(G.get("semana_est", 1)), eng.rodadas_estaduais(G)))
            self.bt_semana.configure(text="Avancar rodada")
        else:
            quando = "Temporada %d  |  semana %02d de %d" % (G["temporada"], G["semana"], eng.SEMANAS_LIGA)
            self.bt_semana.configure(text="Avancar semana")
        pos = ""
        est = eng.meu_estadual(G) if G["fase"] == "estadual" else None
        if est and est["rodada"] > 0:
            ordem = eng.classificacao(G, est)
            t = est["tabela"][str(c["id"])]
            pos = "  |  %do no estadual, %d pts" % (ordem.index(c["id"]) + 1, t["p"])
        liga = G["ligas"][c["divisao"]]
        if G["fase"] == "liga" and liga["rodada"] > 0:
            t = liga["tabela"][str(c["id"])]
            pos = "  |  %do lugar, %d pts" % (eng.posicao_na_liga(G, c["id"]), t["p"])
        self.lb_sub.configure(text="%s  |  Serie %s  |  %s%s" % (c["estadio"], c["divisao"], quando, pos))
        # o resumo do ano so existia na pre-temporada: sumia quando o estadual
        # comecava e nao voltava mais ate a virada seguinte
        if G.get("ultimo_resumo"):
            self.bt_resumo.pack(side="right", padx=4)
        else:
            self.bt_resumo.pack_forget()
        self.lb_caixa.configure(
            text="Caixa %s     Folha %s/mes     Elenco %d" %
                 (din(c["dinheiro"]), din(eng.folha_semanal(G, c) * 4), len(c["elenco"])),
            fg=TEMA["ok"] if c["dinheiro"] >= 0 else TEMA["ruim"])
        self.pintar_estado()

    def pintar_estado(self):
        """Regua, botao e ponto de atencao vestem a cor do diagnostico.

        O botao nunca e desabilitado: entrar em campo quebrado e um direito do
        tecnico. Nao saber que esta quebrado e que nao e.
        """
        d = self.diagnostico(recarregar=True)
        if self.G["fase"] == "estadual":
            self.regua.configure(bg=cor_estado(d["estado"]) if d and d["estado"] != "ok"
                                 else TEMA["top"])
            self.lb_ponto.configure(text="")
            self.bt_semana.configure(bg=TEMA["top"], fg=texto_sobre(TEMA["top"]),
                                     activebackground=TEMA["top"],
                                     activeforeground=texto_sobre(TEMA["top"]))
            return
        if self.G["fase"] == "entretemporada":
            # verde e o unico jeito de a pre-temporada nao passar por semana comum
            self.regua.configure(bg=TEMA["ok"])
            self.lb_ponto.configure(text="")
            self.bt_semana.configure(bg=TEMA["ok"], fg=texto_sobre(TEMA["ok"]),
                                     activebackground=TEMA["ok"],
                                     activeforeground=texto_sobre(TEMA["ok"]))
            return
        if not d:
            self.regua.configure(bg=TEMA["borda"])
            self.lb_ponto.configure(text="")
            return
        estado = d["estado"]
        self.regua.configure(bg=TEMA["borda"] if estado in ("ok", "neutro")
                             else cor_estado(estado))
        if estado == "critico":
            self.bt_semana.configure(text="Avancar assim mesmo", bg=TEMA["ruim"],
                                     fg=texto_sobre(TEMA["ruim"]),
                                     activebackground=TEMA["ruim"],
                                     activeforeground=texto_sobre(TEMA["ruim"]))
        else:
            self.bt_semana.configure(text="Avancar semana", bg=TEMA["acao"],
                                     fg=texto_sobre(TEMA["acao"]),
                                     activebackground=TEMA["acao"],
                                     activeforeground=texto_sobre(TEMA["acao"]))
        # cor sozinha nao comunica: quem nao distingue as cores via uma barra
        # de 2px mudando de tom e mais nada. Agora tem palavra junto.
        self.lb_ponto.configure(
            text={"atencao": "\u25cf ATENCAO ", "critico": "\u25a0 TIME QUEBRADO "}.get(
                estado, ""),
            fg=cor_estado(estado) if estado in ("atencao", "critico") else TEMA["fraco"])

    # -------------------------------------------------------------------- modos
    def alternar_modo(self):
        if self.modo == "visual":
            self.modo = "linha"
            self.lateral.pack_forget()
            self.area.pack_forget()
            self.console.pack(fill="both", expand=True)
            self.bt_modo.configure(text="Modo visual")
            self.ent_cmd.focus_set()
            self.status("modo linha: digite ajuda para ver os comandos")
        else:
            self.modo = "visual"
            self.console.pack_forget()
            self.lateral.pack(side="left", fill="y")
            self.area.pack(side="left", fill="both", expand=True)
            self.bt_modo.configure(text="Modo linha")
            self.mostrar(self.view)
            self.status("")

    def mostrar(self, chave):
        self.view = chave
        for k, b in self.bt_nav.items():
            b.configure(fg="white" if k == chave else TEMA["fraco"],
                        bg=TEMA["linha"] if k == chave else TEMA["painel"])
        for w in self.area.winfo_children():
            w.destroy()
        getattr(self, "tela_" + chave)(self.area)

    def _area_redimensionada(self, _=None):
        """So redesenha quando a janela cruza a largura que muda o layout.

        Sem essa guarda, cada pixel de arrasto redesenharia o painel inteiro.
        """
        if self.view != "painel" or self.modo != "visual" or self.G is None:
            return
        largo = self.winfo_width() >= LARGURA_CHEIA
        alto = self.area.winfo_height() >= 600
        if (largo, alto) == (getattr(self, "_painel_largo", None),
                             getattr(self, "_painel_alto", None)):
            return
        self.mostrar("painel")

    def cabecalho_tela(self, pai, titulo, sub=""):
        f = tk.Frame(pai, bg=TEMA["fundo"])
        f.pack(fill="x", padx=18, pady=(14, 6))
        rotulo(f, titulo, fonte=FONTE_T).pack(anchor="w")
        if sub:
            rotulo(f, sub, cor=TEMA["fraco"]).pack(anchor="w")
        return f

    # ------------------------------------------------------------------ semana
    def avancar(self):
        G = self.G
        if G["fase"] == "entretemporada":
            self.iniciar_temporada()
            return
        d = self.diagnostico(recarregar=True)
        if d and d["estado"] == "critico":
            texto = ("%s\n\nAvancar a semana agora entra em campo com esse time.\n"
                     "Ataque %.1f, defesa %.1f - com o problema ja descontado.\n\n"
                     "Avancar mesmo assim?" % (d["titulo"], d["ataque"], d["defesa"]))
            if not messagebox.askyesno("Time quebrado", texto, default="no", icon="warning"):
                self.mostrar("escalacao")
                return
        temp_antes, fase_antes = G["temporada"], G["fase"]
        ok, txt = capturar(eng.jogar_semana, G)
        self.log(txt)
        self.resumos = (self.resumos + [txt])[-5:]
        if ok is False:
            self.log("Carreira encerrada.")
            messagebox.showinfo("BRASFUT", "Carreira encerrada.")
            self.bt_semana.configure(state="disabled")
            self.atualizar_topo()
            return
        self.status("semana processada e salva", TEMA["ok"])
        self.atualizar_topo()
        # o jogo e o ponto: avancar uma semana abre a partida na cara
        jogos = eng.resultados_da_semana(G)
        if jogos and G["temporada"] == temp_antes:
            Partida(self, G, jogos[0]).esperar()
            for outro in jogos[1:]:
                Partida(self, G, outro).esperar()
        if fase_antes == "estadual" and G["fase"] == "liga":
            self.anunciar_fim_do_estadual()
        # a virada de ano nao pode passar em branco: o resumo vem na cara
        r = G.get("ultimo_resumo")
        if G["temporada"] != temp_antes and r:
            if getattr(self, "_resumo_mostrado", None) != r["temporada"]:
                ResumoTemporada(self, G, r).esperar()
                self._resumo_mostrado = r["temporada"]
            self.status("temporada %d encerrada - agora e pre-temporada" % temp_antes,
                        TEMA["ok"])
            self.atualizar_topo()
            if self.modo == "visual":
                self.mostrar("painel")
            return
        if self.modo == "visual":
            self.mostrar(self.view if self.view != "escalacao" else "painel")

    def iniciar_temporada(self):
        """Comecar o ano e decisao, nao consequencia de clicar em avancar."""
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        vencidos = [G["jogadores"][p]["nome"] for p in c["elenco"]
                    if G["jogadores"][p]["contrato"] <= 0 and not G["jogadores"][p].get("dono")]
        avisos = []
        if vencidos:
            avisos.append("Saem de graca agora, por fim de contrato:\n  %s"
                          % ", ".join(vencidos))
        if len(c["elenco"]) < 18:
            avisos.append("Elenco com %d jogadores: pouco para 38 rodadas." % len(c["elenco"]))
        prontos = [j["nome"] for j in eng.elenco_base(G, c) if eng.pronto_para_subir(G, c, j)]
        if prontos:
            avisos.append("Pronto(s) para subir da base: %s" % ", ".join(prontos))
        if avisos and not messagebox.askyesno(
                "Iniciar a temporada %d" % G["temporada"],
                "%s\n\nComecar a temporada assim?" % "\n\n".join(avisos),
                default="no", icon="warning"):
            self.mostrar("elenco")
            return
        _, txt = capturar(eng.iniciar_temporada, G)
        self.log(txt)
        self.status("temporada %d comecou" % G["temporada"], TEMA["ok"])
        self.atualizar_topo()
        if self.modo == "visual":
            self.mostrar("painel")

    def abrir_ajuda(self):
        """A ajuda tem que existir no modo Visual, que e onde as pessoas jogam."""
        Ajuda(self, self.G).esperar()

    def abrir_avanco(self):
        """Painel de avanco em lote. Depois dele a tela inteira se refaz."""
        Avancar(self, self).esperar()
        self.atualizar_topo()
        if self.modo == "visual":
            self.mostrar("painel")

    def anunciar_fim_do_estadual(self):
        G = self.G
        est = eng.meu_estadual(G)
        if not est or not est.get("campeao"):
            messagebox.showinfo("Estadual", "Estadual encerrado. O Brasileirao comeca agora.")
            return
        campeao = G["clubes"][est["campeao"]]
        ordem = eng.classificacao(G, est)
        minha = ordem.index(G["clube"]) + 1 if G["clube"] in ordem else 0
        if est["campeao"] == G["clube"]:
            texto = "CAMPEAO %s!\n\nO titulo entra na galeria do clube." % est["nome"].upper()
        else:
            texto = ("%s: %s campeao.\nVoce terminou em %do.\n\n"
                     % (est["nome"], campeao["nome"], minha))
        messagebox.showinfo("Fim do estadual",
                            texto + "\nO Brasileirao Serie %s comeca agora."
                            % G["clubes"][G["clube"]]["divisao"])

    def ver_resumo_temporada(self):
        r = self.G.get("ultimo_resumo")
        if not r:
            messagebox.showinfo("BRASFUT", "Nenhuma temporada encerrada ainda.")
            return
        ResumoTemporada(self, self.G, r).esperar()

    def salvar(self):
        try:
            eng.salvar(self.G)
            self.status("jogo salvo em %s" % os.path.basename(eng.SAVE), TEMA["ok"])
        except Exception as e:
            self.status("falha ao salvar: %s" % e, TEMA["ruim"])

    def escolher_novo_clube(self, G):
        """Substitui a versao de terminal do motor quando o tecnico e demitido.

        O motor chama isto de dentro do fim de temporada, antes de avancar()
        voltar. Por isso o resumo do ano sai daqui tambem: ninguem entende a
        demissao sem antes ver a temporada que a causou.
        """
        r = G.get("ultimo_resumo")
        if r and getattr(self, "_resumo_mostrado", None) != r["temporada"]:
            ResumoTemporada(self, G, r).esperar()
            self._resumo_mostrado = r["temporada"]
        cands = [cl for cl in G["clubes"].values()
                 if cl["divisao"] in "BCD" and cl["id"] != G["clube"]]
        cands.sort(key=lambda cl: -cl["reputacao"])
        ofertas = eng.rng.sample(cands[:30], min(4, len(cands)))
        cid = EscolherClube(self, G, ofertas).esperar()
        if not cid:
            return False
        antigo = G["clubes"][G["clube"]]
        G["clube"] = cid
        eng.herdar_preferencias(G, antigo)
        eng.definir_objetivo(G)
        return True

    # ------------------------------------------------------------------ painel
    def tela_painel(self, pai):
        """A tela responde uma pergunta so: posso avancar a semana agora?

        Tudo se ordena por isso. O veredito vem primeiro e ocupa a largura
        inteira; a prova (o XI que entra em campo) vem logo abaixo e e o maior
        bloco da tela; o resto e contexto da aposta e memoria.
        """
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        d = self.diagnostico(recarregar=True)
        self._medir_painel()
        self.cabecalho_tela(pai, "Painel", self._resumo_da_rodada())
        if G["fase"] == "entretemporada":
            self._faixa_pretemporada(pai)
        else:
            self._faixa_prontidao(pai, d)
        self._faixa_resultados(pai)
        self.status(*self._status_do_estado(d))

        corpo = tk.Frame(pai, bg=TEMA["fundo"])
        corpo.pack(fill="both", expand=True, padx=18, pady=(0, 4))

        cima = tk.Frame(corpo, bg=TEMA["fundo"], height=self._alt_cima)
        cima.pack(fill="x")
        cima.pack_propagate(False)
        coluna = tk.Frame(cima, bg=TEMA["fundo"], width=370 if self._painel_largo else 300)
        coluna.pack(side="right", fill="y")
        coluna.pack_propagate(False)
        self._card_proximo(coluna, d).pack(fill="x")
        self._card_objetivo(coluna).pack(fill="x", pady=(10, 0))
        self._card_escalacao(cima, d).pack(side="left", fill="both", expand=True, padx=(0, 12))

        # a linha de baixo fica com a sobra: e ela que absorve janela pequena
        baixo = tk.Frame(corpo, bg=TEMA["fundo"])
        baixo.pack(fill="both", expand=True, pady=(6, 0))
        self._card_tabela(baixo).pack(side="left", fill="both", expand=True)
        self._card_destaques(baixo).pack(side="left", fill="both", expand=True, padx=(12, 0))
        if self._painel_largo:
            self._card_acontecimentos(baixo).pack(side="left", fill="both",
                                                  expand=True, padx=(12, 0))

    def _medir_painel(self):
        """Mede a area util e decide o que cabe. Altura manda tanto quanto largura.

        Sem isto, uma janela de 980x620 cortava a tabela pela metade: o layout
        era fixo em pixels de uma tela de 1180x720 que nem todo mundo tem.
        """
        larg = self.winfo_width() if self.winfo_width() > 200 else 1180
        alt = self.area.winfo_height() if self.area.winfo_height() > 200 else 620
        self._painel_largo = larg >= LARGURA_CHEIA
        self._painel_alto = alt >= 600
        self._alt_faixa = 56 if self._painel_alto else 48
        self._alt_res = 58 if self._painel_alto else 52
        self._alt_cima = 262 if self._painel_alto else 226
        # 149 e o que o cabecalho, a faixa e os respiros comem antes da grade;
        # 50 e o titulo do cartao mais o cabecalho da tabela; 22 e a linha
        sobra = alt - 149 - self._alt_res - self._alt_cima
        self._linhas_grade = max(2, min(8, (sobra - 66) // 22))

    def _resumo_da_rodada(self):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        if G["fase"] == "entretemporada":
            return "Pre-temporada . mercado aberto . o ano comeca pelo estadual"
        if G["fase"] == "estadual":
            est = eng.meu_estadual(G)
            return ("%s . rodada %d de %d . mercado aberto"
                    % (est["nome"] if est else "Pre-temporada",
                       int(G.get("semana_est", 1)), eng.rodadas_estaduais(G)))
        liga = G["ligas"][c["divisao"]]
        faltam = max(0, len(liga["rodadas"]) - liga["rodada"])
        return "Rodada %d . Serie %s . %d jogo(s) restante(s)" % (
            liga["rodada"] + 1, c["divisao"], faltam)

    def _status_do_estado(self, d):
        """O rodape repete o headline da faixa, na mesma cor. De proposito."""
        if not d:
            return "", None
        if d["estado"] == "critico":
            return "time quebrado: corrija antes de avancar a semana", TEMA["ruim"]
        if d["estado"] == "atencao":
            return d["titulo"].lower(), TEMA["av"]
        if d["estado"] == "ok":
            return "time pronto para a semana", TEMA["ok"]
        return "sem jogo nesta semana", TEMA["fraco"]

    # ------------------------------------------------------ faixa de prontidao
    def _faixa_prontidao(self, pai, d):
        """Altura fixa nos tres estados: a tela nao pode pular de uma semana
        para a outra, senao o usuario perde o lugar de onde le o veredito."""
