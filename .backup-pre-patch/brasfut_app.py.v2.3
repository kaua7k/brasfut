# cor de texto para escrever EM CIMA de cada cor de fundo, escolhida por
# contraste e nao por gosto. Ver contraste() logo abaixo.
BRANCO = "#ffffff"


def _luminancia(hexa):
    """Luminancia relativa da WCAG. Entrada no formato #rrggbb."""
    h = hexa.lstrip("#")
    canais = [int(h[i:i + 2], 16) / 255.0 for i in (0, 2, 4)]
    canais = [(c / 12.92) if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
              for c in canais]
    return 0.2126 * canais[0] + 0.7152 * canais[1] + 0.0722 * canais[2]


def contraste(frente, fundo):
    """Razao de contraste WCAG entre duas cores. 4.5 e o minimo para texto."""
    a, b = _luminancia(frente), _luminancia(fundo)
    return (max(a, b) + 0.05) / (min(a, b) + 0.05)


def texto_sobre(fundo):
    """A cor de texto mais legivel para este fundo.

    O verde e o amarelo do tema sao claros: texto claro em cima deles fica em
    1.7:1, que e quase nao ver nada. Sobre eles escreve-se escuro.
    """
    claro = max(contraste(BRANCO, fundo), contraste(TEMA["txt"], fundo))
    escuro = contraste(TEMA["fundo"], fundo)
    if escuro > claro:
        return TEMA["fundo"]
    return BRANCO if contraste(BRANCO, fundo) >= contraste(TEMA["txt"], fundo) else TEMA["txt"]


def cor_link(fundo=None):
    """Cor de texto clicavel. O azul de acao falha como texto (3.74:1);
