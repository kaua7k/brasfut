    # ----------------------------------------------------------------- mercado
    def trocar_aba_mercado(self, chave):
        self.aba_mercado = chave
        self.mostrar("mercado")

    def tela_mercado(self, pai):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        aberto = eng.mercado_aberto(G)
        aba = getattr(self, "aba_mercado", "compra")
