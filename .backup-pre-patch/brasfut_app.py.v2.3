def cor_estado(estado):
    """Traduz o estado do diagnostico para o token de cor do tema."""
    return TEMA[CORES_ESTADO.get(estado, "fraco")]


def din(v):
    return eng.din(v)


def limpar_texto(txt):
    """Tira as molduras de terminal do motor e deixa o texto limpo para a janela."""
    saida, vazias = [], 0
    for bruto in txt.splitlines():
        linha = bruto.rstrip()
        nu = linha.strip()
        if nu and set(nu) <= set("-=+|.,: "):
            continue
        if nu.startswith("|"):
            nu = nu[1:]
            if nu.endswith("|"):
                nu = nu[:-1]
            linha = "  " + nu.strip()
        if not linha.strip():
            vazias += 1
            if vazias > 1:
                continue
        else:
            vazias = 0
        saida.append(linha)
    return "\n".join(saida).strip()


def capturar(func, *a, **kw):
    """Roda uma funcao do motor e devolve (retorno, texto impresso ja limpo)."""
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        ret = func(*a, **kw)
    return ret, limpar_texto(eng.re.sub(r"\033\[[0-9;]*m", "", buf.getvalue()))


class Dialogo(tk.Toplevel):
    """Janela modal simples com corpo montado pela subclasse."""

    def __init__(self, pai, titulo, largura=560, altura=420, redimensionavel=False):
        super().__init__(pai)
        self.resultado = None
        self.title(titulo)
        self.configure(bg=TEMA["fundo"])
        self.transient(pai)
        self.resizable(redimensionavel, redimensionavel)
        # as mesas de negociacao cresceram: em tela baixa elas passariam do
        # rodape e os botoes ficariam fora do alcance.
        altura = min(altura, self.winfo_screenheight() - 110)
        largura = min(largura, self.winfo_screenwidth() - 40)
        self.corpo = tk.Frame(self, bg=TEMA["fundo"], padx=16, pady=14)
        self.corpo.pack(fill="both", expand=True)
        self.geometry("%dx%d" % (largura, altura))
        self.update_idletasks()
        x = pai.winfo_rootx() + (pai.winfo_width() - largura) // 2
        y = pai.winfo_rooty() + (pai.winfo_height() - altura) // 3
        self.geometry("+%d+%d" % (max(0, x), max(0, y)))

    def esperar(self):
        self.grab_set()
        self.wait_window(self)
        return self.resultado


def rotulo(pai, txt, cor=None, fonte=None, **kw):
    return tk.Label(pai, text=txt, bg=kw.pop("bg", TEMA["fundo"]),
                    fg=cor or TEMA["txt"], font=fonte or FONTE,
                    anchor=kw.pop("anchor", "w"), **kw)


def botao(pai, txt, cmd, cor=None, largura=None):
    """Botao do tema. A cor do TEXTO sai do fundo, nao de um padrao fixo.

    Antes todo botao nascia com fg=TEMA["txt"]: sobre o azul primario dava
    3.79:1 e sobre o verde dava 1.74:1 - o botao "Comecar o ano" era texto
    quase invisivel. Agora texto_sobre() decide, e todo botao novo ja nasce
    legivel sem ninguem precisar lembrar.
    """
    fundo = cor or TEMA["painel"]
    frente = texto_sobre(fundo)
    b = tk.Button(pai, text=txt, command=cmd, font=FONTE_B, relief="flat",
                  bg=fundo, fg=frente, activebackground=TEMA["acao"],
                  activeforeground=texto_sobre(TEMA["acao"]), cursor="hand2",
                  padx=12, pady=6, highlightthickness=0, bd=0)
    if largura:
        b.configure(width=largura)
    return b


def grade(pai, colunas, altura=14, multi=False):
    """Treeview com o visual do tema. colunas = [(id, titulo, largura, ancora)]

    multi=True libera Ctrl+clique e Shift+clique: e o que permite vender,
    renovar ou emprestar um monte de jogador de uma vez em vez de um por um.
    """
    quadro = tk.Frame(pai, bg=TEMA["fundo"])
    tv = ttk.Treeview(quadro, columns=[c[0] for c in colunas], show="headings",
                      height=altura, selectmode="extended" if multi else "browse")
    for cid, tit, larg, anc in colunas:
        tv.heading(cid, text=tit)
        tv.column(cid, width=larg, anchor=anc, stretch=False)
    barra = ttk.Scrollbar(quadro, orient="vertical", command=tv.yview)
    tv.configure(yscrollcommand=barra.set)
    tv.pack(side="left", fill="both", expand=True)
    barra.pack(side="right", fill="y")
    tv.tag_configure("bom", foreground=TEMA["ok"])
    tv.tag_configure("top", foreground=TEMA["top"])
    tv.tag_configure("ruim", foreground=TEMA["ruim"])
    tv.tag_configure("aviso", foreground=TEMA["av"])
    tv.tag_configure("meu", foreground=TEMA["av"])
    tv.tag_configure("fraco", foreground=TEMA["fraco"])
    return quadro, tv


def corta(txt, n):
    """Corta o texto no limite da coluna sem deixar palavra pela metade feia."""
    return txt if len(txt) <= n else txt[:n - 3] + "..."


def tag_ovr(ovr):
    if ovr >= 78:
        return "top"
    if ovr >= 68:
        return "bom"
    if ovr >= 55:
        return ""
    return "fraco"


def parse_dinheiro(txt):
    """Le dinheiro do jeito que a pessoa escreve.

    12000000, 12.000.000, "12 mi", "12,5 mi", "800 mil", "90k" e "R$ 1,2 bi"
    chegam todos no mesmo numero. Antes o campo aceitava so digitos crus.
    """
    t = (txt or "").strip().lower().replace("r$", "").replace(" ", "")
    if not t:
        return 0
    mult = 1
    if "bi" in t:
        mult, t = 1_000_000_000, t.replace("bi", "")
    elif "mil" in t:
        mult, t = 1_000, t.replace("mil", "")
    elif t.endswith("k"):
        mult, t = 1_000, t[:-1]
    elif "mi" in t or t.endswith("m"):
        mult, t = 1_000_000, t.replace("mi", "").rstrip("m")
    if mult > 1:
        t = t.replace(".", "").replace(",", ".")
        try:
            return max(0, int(round(float(t or 0) * mult)))
        except ValueError:
            return 0
    digitos = eng.re.sub(r"[^0-9]", "", t)
    return int(digitos) if digitos else 0


def agrupa(v):
    """1200000 -> 1.200.000, do jeito que se escreve dinheiro por aqui."""
    return "{:,}".format(int(v)).replace(",", ".")


def botao_mini(pai, txt, cmd, cor=None, bg=None):
    """Atalho do tamanho de um chip. E o que as reguas usam para os presets."""
    fundo = cor or TEMA["linha"]
    frente = TEMA["fraco"] if fundo == TEMA["linha"] else texto_sobre(fundo)
    return tk.Button(pai, text=txt, command=cmd, font=FONTE_P, relief="flat",
                     bg=fundo, fg=frente, activebackground=TEMA["acao"],
                     activeforeground=texto_sobre(TEMA["acao"]), cursor="hand2",
                     padx=7, pady=2, highlightthickness=0, bd=0)


def bloco(pai, titulo=None):
    """Cartao do tema para agrupar um trecho do formulario."""
    f = tk.Frame(pai, bg=TEMA["painel"], padx=12, pady=10)
    f.pack(fill="x", pady=4)
    if titulo:
        rotulo(f, titulo, cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["painel"]).pack(anchor="w", pady=(0, 6))
    return f


class CampoDinheiro(tk.Frame):
    """Campo de dinheiro que se formata sozinho enquanto voce digita.

    So reformata quando o texto e todo numerico: se houver letra a pessoa ainda
    esta escrevendo "mi" ou "mil" e mexer no texto no meio atrapalharia. O
    numero de verdade so e lido em valor().
    """

    def __init__(self, pai, valor=0, largura=14, ao_mudar=None, bg=None):
        super().__init__(pai, bg=bg or TEMA["fundo"])
        self.ao_mudar = ao_mudar
        self._quieto = False
        self.var = tk.StringVar()
        self.entrada = tk.Entry(self, textvariable=self.var, width=largura, bg=TEMA["painel"],
                                fg=TEMA["txt"], relief="flat", font=MONO, justify="right",
                                insertbackground=TEMA["txt"])
        self.entrada.pack(side="left", ipady=4, ipadx=4)
        self.var.trace_add("write", self._digitou)
        self.entrada.bind("<FocusOut>", lambda e: self.definir(self.valor()))
        self.entrada.bind("<Return>", lambda e: self.definir(self.valor()))
        self.definir(valor, avisar=False)

    def valor(self):
        return parse_dinheiro(self.var.get())

    def definir(self, v, avisar=True):
        self._quieto = True
        self.var.set(agrupa(max(0, int(v))))
        self._quieto = False
        self.entrada.icursor("end")
        if avisar and self.ao_mudar:
            self.ao_mudar(self.valor())

    def _digitou(self, *_):
        if self._quieto:
            return
        bruto = self.var.get()
        if not any(ch.isalpha() for ch in bruto):
            limpo = agrupa(parse_dinheiro(bruto)) if bruto.strip() else ""
            if limpo != bruto:
                no_fim = self.entrada.index("insert") >= len(bruto)
                self._quieto = True
                self.var.set(limpo)
                self._quieto = False
                if no_fim:
                    self.entrada.icursor("end")
        if self.ao_mudar:
            self.ao_mudar(self.valor())


class Regua(tk.Frame):
    """Titulo, campo, barra e atalhos: a peca que substituiu o Entry pelado.

    Serve para dinheiro (passe, salario, opcao de compra) e para percentual
    (fatia do salario, preco de vitrine). A leitura no pe da regua e onde a
    interface conta, em tempo real, como o outro lado esta lendo a proposta.

    Digitar acima do fim da barra nao trava o valor: a barra estica. Travar
    seria pior, porque o campo mostraria um numero e valor() devolveria outro.
    """

    def __init__(self, pai, titulo, valor, minimo=0, maximo=100, dinheiro=True,
                 atalhos=(), ao_mudar=None, bg=None, largura_barra=330):
        bg = bg or TEMA["painel"]
        super().__init__(pai, bg=bg)
        self.dinheiro = dinheiro
        self.ao_mudar = ao_mudar
        self.minimo = int(minimo)
        self.maximo = max(self.minimo + 1, int(maximo))
        self._quieto = False
        self._v = int(eng.clamp(int(valor), self.minimo, self.maximo))

        topo = tk.Frame(self, bg=bg)
        topo.pack(fill="x")
        rotulo(topo, titulo, fonte=FONTE_B, bg=bg).pack(side="left")
        if dinheiro:
            self.campo = CampoDinheiro(topo, self._v, largura=13, bg=bg,
                                       ao_mudar=lambda _v: self._veio_do_campo())
            self.campo.pack(side="right")
        else:
            caixa = tk.Frame(topo, bg=bg)
            caixa.pack(side="right")
            rotulo(caixa, "%", cor=TEMA["fraco"], bg=bg).pack(side="right", padx=(3, 0))
            self.var_pct = tk.StringVar(value=str(self._v))
            self.campo = tk.Entry(caixa, textvariable=self.var_pct, width=5, bg=TEMA["painel"],
                                  fg=TEMA["txt"], relief="flat", font=MONO, justify="right",
                                  insertbackground=TEMA["txt"])
            self.campo.pack(side="right", ipady=4)
            self.var_pct.trace_add("write", lambda *_: self._veio_do_campo())

        self.barra = tk.Scale(self, from_=self.minimo, to=self.maximo, orient="horizontal",
                              resolution=self._passo(), showvalue=0, length=largura_barra,
                              bg=bg, fg=TEMA["txt"], troughcolor=TEMA["linha"],
                              activebackground=TEMA["acao"], highlightthickness=0,
                              sliderrelief="flat", bd=0)
        self.barra.pack(fill="x", pady=(4, 0))
        self.barra.set(self._v)
        # o command entra DEPOIS do set: senao o primeiro set dispara ao_mudar
        # antes de quem nos criou terminar de montar a propria tela.
        self.barra.configure(command=self._veio_da_barra)

        pe = tk.Frame(self, bg=bg)
        pe.pack(fill="x", pady=(3, 0))
        for texto, alvo in atalhos:
            botao_mini(pe, texto,
                       lambda a=alvo: self.definir(a() if callable(a) else a)).pack(side="left",
                                                                                   padx=(0, 4))
        self.lb = rotulo(pe, "", cor=TEMA["fraco"], fonte=FONTE_P, bg=bg)
        self.lb.pack(side="right")

    def _passo(self):
        if not self.dinheiro:
            return 1
        return max(1000, (self.maximo - self.minimo) // 400)

    def valor(self):
        return self._v

    def leitura(self, texto, cor=None):
        """A frase que aparece no pe da regua, ja com a cor do estado."""
        self.lb.configure(text=texto, fg=cor or TEMA["fraco"])

    def definir(self, v, avisar=True):
        v = int(v)
        if v > self.maximo:
            self._esticar(v)
        self._v = int(eng.clamp(v, self.minimo, self.maximo))
        self._quieto = True
        self.barra.set(self._v)
        if self.dinheiro:
            self.campo.definir(self._v, avisar=False)
        else:
            self.var_pct.set(str(self._v))
        self._quieto = False
        if avisar and self.ao_mudar:
            self.ao_mudar(self._v)

    def _esticar(self, v):
        if not self.dinheiro:
            return
        self.maximo = max(self.maximo, int(v * 1.15))
        self.barra.configure(to=self.maximo, resolution=self._passo())

    def _veio_do_campo(self):
        if self._quieto:
            return
        if self.dinheiro:
            v = self.campo.valor()
        else:
            v = int(eng.re.sub(r"[^0-9]", "", self.var_pct.get()) or 0)
        if v > self.maximo:
            self._esticar(v)
        self._v = int(eng.clamp(v, self.minimo, self.maximo))
        self._quieto = True
        self.barra.set(self._v)
        self._quieto = False
        if self.ao_mudar:
            self.ao_mudar(self._v)

    def _veio_da_barra(self, valor):
        if self._quieto:
            return
        self._v = int(float(valor))
        self._quieto = True
        if self.dinheiro:
            self.campo.definir(self._v, avisar=False)
        else:
            self.var_pct.set(str(self._v))
        self._quieto = False
        if self.ao_mudar:
            self.ao_mudar(self._v)

def estilo_ttk(raiz):
    st = ttk.Style(raiz)
    try:
        st.theme_use("clam")
    except Exception:
        pass
    st.configure("Treeview", background=TEMA["painel"], fieldbackground=TEMA["painel"],
                 foreground=TEMA["txt"], rowheight=22, borderwidth=0, font=MONO)
    st.configure("Treeview.Heading", background=TEMA["linha"], foreground=TEMA["fraco"],
                 relief="flat", font=(FONTE[0], 9, "bold"))
    st.map("Treeview", background=[("selected", TEMA["acao"])],
           foreground=[("selected", texto_sobre(TEMA["acao"]))])
    # Combobox tem DUAS partes e cada uma se pinta de um jeito. O campo e ttk,
    # mas em state="readonly" ele usa o mapa de estados, nao o configure: sem o
    # map abaixo o texto saia da cor padrao sobre fundo padrao e a caixa parecia
    # vazia. A lista suspensa nem ttk e - e um Listbox do tk puro, criado pelo
    # Tcl, que so obedece ao banco de opcoes. Dai o option_add.
    st.configure("TCombobox", fieldbackground=TEMA["painel"], background=TEMA["painel"],
                 foreground=TEMA["txt"], arrowcolor=TEMA["txt"],
                 selectbackground=TEMA["painel"], selectforeground=TEMA["txt"],
                 bordercolor=TEMA["borda"], lightcolor=TEMA["painel"],
                 darkcolor=TEMA["painel"], insertcolor=TEMA["txt"])
    st.map("TCombobox",
           fieldbackground=[("readonly", TEMA["painel"]), ("disabled", TEMA["painel"]),
                            ("!disabled", TEMA["painel"])],
           foreground=[("readonly", TEMA["txt"]), ("disabled", TEMA["fraco"]),
                       ("!disabled", TEMA["txt"])],
           selectbackground=[("readonly", TEMA["painel"]), ("focus", TEMA["acao"])],
           selectforeground=[("readonly", TEMA["txt"]), ("focus", "white")],
           background=[("readonly", TEMA["painel"]), ("active", TEMA["linha"])],
           arrowcolor=[("!disabled", TEMA["txt"])])
    raiz.option_add("*TCombobox*Listbox.background", TEMA["painel"])
    raiz.option_add("*TCombobox*Listbox.foreground", TEMA["txt"])
    raiz.option_add("*TCombobox*Listbox.selectBackground", TEMA["acao"])
    raiz.option_add("*TCombobox*Listbox.selectForeground", "white")
    raiz.option_add("*TCombobox*Listbox.font", FONTE)
    raiz.option_add("*TCombobox*Listbox.borderWidth", 0)
    raiz.option_add("*TCombobox*Listbox.highlightThickness", 0)
    st.configure("Vertical.TScrollbar", background=TEMA["linha"], troughcolor=TEMA["fundo"],
                 bordercolor=TEMA["fundo"], arrowcolor=TEMA["fraco"])
    st.configure("TCheckbutton", background=TEMA["painel"], foreground=TEMA["txt"],
                 focuscolor=TEMA["painel"], indicatorcolor=TEMA["fundo"])
    st.map("TCheckbutton",
           background=[("active", TEMA["painel"])],
           foreground=[("disabled", TEMA["fraco"]), ("!disabled", TEMA["txt"])],
           indicatorcolor=[("selected", TEMA["acao"]), ("!selected", TEMA["fundo"])])
    st.configure("TRadiobutton", background=TEMA["painel"], foreground=TEMA["txt"],
                 focuscolor=TEMA["painel"], indicatorcolor=TEMA["fundo"])
    st.map("TRadiobutton",
           background=[("active", TEMA["painel"])],
           foreground=[("disabled", TEMA["fraco"]), ("!disabled", TEMA["txt"])],
           indicatorcolor=[("selected", TEMA["acao"]), ("!selected", TEMA["fundo"])])
    st.configure("Horizontal.TProgressbar", background=TEMA["acao"],
                 troughcolor=TEMA["linha"], bordercolor=TEMA["fundo"],
                 lightcolor=TEMA["acao"], darkcolor=TEMA["acao"])


