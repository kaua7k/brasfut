class Partida(Dialogo):
    """A partida em tela cheia: placar, o que aconteceu e como cada um foi.

    Era o buraco do jogo. A simulacao acontecia, virava um placar numa linha de
    texto e sumia - o resultado, que e o ponto do jogo inteiro, tinha menos
    espaco que um filtro de mercado.
    """

    ICONE = {"gol": "GOL", "amarelo": " A ", "vermelho": " V ",
             "lesao": "LES", "substituicao": "SUB"}

    def __init__(self, pai, G, r):
        casa, fora = G["clubes"][r["casa"]], G["clubes"][r["fora"]]
        super().__init__(pai, "%s %d x %d %s" % (casa["nome"], r["gc"], r["gf"], fora["nome"]),
                         900, 700, redimensionavel=True)
        self.G, self.r = G, r
        self.meu = G["clube"]
        self.em_casa = r["casa"] == self.meu

        # ------------------------------------------------------------- placar
        topo = tk.Frame(self.corpo, bg=TEMA["painel"])
        topo.pack(fill="x")
        rotulo(topo, eng.nome_competicao(G, r["comp"], casa), cor=TEMA["fraco"],
               fonte=FONTE_PB, bg=TEMA["painel"]).pack(anchor="center", pady=(10, 2))
        linha = tk.Frame(topo, bg=TEMA["painel"])
        linha.pack(anchor="center", pady=(0, 4))
        gm, gs = (r["gc"], r["gf"]) if self.em_casa else (r["gf"], r["gc"])
        cr = TEMA["ok"] if gm > gs else (TEMA["av"] if gm == gs else TEMA["ruim"])
        rotulo(linha, corta(casa["nome"], 24), fonte=FONTE_M, bg=TEMA["painel"],
               cor=TEMA["txt"] if r["casa"] != self.meu else cr,
               width=24, anchor="e").pack(side="left")
        rotulo(linha, "  %d x %d  " % (r["gc"], r["gf"]), fonte=(FONTE[0], 26, "bold"),
               cor=cr, bg=TEMA["painel"]).pack(side="left")
        rotulo(linha, corta(fora["nome"], 24), fonte=FONTE_M, bg=TEMA["painel"],
               cor=TEMA["txt"] if r["fora"] != self.meu else cr,
               width=24, anchor="w").pack(side="left")
        sub = "%s  .  publico %s  .  renda %s" % (
            "voce jogou em casa" if self.em_casa else "voce jogou fora",
            ("{:,}".format(r.get("pub", 0)).replace(",", ".") if r.get("pub") else "portoes fechados"),
            din(r.get("renda", 0)))
        rotulo(topo, sub, cor=TEMA["fraco"], fonte=FONTE_P,
               bg=TEMA["painel"]).pack(anchor="center", pady=(0, 10))

        corpo = tk.Frame(self.corpo, bg=TEMA["fundo"])
        corpo.pack(fill="both", expand=True, pady=(10, 0))

        esq = tk.Frame(corpo, bg=TEMA["fundo"])
        esq.pack(side="left", fill="both", expand=True, padx=(0, 8))
        self._estatisticas(esq, casa, fora)
        self._eventos(esq, casa, fora)

        dirf = tk.Frame(corpo, bg=TEMA["fundo"], width=380)
        dirf.pack(side="right", fill="both")
        dirf.pack_propagate(False)
        self._notas(dirf)

        pe = tk.Frame(self.corpo, bg=TEMA["fundo"])
        pe.pack(fill="x", pady=(10, 0))
        botao(pe, "Fechar", self.destroy, cor=TEMA["acao"]).pack(side="right")
        rotulo(pe, "nota 6.0 e jogo correto; gol vale +1.0 e assistencia +0.5",
               cor=TEMA["fraco"], fonte=FONTE_P).pack(side="left")

    # ------------------------------------------------------------ estatisticas
    def _estatisticas(self, pai, casa, fora):
        st = self.r.get("stats")
        bloco_st = bloco(pai, "COMO FOI O JOGO")
        if not st:
            rotulo(bloco_st, "Partida antiga, sem estatisticas guardadas.",
                   cor=TEMA["fraco"], bg=TEMA["painel"]).pack(anchor="w")
            return
        linhas = [("Posse de bola", st["posse"][0], st["posse"][1], "%d%%"),
                  ("Finalizacoes", st["chutes"][0], st["chutes"][1], "%d"),
                  ("No gol", st["no_gol"][0], st["no_gol"][1], "%d"),
                  ("Defesas do goleiro", st["defesas"][0], st["defesas"][1], "%d"),
                  ("Escanteios", st["escanteios"][0], st["escanteios"][1], "%d"),
                  ("Faltas", st["faltas"][0], st["faltas"][1], "%d")]
        for nome, a, b, fmt in linhas:
            f = tk.Frame(bloco_st, bg=TEMA["painel"])
            f.pack(fill="x", pady=1)
            rotulo(f, fmt % a, bg=TEMA["painel"], width=5, anchor="e",
                   fonte=FONTE_B, cor=TEMA["ok"] if a > b else TEMA["txt"]).pack(side="left")
            meio = tk.Frame(f, bg=TEMA["painel"])
            meio.pack(side="left", fill="x", expand=True, padx=8)
            rotulo(meio, nome, cor=TEMA["fraco"], fonte=FONTE_P,
                   bg=TEMA["painel"]).pack(anchor="center")
            barra = tk.Canvas(meio, height=6, bg=TEMA["linha"], highlightthickness=0)
            barra.pack(fill="x")
            total = max(1, a + b)
            barra.bind("<Configure>", lambda e, bb=barra, aa=a, tt=total:
                       (bb.delete("all"),
                        bb.create_rectangle(0, 0, int(bb.winfo_width() * aa / tt), 6,
                                            fill=TEMA["acao"], width=0)))
            rotulo(f, fmt % b, bg=TEMA["painel"], width=5, anchor="w",
                   fonte=FONTE_B, cor=TEMA["ok"] if b > a else TEMA["txt"]).pack(side="left")

    # ---------------------------------------------------------------- eventos
    def _eventos(self, pai, casa, fora):
        G = self.G
        b = bloco(pai, "MINUTO A MINUTO")
        cx = tk.Text(b, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO, relief="flat",
                     wrap="word", padx=4, pady=2, height=13, highlightthickness=0)
        sb = ttk.Scrollbar(b, orient="vertical", command=cx.yview)
        cx.configure(yscrollcommand=sb.set)
        cx.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        for nome, token in (("ok", "ok"), ("ruim", "ruim"), ("av", "av"),
                            ("fraco", "fraco"), ("top", "top")):
            cx.tag_configure(nome, foreground=TEMA[token])
        eventos = self.r.get("eventos") or []
        if not eventos:
            cx.insert("end", "Jogo sem lance digno de nota.", "fraco")
        for minuto, lado, tipo, pid, extra in eventos:
            j = G["jogadores"].get(pid)
            clube = casa if lado == 0 else fora
            meu_lado = (clube["id"] == self.meu)
            marca = self.ICONE.get(tipo, "   ")
            if tipo == "gol":
                quem = j["nome"] if j else "contra"
                passe = G["jogadores"].get(extra)
                texto = "%s  %s" % (quem, ("(assist. %s)" % passe["nome"]) if passe else "")
                tag = "ok" if meu_lado else "ruim"
            elif tipo == "substituicao":
                sai = G["jogadores"].get(extra)
                texto = "entra %s, sai %s" % (j["nome"] if j else "?",
                                              sai["nome"] if sai else "?")
                tag = "fraco"
            elif tipo == "lesao":
                texto = "%s se machucou" % (j["nome"] if j else "?")
                tag = "ruim" if meu_lado else "fraco"
            elif tipo == "vermelho":
                texto = "%s expulso" % (j["nome"] if j else "?")
                tag = "ruim" if meu_lado else "ok"
            else:
                texto = "%s amarelo" % (j["nome"] if j else "?")
                tag = "av" if meu_lado else "fraco"
            cx.insert("end", "%2d'  %s  %-10s %s\n"
                      % (minuto, marca, corta(clube["nome"], 10), texto), tag)
        cx.configure(state="disabled")

    # ------------------------------------------------------------------ notas
    def _notas(self, pai):
        G = self.G
        b = bloco(pai, "COMO CADA UM FOI")
        notas = self.r.get("notas") or {}
        xi = (self.r.get("xi") or {}).get("casa" if self.em_casa else "fora") or {}
        if not notas:
            rotulo(b, "Partida antiga, sem notas guardadas.", cor=TEMA["fraco"],
                   bg=TEMA["painel"]).pack(anchor="w")
            return
        q, tv = grade(b, [("vaga", "Vaga", 55, "center"), ("nome", "Jogador", 150, "w"),
                          ("g", "G", 30, "center"), ("a", "A", 30, "center"),
                          ("nota", "Nota", 50, "center")], altura=15)
        q.pack(fill="both", expand=True)
        gols = collections_contador(self.r, "gol")
        assist = collections_contador(self.r, "assist")
        ordem = sorted(xi.items(), key=lambda kv: -notas.get(kv[0], 0))
        for pid, vaga in ordem:
            j = G["jogadores"].get(pid)
            if not j:
                continue
            nota = notas.get(pid, 6.0)
            tag = "top" if nota >= 8 else ("bom" if nota >= 7 else
                                           ("ruim" if nota < 5.5 else ""))
            tv.insert("", "end", iid=str(pid),
                      values=(vaga, corta(j["nome"], 18), gols.get(pid, "") or "",
                              assist.get(pid, "") or "", "%.1f" % nota), tags=(tag,))
        melhor = max(ordem, key=lambda kv: notas.get(kv[0], 0), default=None)
        if melhor:
            j = G["jogadores"].get(melhor[0])
            rotulo(b, "Melhor em campo: %s  (%.1f)" % (j["nome"] if j else "?",
                                                       notas.get(melhor[0], 0)),
                   cor=TEMA["top"], fonte=FONTE_B, bg=TEMA["painel"]).pack(anchor="w",
                                                                           pady=(6, 0))


def collections_contador(r, qual):
    """Gols (ou assistencias) por jogador nesta partida."""
    out = {}
    for _m, _l, tipo, pid, extra in r.get("eventos") or []:
        if tipo != "gol":
            continue
        alvo = pid if qual == "gol" else extra
        if alvo:
            out[alvo] = out.get(alvo, 0) + 1
    return out


class Avancar(Dialogo):
    """Painel de avanco: escolhe o tamanho do pulo e mostra a simulacao rodando.

    A semana do jogo E uma rodada - o calendario tem 38 semanas e 38 rodadas.
    Entao "1 rodada", "1 mes" e "3 meses" sao a mesma unidade em tamanhos
    diferentes, e o painel diz isso em vez de deixar a duvida no ar.

    O laco processa uma semana, redesenha e repete: sem isso a janela congelaria
    por dez segundos e o Windows a marcaria como travada.
    """

    def __init__(self, pai, app):
        super().__init__(pai, "Avancar", 720, 620, redimensionavel=True)
        self.app, self.G = app, app.G
        self.rodando = False
        self.parar = False
        G = self.G

        rotulo(self.corpo, "Avancar a simulacao", fonte=FONTE_T).pack(anchor="w")
        rotulo(self.corpo, self._onde_estamos(), cor=TEMA["fraco"]).pack(anchor="w", pady=(0, 8))

        b = bloco(self.corpo, "QUANTO PULAR")
        self.escolha = tk.StringVar(value="1")
        self.opcoes = self._opcoes()
        for chave, texto, quantas, nota in self.opcoes:
            linha = tk.Frame(b, bg=TEMA["painel"])
            linha.pack(fill="x", pady=1)
            rb = ttk.Radiobutton(linha, text=texto, value=chave, variable=self.escolha,
                                 style="TRadiobutton")
            rb.pack(side="left")
            if quantas <= 0:
                rb.state(["disabled"])
            rotulo(linha, "   " + nota, cor=TEMA["fraco"], fonte=FONTE_P,
                   bg=TEMA["painel"]).pack(side="left")

        b2 = bloco(self.corpo, "PARAR ANTES SE")
        rotulo(b2, "Fim de estadual e fim de temporada param sempre.", cor=TEMA["fraco"],
               fonte=FONTE_P, bg=TEMA["painel"]).pack(anchor="w", pady=(0, 4))
        self.paradas = {}
        for chave, texto, padrao in (
                ("lesao", "alguem do time titular se machucar", True),
                ("janela", "a janela de transferencias abrir", True),
                ("proposta", "chegar proposta por um jogador seu", False),
                ("quebrado", "o time ficar sem condicao de entrar em campo", True)):
            var = tk.BooleanVar(value=padrao)
            self.paradas[chave] = var
            ttk.Checkbutton(b2, text=texto, variable=var,
                            style="TCheckbutton").pack(anchor="w")

        acoes = tk.Frame(self.corpo, bg=TEMA["fundo"])
        acoes.pack(fill="x", pady=8)
        self.bt_ir = botao(acoes, "Avancar", self.rodar, cor=TEMA["acao"])
        self.bt_ir.pack(side="left")
        self.bt_parar = botao(acoes, "Parar", self.pedir_parada)
        self.bt_parar.pack(side="left", padx=6)
        self.bt_parar.configure(state="disabled")
        botao(acoes, "Fechar", self.destroy).pack(side="right")

        self.barra = ttk.Progressbar(self.corpo, orient="horizontal", mode="determinate",
                                     style="Horizontal.TProgressbar")
        self.barra.pack(fill="x", pady=(0, 6))
        self.lb_passo = rotulo(self.corpo, "", cor=TEMA["fraco"], fonte=FONTE_P)
        self.lb_passo.pack(anchor="w")

        quadro = tk.Frame(self.corpo, bg=TEMA["painel"])
        quadro.pack(fill="both", expand=True, pady=(6, 0))
        self.log = tk.Text(quadro, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO, relief="flat",
                           wrap="word", padx=12, pady=8, highlightthickness=0, state="disabled")
        sb = ttk.Scrollbar(quadro, orient="vertical", command=self.log.yview)
        self.log.configure(yscrollcommand=sb.set)
        self.log.pack(side="left", fill="both", expand=True)
        sb.pack(side="right", fill="y")
        for nome, token in (("ok", "ok"), ("ruim", "ruim"), ("av", "av"),
                            ("fraco", "fraco"), ("top", "top")):
            self.log.tag_configure(nome, foreground=TEMA[token])
        self.log.tag_configure("forte", font=(MONO[0], MONO[1], "bold"))

    # ------------------------------------------------------------------ leitura
    def _onde_estamos(self):
        G = self.G
        c = G["clubes"][G["clube"]]
        if G["fase"] == "estadual":
            est = eng.meu_estadual(G)
            total = eng.rodadas_estaduais(G)
            return ("%s  .  rodada %d de %d  .  temporada %d"
                    % (est["nome"] if est else "Pre-temporada",
                       int(G.get("semana_est", 1)), total, G["temporada"]))
        if G["fase"] == "entretemporada":
            return "Pre-temporada %d  .  o ano comeca pelo estadual" % G["temporada"]
        liga = G["ligas"][c["divisao"]]
        return ("Brasileirao Serie %s  .  rodada %d de %d  .  1 semana = 1 rodada"
                % (c["divisao"], liga["rodada"] + 1, len(liga["rodadas"])))

    def _opcoes(self):
        """(chave, texto, quantas semanas, nota). quantas<=0 desativa a opcao."""
        G = self.G
        if G["fase"] == "entretemporada":
            return [("1", "Comecar o ano", 1, "abre o estadual e joga a primeira rodada")]
        if G["fase"] == "estadual":
            faltam = max(0, eng.rodadas_estaduais(G) - int(G.get("semana_est", 1)) + 1)
            return [("1", "1 rodada", 1, "uma rodada do estadual"),
                    ("4", "1 mes (4 rodadas)", min(4, faltam), "quatro rodadas"),
                    ("est", "ate o fim do estadual", faltam,
                     "%d rodada(s) ate o Brasileirao" % faltam)]
        c = G["clubes"][G["clube"]]
        liga = G["ligas"][c["divisao"]]
        faltam = max(0, len(liga["rodadas"]) - liga["rodada"])
        ate_janela = eng.proxima_janela(G)
        meia = max(0, min(faltam, 19 - liga["rodada"]))
        return [
            ("1", "1 rodada", 1, "uma semana, um jogo de liga"),
            ("4", "1 mes (4 rodadas)", min(4, faltam), "quatro semanas"),
            ("12", "3 meses (12 rodadas)", min(12, faltam), "doze semanas"),
            ("janela", "ate a proxima janela", ate_janela,
             "janela ja aberta" if ate_janela <= 0 else "%d semana(s)" % ate_janela),
            ("meia", "ate o fim do turno", meia,
             "chega na rodada 19" if meia > 0 else "o turno ja acabou"),
            ("fim", "temporada toda", faltam, "as %d rodadas que faltam" % faltam),
        ]

    def _quantas(self):
        chave = self.escolha.get()
        for c, _t, q, _n in self.opcoes:
            if c == chave:
                return max(0, q)
        return 1

    # ------------------------------------------------------------------- laco
    def fala(self, txt, tag="fraco"):
        self.log.configure(state="normal")
        self.log.insert("end", txt + "\n", tag)
        self.log.see("end")
        self.log.configure(state="disabled")

    def pedir_parada(self):
        self.parar = True
        self.lb_passo.configure(text="parando no fim desta semana...")

    def rodar(self):
        if self.rodando:
            return
        total = self._quantas()
        if total <= 0:
            messagebox.showinfo("BRASFUT", "Nao ha semanas a avancar nesta opcao.")
            return
        self.rodando, self.parar = True, False
        self.bt_ir.configure(state="disabled")
        self.bt_parar.configure(state="normal")
        self.barra.configure(maximum=total, value=0)
        G = self.G
        temp_ini, fase_ini = G["temporada"], G["fase"]
        feitas, motivo = 0, ""
        for i in range(total):
            if self.parar:
                motivo = "voce mandou parar"
                break
            antes = self._foto()
            try:
                ok, _txt = capturar(eng.jogar_semana, G)
            except Exception as e:
                self.fala("Erro ao avancar: %s" % e, "ruim")
                break
            feitas += 1
            self.barra.configure(value=feitas)
            self._contar_semana(antes)
            self.lb_passo.configure(text="%d de %d" % (feitas, total))
            self.update()
            if ok is False:
                motivo = "carreira encerrada"
                break
            if G["temporada"] != temp_ini:
                motivo = "a temporada acabou"
                break
            if fase_ini == "estadual" and G["fase"] != "estadual":
                motivo = "o estadual acabou"
                break
            motivo = self._motivo_de_parar(antes)
            if motivo:
                break
        self.rodando = False
        self.bt_parar.configure(state="disabled")
        self.bt_ir.configure(state="normal")
        self.bt_ir.configure(text="Avancar mais")
        self.opcoes = self._opcoes()
        if motivo:
            self.fala("\nParou: %s." % motivo, "av")
        self.lb_passo.configure(text="%d semana(s) avancada(s)" % feitas)
        self.resultado = feitas
        self.app.atualizar_topo()

    def _foto(self):
        """O que precisa ser comparado depois da semana para saber o que mudou."""
        G = self.G
        c = G["clubes"][G["clube"]]
        return {
            "janela": eng.mercado_aberto(G),
            "lesionados": {p for p in c["elenco"] if G["jogadores"][p]["lesao"] > 0},
            "titulares": set(c.get("escalacao", [])),
            "propostas": len(eng.propostas_recebidas(G)),
            "caixa": c["dinheiro"],
        }

    def _contar_semana(self, antes):
        """Uma linha por jogo, do jeito que o painel conta."""
        G = self.G
        c = G["clubes"][G["clube"]]
        if G["fase"] == "estadual":
            cabeca = "Estadual, rodada %d" % max(1, int(G.get("semana_est", 1)) - 1)
        elif G["fase"] == "entretemporada":
            cabeca = "Temporada %d encerrada" % (G["temporada"] - 1)
        else:
            cabeca = "Semana %02d" % max(1, G["semana"] - 1)
        jogos = eng.resultados_da_semana(G)
        if not jogos:
            self.fala("%s  -  sem jogo" % cabeca, "fraco")
        for r in jogos:
            em_casa = r["casa"] == c["id"]
            gm, gs = (r["gc"], r["gf"]) if em_casa else (r["gf"], r["gc"])
            adv = G["clubes"].get(r["fora"] if em_casa else r["casa"])
            tag = "ok" if gm > gs else ("av" if gm == gs else "ruim")
            self.fala("%s   %d x %d   %s (%s)"
                      % (cabeca, gm, gs, corta(adv["nome"] if adv else "-", 22),
                         "casa" if em_casa else "fora"), tag)
        novas = eng.propostas_recebidas(G)
        if len(novas) > antes["propostas"]:
            self.fala("   %d proposta(s) na mesa" % len(novas), "av")
        machucados = [p for p in c["elenco"]
                      if G["jogadores"][p]["lesao"] > 0 and p not in antes["lesionados"]]
        for p in machucados:
            j = G["jogadores"][p]
            self.fala("   lesao: %s, %d semana(s) fora" % (j["nome"], j["lesao"]), "ruim")

    def _motivo_de_parar(self, antes):
        G = self.G
        c = G["clubes"][G["clube"]]
        if self.paradas["janela"].get() and eng.mercado_aberto(G) and not antes["janela"]:
            return "a janela de transferencias abriu"
        if self.paradas["proposta"].get():
            if len(eng.propostas_recebidas(G)) > antes["propostas"]:
                return "chegou proposta por um jogador seu"
        if self.paradas["lesao"].get():
            novos = [p for p in c["elenco"] if G["jogadores"][p]["lesao"] > 0
                     and p not in antes["lesionados"] and p in antes["titulares"]]
            if novos:
                return "%s se machucou" % G["jogadores"][novos[0]]["nome"]
        if self.paradas["quebrado"].get():
            d = eng.diagnostico_escalacao(G)
            if d and d["estado"] == "critico":
                return "o time nao tem condicao de entrar em campo"
        return ""


class ResumoTemporada(Dialogo):
    """O fim do ano em uma tela: onde terminou, o que ganhou, quanto sobrou.

    Isto existia so como parede de texto no console do modo linha, que a janela
    nem mostra - a temporada virava sem o jogador perceber que virou.
    """

    def __init__(self, pai, G, r):
        super().__init__(pai, "Temporada %d encerrada" % r["temporada"], 880, 680,
                         redimensionavel=True)
        self.G, self.r = G, r
        cam, fin = r["campanha"], r["financas"]
        saldo = fin["caixa_fim"] - fin["caixa_ini"]

        rotulo(self.corpo, "TEMPORADA %d ENCERRADA" % r["temporada"],
               fonte=(FONTE[0], 19, "bold")).pack(anchor="w")
        rotulo(self.corpo, "%s  .  Serie %s  .  %do lugar de %d  .  meta era top %d"
               % (r["clube"], r["divisao"], r["posicao"], r["total"], r["alvo"]),
               cor=TEMA["fraco"]).pack(anchor="w", pady=(0, 8))

        for texto, estado in self._vereditos():
            cr = cor_estado(estado)
            faixa = tk.Frame(self.corpo, bg=TEMA["painel"])
            faixa.pack(fill="x", pady=2)
            tk.Frame(faixa, bg=cr, width=4).pack(side="left", fill="y")
            rotulo(faixa, texto, cor=cr, fonte=FONTE_M,
                   bg=TEMA["painel"]).pack(side="left", padx=12, pady=7)

        tiles = tk.Frame(self.corpo, bg=TEMA["fundo"])
        tiles.pack(fill="x", pady=(10, 4))
        dados = [
            ("POSICAO", "%do" % r["posicao"], "de %d na Serie %s" % (r["total"], r["divisao"]),
             "ok" if r["objetivo_ok"] else "atencao"),
            ("CAMPANHA", "%d pts" % cam["p"], "%dV %dE %dD em %d jogos"
             % (cam["v"], cam["e"], cam["d"], cam["j"]), "neutro"),
            ("TITULOS", str(len(r["titulos"])),
             ", ".join(r["titulos"]) if r["titulos"] else "nenhum nesta temporada",
             "ok" if r["titulos"] else "neutro"),
            ("CAIXA NO ANO", ("+" if saldo >= 0 else "") + din(saldo),
             "%s no fim" % din(fin["caixa_fim"]), "ok" if saldo >= 0 else "critico"),
        ]
        for i, (titulo_t, valor, sub, estado) in enumerate(dados):
            cx = tk.Frame(tiles, bg=TEMA["painel"], padx=12, pady=9)
            cx.grid(row=0, column=i, sticky="nsew", padx=(0, 8))
            rotulo(cx, titulo_t, cor=TEMA["fraco"], fonte=FONTE_PB,
                   bg=TEMA["painel"]).pack(anchor="w")
            rotulo(cx, valor, cor=cor_estado(estado), fonte=FONTE_N,
                   bg=TEMA["painel"]).pack(anchor="w")
            rotulo(cx, corta(sub, 34), cor=TEMA["fraco"], fonte=FONTE_P,
                   bg=TEMA["painel"]).pack(anchor="w")
        for k in range(len(dados)):
            tiles.columnconfigure(k, weight=1, uniform="tile")

        quadro = tk.Frame(self.corpo, bg=TEMA["painel"])
        quadro.pack(fill="both", expand=True, pady=(8, 0))
        cx = tk.Text(quadro, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO, relief="flat",
                     wrap="word", padx=14, pady=10, highlightthickness=0)
        barra = ttk.Scrollbar(quadro, orient="vertical", command=cx.yview)
        cx.configure(yscrollcommand=barra.set)
        cx.pack(side="left", fill="both", expand=True)
        barra.pack(side="right", fill="y")
        cx.tag_configure("titulo", foreground=TEMA["fraco"], font=FONTE_PB, spacing1=8)
        for nome, token in (("ok", "ok"), ("ruim", "ruim"), ("av", "av"),
                            ("fraco", "fraco"), ("top", "top")):
            cx.tag_configure(nome, foreground=TEMA[token])
        self._corpo_do_resumo(cx)
        cx.configure(state="disabled")

        pe = tk.Frame(self.corpo, bg=TEMA["fundo"])
        pe.pack(fill="x", pady=(10, 0))
        botao(pe, "Comecar a pre-temporada %d" % G["temporada"], self.destroy,
              cor=TEMA["acao"]).pack(side="right")
        rotulo(pe, "o mercado ja esta aberto e a temporada so comeca quando voce mandar",
               cor=TEMA["fraco"], fonte=FONTE_P).pack(side="left")

    def _vereditos(self):
        """Ordem: o que muda a vida do clube primeiro."""
        r = self.r
        out = []
        if r["titulos"]:
            out.append(("CAMPEAO: " + ", ".join(r["titulos"]), "ok"))
        if r["movimento"]:
            tipo, de, para = r["movimento"]
            out.append(("ACESSO: o clube sobe da Serie %s para a Serie %s" % (de, para), "ok")
                       if tipo == "acesso" else
                       ("REBAIXAMENTO: o clube cai da Serie %s para a Serie %s" % (de, para),
                        "critico"))
        out.append(("Objetivo cumprido" if r["objetivo_ok"] else "Objetivo nao cumprido",
                    "ok" if r["objetivo_ok"] else "atencao"))
        out.append((r["diretoria"], "ok" if r["diretoria_ok"] else "critico"))
        return out

    def _corpo_do_resumo(self, cx):
        r, fin = self.r, self.r["financas"]

        def secao(nome):
            cx.insert("end", "\n" + nome + "\n", "titulo")

        def item(texto, tag="fraco"):
            cx.insert("end", "  " + texto + "\n", tag)

        secao("COMO TERMINOU O BRASILEIRAO")
        item("Campeao da Serie %s: %s" % (r["divisao"], r["campeao"]), "top")
        for nome, dono in r["copas"]:
            item("%s: %s" % (nome, dono))

        secao("OS SEUS DESTAQUES")
        if r["artilheiro"]:
            item("Artilheiro: %s, %d gol(s) em %d jogo(s)" % tuple(r["artilheiro"]), "ok")
        if r["garcom"]:
            item("Mais assistencias: %s, %d em %d jogo(s)" % tuple(r["garcom"]), "ok")
        if r["destaques"]:
            cx.insert("end", "  %-24s %-5s %4s %4s %4s\n"
                      % ("JOGADOR", "POS", "J", "G", "A"), "fraco")
            for nome, pos, j, g, a in r["destaques"]:
                item("%-24s %-5s %4d %4d %4d" % (corta(nome, 24), pos, j, g, a), "")
        if not r["artilheiro"] and not r["destaques"]:
            item("Ninguem marcou nesta temporada.")

        secao("DINHEIRO NO ANO")
        item("Caixa: %s no comeco, %s no fim" % (din(fin["caixa_ini"]), din(fin["caixa_fim"])))
        item("Entrou: %s de receita, %s de bilheteria, %s de premiacao"
             % (din(fin["receita"]), din(fin["renda_jogos"]), din(fin["premios"])))
        item("Saiu: %s entre folha, estrutura e treino" % din(fin["gasto"]))
        item("Vendas: %s em %d negocio(s)   Compras: %s em %d negocio(s)"
             % (din(fin["vendido"]), len(r["vendas"]), din(fin["comprado"]),
                len(r["compras"])))

        if r["vendas"] or r["compras"]:
            secao("MERCADO")
            for nome, clube, valor in r["vendas"]:
                item("vendeu %s ao %s por %s" % (nome, clube, din(valor)), "ok")
            for nome, clube, valor in r["compras"]:
                item("comprou %s do %s por %s" % (nome, clube, din(valor)), "av")

        secao("QUEM CRESCEU")
        if r["evolucao"]:
            for nome, d, ovr in r["evolucao"]:
                item("%-24s +%d de overall, chegou a %d" % (corta(nome, 24), d, ovr), "ok")
        else:
            item("Ninguem evoluiu de forma relevante. Olhe o regime de treino.")

        if r["tetos"]:
            secao("TETO REVISADO")
            item("O teto e previsao, e a previsao se corrige com o que aconteceu em campo.")
            for nome, d, pot in r["tetos"]:
                item("%-24s %+d, agora %d" % (corta(nome, 24), d, pot),
                     "ok" if d > 0 else "ruim")

        secao("BASE")
        if r["safra"]:
            for nome, pos, idade, ovr in r["safra"]:
                item("safra nova: %s (%s, %d anos, overall %d)" % (nome, pos, idade, ovr), "ok")
        else:
            item("A academia nao formou ninguem: suba o nivel da base na Infraestrutura.")
        for nome in r["base_subiu"]:
            item("%s completou a idade e subiu ao profissional" % nome, "ok")
        for nome in r["base_saiu"]:
            item("%s passou da idade sem nivel e foi liberado" % nome, "av")

        if r["voltando"] or r["saindo"] or r["aposentados"] or r["fim_contrato"]:
            secao("MEXIDAS NO ELENCO")
            if r["voltando"]:
                item("voltam do emprestimo: " + ", ".join(r["voltando"]))
            if r["saindo"]:
                item("fim do emprestimo, voltam aos donos: " + ", ".join(r["saindo"]), "av")
            if r["aposentados"]:
                item("pararam de jogar: " + ", ".join(r["aposentados"]), "av")
            if r["fim_contrato"]:
                item("CONTRATO VENCIDO, saem de graca se voce nao renovar na pre-temporada:",
                     "ruim")
                item(", ".join(r["fim_contrato"]), "ruim")


class Negociar(Dialogo):
    """Mesa de compra em uma tela: passe, duracao e salario ao mesmo tempo.

    Nao decide nada. A cada mexida pergunta ao motor como a proposta esta sendo
    lida (a leitura no pe de cada regua) e, no clique, manda o pacote inteiro.
    Antes eram tres perguntas em fila, cada uma num Entry vazio, sem dizer o
    que o outro lado achava enquanto voce digitava.
    """

    def __init__(self, pai, G, j):
        super().__init__(pai, "Negociar " + j["nome"], 640, 700, redimensionavel=True)
        self.G, self.j = G, j
        self.c = G["clubes"][G["clube"]]
        self.livre = j["clube"] is None
        self.rodada = 0
        self.anos = 3
        self.pedido, intocavel = (0, False) if self.livre else eng.pedido_efetivo(G, j)
        self.exig = eng.exigencia_salarial(G, j, self.c, self.anos)
        vendedor = G["clubes"][j["clube"]]["nome"] if j["clube"] else "sem clube"

        rotulo(self.corpo, j["nome"], fonte=FONTE_T).pack(anchor="w")
        rotulo(self.corpo, "%s, %d anos, overall %d, teto %s  |  %s"
               % (eng.NOME_POS[j["pos"]], j["idade"], j["ovr"], eng.scout(G, j), vendedor),
               cor=TEMA["fraco"]).pack(anchor="w")
        imp = eng.importancia(G, j)
        peso = "reserva" if imp < 0.3 else ("titular" if imp < 0.7 else "peca central do time")
        rotulo(self.corpo, "%s   |   seu caixa: %s   |   contrato dele: %d ano(s)"
               % ("Agente livre" if self.livre else "No clube atual ele e " + peso,
                  din(self.c["dinheiro"]), j["contrato"]),
               cor=TEMA["fraco"]).pack(anchor="w")
        aberta = eng.mercado_aberto(G)
        rotulo(self.corpo, eng.recado_janela(G), cor=TEMA["ok"] if aberta else TEMA["av"],
               fonte=FONTE_P).pack(anchor="w", pady=(0, 6))

        if self.livre:
            b = bloco(self.corpo, "PASSE")
            rotulo(b, "Agente livre: nao ha passe a pagar, so acertar contrato.",
                   cor=TEMA["ok"], bg=TEMA["painel"]).pack(anchor="w")
            self.r_passe = None
            self.lb_caixa = None
        else:
            b = bloco(self.corpo, "PASSE" + ("   -   ELE NAO ESTA A VENDA" if intocavel else ""))
            rotulo(b, "O %s libera a partir de %s." % (vendedor, din(self.pedido)),
                   cor=TEMA["av"], bg=TEMA["painel"]).pack(anchor="w", pady=(0, 6))
            self.r_passe = Regua(b, "Oferta pelo passe", self.pedido,
                                 maximo=max(int(self.pedido * 2), int(self.c["dinheiro"]), 10000),
                                 bg=TEMA["painel"], ao_mudar=lambda v: self.reler(),
                                 atalhos=[("- 10%", lambda: int(self.pedido * 0.90)),
                                          ("- 5%", lambda: int(self.pedido * 0.95)),
                                          ("pedido", lambda: self.pedido),
                                          ("+ 5%", lambda: int(self.pedido * 1.05)),
                                          ("meu caixa", lambda: int(self.c["dinheiro"]))])
            self.r_passe.pack(fill="x")
            self.lb_caixa = rotulo(b, "", cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["painel"])
            self.lb_caixa.pack(anchor="w", pady=(4, 0))

        b2 = bloco(self.corpo, "CONTRATO")
        fa = tk.Frame(b2, bg=TEMA["painel"])
        fa.pack(fill="x")
        rotulo(fa, "Anos de contrato", fonte=FONTE_B, bg=TEMA["painel"]).pack(side="left")
        self.bt_anos = {}
        for n in range(1, 6):
            bt = botao_mini(fa, "  %d  " % n, lambda k=n: self.mudar_anos(k))
            bt.pack(side="left", padx=2)
            self.bt_anos[n] = bt
        self.r_sal = Regua(b2, "Salario mensal oferecido", self.exig,
                           maximo=max(self.exig * 2, j["salario"] * 3, 10000),
                           bg=TEMA["painel"], ao_mudar=lambda v: self.reler(),
                           atalhos=[("- 10%", lambda: int(self.exig * 0.90)),
                                    ("- 5%", lambda: int(self.exig * 0.95)),
                                    ("o que ele pede", lambda: self.exig),
                                    ("+ 10%", lambda: int(self.exig * 1.10))])
        self.r_sal.pack(fill="x", pady=(8, 0))
        self.lb_sal = rotulo(b2, "", cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["painel"])
        self.lb_sal.pack(anchor="w", pady=(4, 0))

        acoes = tk.Frame(self.corpo, bg=TEMA["fundo"])
        acoes.pack(fill="x", pady=8)
        botao(acoes, "Enviar proposta", self.enviar, cor=TEMA["acao"]).pack(side="left")
        botao(acoes, "Desistir", self.destroy).pack(side="left", padx=6)
        self.lb_rodada = rotulo(acoes, "tentativa 1 de 3", cor=TEMA["fraco"], fonte=FONTE_P)
        self.lb_rodada.pack(side="right")

        self.dialogo = tk.Text(self.corpo, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO,
                               relief="flat", wrap="word", padx=10, pady=8, height=6,
                               state="disabled")
        self.dialogo.pack(fill="both", expand=True)
        self.mudar_anos(3)

    def fala(self, txt):
        self.dialogo.configure(state="normal")
        self.dialogo.insert("end", txt + "\n")
        self.dialogo.see("end")
        self.dialogo.configure(state="disabled")

    def mudar_anos(self, n):
        """Duracao mexe no que o jogador pede: contrato curto sai mais caro."""
        self.anos = n
        for k, bt in self.bt_anos.items():
            bt.configure(bg=TEMA["acao"] if k == n else TEMA["linha"],
                         fg="white" if k == n else TEMA["fraco"])
        self.exig = eng.exigencia_salarial(self.G, self.j, self.c, n)
        self.reler()

    def reler(self):
        """Semaforo ao vivo: como as duas pontas estao lendo a proposta agora."""
        if self.r_passe is not None:
            v = self.r_passe.valor()
            recado, estado = eng.leitura_oferta(v, self.pedido)
            self.r_passe.leitura("%d%% do pedido  -  %s"
                                 % (round(100.0 * v / max(1, self.pedido)), recado),
                                 cor_estado(estado))
            sobra = self.c["dinheiro"] - v
            self.lb_caixa.configure(text="Caixa depois de pagar o passe: %s" % din(sobra),
                                    fg=TEMA["ruim"] if sobra < 0 else TEMA["fraco"])
        s = self.r_sal.valor()
        recado, estado = eng.leitura_oferta(s, self.exig)
        self.r_sal.leitura("ele pede %s  -  %s" % (din(self.exig), recado), cor_estado(estado))
        folha = eng.folha_semanal(self.G, self.c)
        self.lb_sal.configure(text="Folha semanal: %s  ->  %s   com %d ano(s) de contrato"
                              % (din(folha), din(folha + int(s / 4.0)), self.anos))

    def encerra(self, texto):
        self.resultado = texto
        self.fala(texto)
        self.after(1100, self.destroy)

    def _insistir(self, r, recado_final):
        if r.encerrada:
            self.encerra("Negociacao por %s encerrada." % self.j["nome"])
            return
        self.rodada += 1
        if self.rodada >= 3:
            self.encerra(recado_final)
            return
        self.lb_rodada.configure(text="tentativa %d de 3" % (self.rodada + 1))

    def enviar(self):
        passe = self.r_passe.valor() if self.r_passe is not None else 0
        if passe > self.c["dinheiro"]:
            messagebox.showwarning("BRASFUT", "Voce nao tem %s em caixa." % din(passe))
            return
        prop = eng.Proposta(jogador=self.j["id"], comprador=self.c["id"], valor=passe,
                            salario=self.r_sal.valor(), anos=self.anos)
        r = eng.avaliar_clube(self.G, prop)
        if not r.aceita:
            self.fala("PASSE: " + r.motivo)
            self._insistir(r, "Sem acordo pelo passe de %s." % self.j["nome"])
            return
        if self.r_passe is not None:
            self.fala("PASSE: " + r.motivo)
        rj = eng.avaliar_jogador(self.G, prop)
        if rj.aceita:
            self.encerra(eng.fechar_compra(self.G, prop))
            return
        self.fala("SALARIO: " + rj.motivo)
        self.exig = rj.pedido
        self.reler()
        self._insistir(rj, "%s nao chegou a um acordo salarial." % self.j["nome"])


class PegarEmprestado(Dialogo):
    """Mesa de emprestimo: aqui se compra fatia de salario, nao passe."""

    def __init__(self, pai, G, j):
