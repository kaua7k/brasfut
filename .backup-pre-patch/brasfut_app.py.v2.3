    def _mercado_busca(self, pai, aba, aberto):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        emprestimo = aba == "emprestimo"
        livres = aba == "livres"

        filtros = tk.Frame(pai, bg=TEMA["fundo"])
        filtros.pack(fill="x", padx=18, pady=(0, 8))
        rotulo(filtros, "Posicao").pack(side="left")
        cb_pos = ttk.Combobox(filtros, values=["Todas"] + eng.POS, width=7, state="readonly")
        cb_pos.set("Todas")
        cb_pos.pack(side="left", padx=6)
        rotulo(filtros, "Ovr min").pack(side="left", padx=(10, 0))
        e_ovr = tk.Entry(filtros, width=5, bg=TEMA["painel"], fg=TEMA["txt"], relief="flat",
                         insertbackground=TEMA["txt"], justify="center")
        e_ovr.pack(side="left", padx=6)
        rotulo(filtros, "Idade max").pack(side="left", padx=(10, 0))
        e_idade = tk.Entry(filtros, width=5, bg=TEMA["painel"], fg=TEMA["txt"], relief="flat",
                           insertbackground=TEMA["txt"], justify="center")
        e_idade.pack(side="left", padx=6)
        campo_teto = None
        if not livres:
            rotulo(filtros, "Pedido ate").pack(side="left", padx=(10, 0))
            campo_teto = CampoDinheiro(filtros, 0, largura=12)
            campo_teto.pack(side="left", padx=6)

        cols = [("pos", "Pos", 45, "center"), ("nome", "Jogador", 175, "w"),
                ("idade", "Idade", 50, "center"), ("ovr", "Ovr", 45, "center"),
                ("pot", "Teto", 70, "center"), ("clube", "Clube", 150, "w"),
                ("sal", "Salario", 90, "e")]
        if emprestimo:
            cols += [("pct", "Dono quer", 85, "center"), ("mensal", "Sua fatia", 95, "e")]
        else:
            cols += [("preco", "Pedido", 100, "e"), ("emp", "Emp", 45, "center")]
        q, tv = grade(pai, cols, altura=14)
        q.pack(fill="both", expand=True, padx=18)
        self.tv_mercado = tv

        def buscar(_=None):
            tv.delete(*tv.get_children())
            pos = None if cb_pos.get() == "Todas" else cb_pos.get()
            ovr = int(eng.re.sub(r"[^0-9]", "", e_ovr.get()) or 0) or None
            idade = int(eng.re.sub(r"[^0-9]", "", e_idade.get()) or 0) or None
            teto = campo_teto.valor() if campo_teto else 0
            if livres:
                achados = [j for j in (G["jogadores"][p] for p in G["livres"])
                           if (not pos or j["pos"] == pos) and (not ovr or j["ovr"] >= ovr)
                           and (not idade or j["idade"] <= idade)]
                achados.sort(key=lambda j: -j["ovr"])
                achados = achados[:60]
            else:
                achados = eng.buscar(G, pos=pos, ovr=ovr, idade=idade, teto=teto or None,
                                     so_emprestimo=emprestimo, limite=60)
            for j in achados:
                clube = G["clubes"][j["clube"]]["nome"] if j["clube"] else "sem clube"
                base = [j["pos"], j["nome"], j["idade"], j["ovr"], eng.scout(G, j), clube,
                        din(j["salario"])]
                if emprestimo:
                    pct = eng.exigencia_emprestimo(G, j, c)
                    base += ["%d%%" % pct, din(j["salario"] * pct // 100)]
                elif j["clube"] is None:
                    base += ["livre", "-"]
                else:
                    valor, intocavel = eng.pedido_efetivo(G, j)
                    base += [din(valor) + (" !" if intocavel else
                                           (" *" if j["listado"] else "")),
                             "sim" if j.get("emp_listado") else ""]
                tv.insert("", "end", iid=str(j["id"]), values=tuple(base),
                          tags=(tag_ovr(j["ovr"]),))
            self.status("%d jogador(es) encontrados" % len(achados))

        cb_pos.bind("<<ComboboxSelected>>", buscar)
        e_ovr.bind("<Return>", buscar)
        e_idade.bind("<Return>", buscar)
        botao(filtros, "Buscar", buscar, cor=TEMA["acao"]).pack(side="left", padx=12)
        tv.bind("<Double-1>", lambda e: self.ficha_mercado())

        legenda = ("aqui aparece so quem foi oferecido; para pedir qualquer outro, use "
                   "Pedir emprestado na aba Comprar"
                   if emprestimo else
                   "* o clube quer vender   ! nao quer vender   EMP tambem sai por emprestimo")
        # esta legenda explica o que "*", "!" e "EMP" significam: e regra, nao
        # decoracao, entao nao pode ficar na menor fonte da escala
        rotulo(pai, legenda, cor=TEMA["txt"]).pack(anchor="w", padx=18, pady=(6, 0))

        acoes = tk.Frame(pai, bg=TEMA["fundo"])
        acoes.pack(fill="x", padx=18, pady=8)
        if emprestimo:
            botao(acoes, "Pegar emprestado", lambda: self.negociar("emprestimo"),
                  cor=TEMA["acao"]).pack(side="left")
        else:
            botao(acoes, "Negociar contrato" if livres else "Negociar compra",
                  lambda: self.negociar("compra"), cor=TEMA["acao"]).pack(side="left")
            if not livres:
                botao(acoes, "Pedir emprestado",
                      lambda: self.negociar("emprestimo")).pack(side="left", padx=6)
        botao(acoes, "Ver ficha", self.ficha_mercado).pack(side="left", padx=6)
        buscar()

    def _mercado_vitrine(self, pai, aberto, ofertas):
        """Tudo o que sai do clube em uma tela: quem esta na vitrine e as ofertas."""
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        meus = [G["jogadores"][p] for p in c["elenco"] if not G["jogadores"][p].get("dono")]
        listados = [j for j in meus if j["listado"]]
        por_jogador = {}
        for j, cl, v in ofertas:
            por_jogador[j["id"]] = (cl, v)
        q, tv = grade(pai, [("nome", "Jogador", 175, "w"), ("pos", "Pos", 45, "center"),
                            ("ovr", "Ovr", 45, "center"), ("sal", "Salario", 90, "e"),
                            ("val", "Valor", 100, "e"), ("ped", "Voce pede", 100, "e"),
                            ("pct", "%", 50, "center"), ("quem", "Interessado", 150, "w"),
                            ("of", "Oferta", 100, "e")], altura=12, multi=True)
        q.pack(fill="both", expand=True, padx=18)
        self.tv_vitrine = tv
        for j in sorted(listados, key=lambda x: -x["valor"]):
            cl, v = por_jogador.get(j["id"], (None, 0))
            tv.insert("", "end", iid=str(j["id"]),
                      values=(j["nome"], j["pos"], j["ovr"], din(j["salario"]), din(j["valor"]),
                              din(j["listado"]), "%d%%" % round(100.0 * j["listado"] /
                                                                max(1, j["valor"])),
                              cl["nome"] if cl else "-", din(v) if v else "-"),
                      tags=("aviso" if cl else tag_ovr(j["ovr"]),))
        if not listados:
            rotulo(pai, "Ninguem na vitrine. Marque jogadores no Elenco e use Por a venda - "
                        "da para precificar varios de uma vez.",
                   cor=TEMA["av"]).pack(anchor="w", padx=18, pady=8)
        else:
            rotulo(pai, "em amarelo, quem ja tem proposta desta semana",
                   cor=TEMA["fraco"], fonte=FONTE_P).pack(anchor="w", padx=18, pady=(6, 0))

        acoes = tk.Frame(pai, bg=TEMA["fundo"])
        acoes.pack(fill="x", padx=18, pady=8)
        botao(acoes, "Propostas recebidas (%d)" % len(ofertas), self.ver_propostas,
              cor=TEMA["acao"] if ofertas else TEMA["painel"]).pack(side="left")
        botao(acoes, "Reprecificar", self.reprecificar).pack(side="left", padx=6)
        botao(acoes, "Tirar da vitrine", self.tirar_da_vitrine).pack(side="left", padx=6)
        self._painel_agendadas(pai)

    def _painel_agendadas(self, pai):
        """O que foi acertado fora da janela e ainda nao se cumpriu."""
        G = self.G
        pendentes = eng.minhas_agendadas(G)
        if not pendentes:
            return
        rotulo(pai, "ACERTADO PARA A PROXIMA JANELA", cor=TEMA["av"],
               fonte=FONTE_PB).pack(anchor="w", padx=18, pady=(8, 2))
        q, tv = grade(pai, [("quem", "Jogador", 175, "w"), ("tipo", "Negocio", 100, "center"),
                            ("outro", "Com", 175, "w"), ("valor", "Valor", 110, "e"),
                            ("quando", "Acertado em", 110, "center")], altura=4, multi=True)
        q.pack(fill="x", padx=18)
        self.tv_agendadas = tv
        for indice, a in pendentes:
            j = G["jogadores"].get(a["jogador"])
            saindo = a.get("de") == G["clube"]
            outro = G["clubes"].get(a["para"] if saindo else a.get("de"))
            if a["tipo"] == eng.TIPO_EMPRESTIMO:
                tipo, valor = ("cessao" if saindo else "emprestimo"), "%d%%" % a["pct_salario"]
            else:
                tipo, valor = ("venda" if saindo else "compra"), din(a["valor"])
            tv.insert("", "end", iid=str(indice),
                      values=(j["nome"] if j else "?", tipo,
                              outro["nome"] if outro else "sem clube", valor,
                              "T%d S%d" % (a["temporada"], a["semana"])),
                      tags=("aviso",))
        pe = tk.Frame(pai, bg=TEMA["fundo"])
        pe.pack(fill="x", padx=18, pady=6)
        botao(pe, "Cancelar acerto", self.cancelar_agendada).pack(side="left")
        rotulo(pe, "  entram sozinhos assim que a janela abrir: %s"
               % eng.recado_janela(G).lower(), cor=TEMA["fraco"],
               fonte=FONTE_P).pack(side="left")

    def cancelar_agendada(self):
        sel = self.tv_agendadas.selection()
        if not sel:
            messagebox.showinfo("BRASFUT", "Marque o acerto que voce quer desfazer.")
            return
        for i in sorted((int(s) for s in sel), reverse=True):
            self.log(eng.cancelar_agendada(self.G, i)[1])
        self.atualizar_topo()
        self.mostrar("mercado")

    def alvos_vitrine(self):
        """Marcados na vitrine, ou todos os listados se nada estiver marcado."""
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        sel = self.tv_vitrine.selection()
        if sel:
            return [G["jogadores"][int(i)] for i in sel]
        return [G["jogadores"][p] for p in c["elenco"]
                if G["jogadores"][p]["listado"] and not G["jogadores"][p].get("dono")]

    def reprecificar(self):
        alvos = self.alvos_vitrine()
        if not alvos:
            messagebox.showinfo("BRASFUT", "Ninguem na vitrine para reprecificar.")
            return
        self.log(Vitrine(self, self.G, alvos).esperar())
        self.atualizar_topo()
        self.mostrar("mercado")

    def tirar_da_vitrine(self):
        alvos = self.alvos_vitrine()
        if not alvos:
            return
        for j in alvos:
            self.log(eng.tirar_da_vitrine(self.G, j["id"])[1])
        self.mostrar("mercado")

    def alvo_mercado(self):
        sel = self.tv_mercado.selection()
        if not sel:
            messagebox.showinfo("Selecione um jogador",
                                "Clique em um jogador da lista antes de usar este botao.")
            return None
        return self.G["jogadores"][int(sel[0])]

    def ficha_mercado(self):
        j = self.alvo_mercado()
        if not j:
            return
        acoes = []
        if j["clube"] is None:
            acoes.append(("Negociar contrato", lambda: self.negociar("compra")))
        else:
            acoes.append(("Negociar compra", lambda: self.negociar("compra")))
            acoes.append(("Pedir emprestado", lambda: self.negociar("emprestimo")))
        Ficha(self, self.G, j, acoes=acoes).esperar()

    def negociar(self, tipo="compra"):
        j = self.alvo_mercado()
        if not j:
            return
        if tipo == "emprestimo":
            if j["clube"] is None:
                messagebox.showinfo("BRASFUT", "%s esta sem clube: contrate como agente livre."
                                    % j["nome"])
                return
            texto = PegarEmprestado(self, self.G, j).esperar()
        else:
            texto = Negociar(self, self.G, j).esperar()
        if texto:
            self.log(texto)
        self.atualizar_topo()
        self.mostrar("mercado")

    def ver_propostas(self):
        ofertas = eng.propostas_recebidas(self.G)
        if not ofertas:
            messagebox.showinfo("BRASFUT", "Nenhuma proposta nesta semana.\n\n"
                                "Ponha alguem na vitrine pelo Elenco, ou baixe o preco: "
                                "pedir muito acima do valor de mercado afasta comprador.")
            return
        self.log(Propostas(self, self.G).esperar())
        self.atualizar_topo()
        self.mostrar("mercado")

