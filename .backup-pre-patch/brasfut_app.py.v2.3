        rotulo(info, "Preco do ingresso: R$ %d" % c["preco"], bg=TEMA["painel"]).pack(anchor="w")
        if c["obra_semanas"]:
            rotulo(info, "Obra: +%d lugares, faltam %d semanas" % (c["obra_lugares"], c["obra_semanas"]),
                   cor=TEMA["av"], bg=TEMA["painel"]).pack(anchor="w")
        f = tk.Frame(pai, bg=TEMA["fundo"])
        f.pack(fill="x", padx=18, pady=14)
        rotulo(f, "Novo preco do ingresso (R$ 5 a 300)").pack(anchor="w")
        e_preco = tk.Entry(f, width=8, bg=TEMA["painel"], fg=TEMA["txt"], relief="flat",
                           insertbackground=TEMA["txt"])
        e_preco.insert(0, str(c["preco"]))
        e_preco.pack(anchor="w", pady=4)

        def mudar_preco():
            try:
                v = int(e_preco.get())
            except ValueError:
                return
            c["preco"] = int(eng.clamp(v, 5, 300))
            self.status("ingresso a R$ %d. Caro afasta publico, barato enche o estadio." % c["preco"])
            self.mostrar("estadio")
        botao(f, "Aplicar preco", mudar_preco).pack(anchor="w", pady=4)

        rotulo(f, "\nAmpliar o estadio  -  R$ 3.500 por lugar, 1 semana a cada 1.500 lugares").pack(anchor="w")
        e_lug = tk.Entry(f, width=8, bg=TEMA["painel"], fg=TEMA["txt"], relief="flat",
                         insertbackground=TEMA["txt"])
        e_lug.pack(anchor="w", pady=4)

        def ampliar():
            try:
                v = int(e_lug.get())
            except ValueError:
                return
            if c["obra_semanas"]:
                messagebox.showinfo("BRASFUT", "Ja existe uma obra em andamento.")
                return
            v = int(eng.clamp(v, 1000, 40000))
            custo = v * 3500
            if custo > c["dinheiro"]:
                messagebox.showwarning("BRASFUT", "Caixa insuficiente. Custaria %s." % din(custo))
                return
            if not messagebox.askyesno("Obra", "Ampliar em %d lugares por %s?" % (v, din(custo))):
                return
            c["dinheiro"] -= custo
            c["obra_lugares"] = v
            c["obra_semanas"] = max(2, v // 1500)
            self.log("Obra contratada: +%d lugares por %s, pronta em %d semanas."
                     % (v, din(custo), c["obra_semanas"]))
            self.atualizar_topo()
            self.mostrar("estadio")
        botao(f, "Contratar obra", ampliar, cor=TEMA["acao"]).pack(anchor="w", pady=4)

    # ------------------------------------------------------------------- infra
    def tela_infra(self, pai):
        c = self.G["clubes"][self.G["clube"]]
        self.cabecalho_tela(pai, "Infraestrutura", "caixa %s" % din(c["dinheiro"]))
        itens = [("ct", "Centro de treinamento", "evolucao dos jogadores"),
                 ("base", "Categorias de base", "qualidade das crias no fim do ano"),
                 ("medico", "Departamento medico", "menos lesao e recuperacao mais rapida")]
        for chave, nome, desc in itens:
            card = tk.Frame(pai, bg=TEMA["painel"], padx=16, pady=12)
            card.pack(fill="x", padx=18, pady=4)
            rotulo(card, "%s  -  nivel %d de 10" % (nome, c[chave]), fonte=FONTE_B,
                   bg=TEMA["painel"]).pack(anchor="w")
            rotulo(card, desc, cor=TEMA["fraco"], bg=TEMA["painel"]).pack(anchor="w")
            rotulo(card, "[" + "#" * c[chave] + "." * (10 - c[chave]) + "]",
                   cor=TEMA["ok"], fonte=MONO, bg=TEMA["painel"]).pack(anchor="w", pady=2)
            if c[chave] >= 10:
                rotulo(card, "nivel maximo", cor=TEMA["top"], bg=TEMA["painel"]).pack(anchor="w")
                continue
            custo = int((c[chave] + 1) ** 2 * 900_000)
            botao(card, "Subir para o nivel %d por %s" % (c[chave] + 1, din(custo)),
                  lambda k=chave, v=custo: self.investir(k, v)).pack(anchor="w", pady=4)

    def investir(self, chave, custo):
        c = self.G["clubes"][self.G["clube"]]
        if custo > c["dinheiro"]:
            messagebox.showwarning("BRASFUT", "Caixa insuficiente.")
            return
        c["dinheiro"] -= custo
        c[chave] += 1
        self.log("Investimento de %s feito. %s agora esta no nivel %d."
                 % (din(custo), chave.upper(), c[chave]))
        self.atualizar_topo()
        self.mostrar("infra")

    # ---------------------------------------------------------------- noticias
    def tela_noticias(self, pai):
        self.cabecalho_tela(pai, "Noticias")
        cx = tk.Text(pai, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO, relief="flat",
                     wrap="word", padx=12, pady=10)
        cx.pack(fill="both", expand=True, padx=18, pady=6)
        linhas = self.G["noticias"][-25:] or ["Nada publicado ainda."]
        cx.insert("1.0", "\n".join(linhas))
        cx.configure(state="disabled")

    # ------------------------------------------------------------ modo console
    def executar_comando(self, _=None):
        cmd = self.ent_cmd.get().strip()
        self.ent_cmd.delete(0, "end")
        if not cmd:
            return
        self.log("> " + cmd)
        G = self.G
        c = G["clubes"][G["clube"]]
        partes = cmd.lower().split()
        verbo, args = partes[0], partes[1:]
        try:
            if verbo in ("semana", "s", "jogar"):
                self.avancar()
            elif verbo == "elenco":
                _, t = capturar(eng.tela_elenco, G, None, False)
                self.log(t)
            elif verbo in ("tabela", "classificacao"):
                div = args[0].upper() if args and args[0].upper() in "ABCD" else c["divisao"]
                _, t = capturar(eng.tela_tabela, G, div)
                self.log(t)
            elif verbo == "copas":
                _, t = capturar(eng.tela_copas, G)
                self.log(t)
            elif verbo in ("financas", "caixa"):
                _, t = capturar(eng.tela_financas, G)
                self.log(t)
            elif verbo in ("stats", "artilharia"):
                _, t = capturar(eng.tela_estatisticas, G)
                self.log(t)
            elif verbo == "noticias":
                self.log("\n".join(G["noticias"][-15:]) or "Nada por aqui.")
            elif verbo == "escalacao":
                self.log(self.texto_escalacao())
            elif verbo == "auto":
                ligada = not eng.escalacao_automatica(G, c)
                eng.definir_escalacao_automatica(G, ligada)
                self.log("Escalacao automatica %s." %
                         ("LIGADA - a maquina monta o melhor time toda semana"
                          if ligada else "DESLIGADA - o time agora e seu"))
                self.log(self.texto_escalacao())
            elif verbo == "troca" and len(args) == 2:
                self.troca_console(args)
            elif verbo == "form" and args:
                achou = [f for f in eng.FORMACOES if f.lower() == args[0]]
                if achou:
                    c["formacao"] = achou[0]
                    c["escalacao"] = eng.auto_escalar(G, c)
                    self.log("Formacao agora e %s." % achou[0])
                else:
                    self.log("Formacoes: " + ", ".join(eng.FORMACOES))
            elif verbo == "tatica" and args:
                achou = [t for t in eng.TATICAS if t.lower().startswith(" ".join(args))]
                if achou:
                    c["tatica"] = achou[0]
                    self.log("Tatica agora e %s." % achou[0])
                else:
                    self.log("Taticas: " + ", ".join(eng.TATICAS))
            elif verbo == "mercado":
                pos = args[0].upper() if args and args[0].upper() in eng.POS else None
                lst = eng.buscar(G, pos=pos, limite=20)
                if not lst:
                    self.log("Ninguem a venda com esse filtro agora.")
                else:
                    linhas = ["%-4s %-22s %3s %3s  %-20s %12s" %
                              (j["pos"], j["nome"][:22], j["idade"], j["ovr"],
                               G["clubes"][j["clube"]]["nome"][:20], din(j["listado"]))
                              for j in lst]
                    self.log("\n".join(linhas) + "\n\nUse o modo visual para negociar.")
            elif verbo == "salvar":
                self.salvar()
                self.log("Jogo salvo.")
            elif verbo == "visual":
                self.alternar_modo()
            elif verbo in ("ajuda", "help", "?"):
                self.log(AJUDA)
            else:
                self.log("Nao conheco esse comando. Digite ajuda.")
        except Exception:
            self.log("Deu erro nesse comando:\n" + traceback.format_exc())
        self.atualizar_topo()

    def texto_escalacao(self):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        esc, _ = eng.escalacao_valida(G, c)
        c["escalacao"] = esc
        at, de, _ = eng.forcas(G, c)
        linhas = ["%s  |  %s  |  ataque %.1f  defesa %.1f" % (c["formacao"], c["tatica"], at, de),
                  "escalacao %s" % ("AUTOMATICA - a maquina monta toda semana"
                                    if eng.escalacao_automatica(G, c)
                                    else "MANUAL - o time e seu"), ""]
        for i, pid in enumerate(esc, 1):
            j = G["jogadores"][pid]
            linhas.append("%2d  %-4s %-22s ovr %2d  fis %3d  moral %3d"
                          % (i, j["pos"], j["nome"][:22], j["ovr"], j["cond"], j["moral"]))
        resto = [p for p in c["elenco"] if p not in esc]
        resto.sort(key=lambda p: -eng.rendimento(G["jogadores"][p]))
        linhas.append("")
        linhas.append("BANCO")
        for i, pid in enumerate(resto, 12):
            j = G["jogadores"][pid]
            sit = eng.re.sub(r"\033\[[0-9;]*m", "", eng.situacao(G, j))
            linhas.append("%2d  %-4s %-22s ovr %2d  fis %3d  %s"
                          % (i, j["pos"], j["nome"][:22], j["ovr"], j["cond"], sit))
        linhas.append("")
        linhas.append("troca 9 15 para trocar dois jogadores")
        return "\n".join(linhas)

    def troca_console(self, args):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        esc, _ = eng.escalacao_valida(G, c)
        resto = [p for p in c["elenco"] if p not in esc]
        resto.sort(key=lambda p: -eng.rendimento(G["jogadores"][p]))
        todos = esc + resto
        try:
            a, b = int(args[0]), int(args[1])
        except ValueError:
            self.log("Use dois numeros, por exemplo: troca 9 15")
            return
        if not (1 <= a <= len(todos) and 1 <= b <= len(todos)):
            self.log("Numero fora da lista.")
            return
        pa, pb = todos[a - 1], todos[b - 1]
        for p in (pa, pb):
            if not eng.disponivel(G, p):
                self.log("%s nao tem condicao de jogar." % G["jogadores"][p]["nome"])
                return
        nova = esc[:]
        if pa in nova and pb in nova:
            i1, i2 = nova.index(pa), nova.index(pb)
            nova[i1], nova[i2] = nova[i2], nova[i1]
        elif pa in nova:
            nova[nova.index(pa)] = pb
        elif pb in nova:
            nova[nova.index(pb)] = pa
        else:
            self.log("Escolha pelo menos um titular.")
            return
        if self._assumir_o_time():
            self.log("Voce mexeu no time: a escalacao automatica foi desligada.")
        c["escalacao"] = nova
        c["esc_stamp"] = ""
        self.log(self.texto_escalacao())


