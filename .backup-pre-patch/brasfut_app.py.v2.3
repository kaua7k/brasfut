        cols = [("pos", "Pos", 45, "center"), ("nome", "Jogador", 190, "w"),
                ("idade", "Idade", 50, "center"), ("ovr", "Ovr", 45, "center"),
                ("pot", "Teto", 70, "center"), ("fis", "Fisico", 55, "center"),
                ("moral", "Moral", 55, "center"), ("jg", "J/G", 60, "center"),
                ("sal", "Salario", 95, "e"), ("ct", "Contrato", 70, "center"),
                ("ped", "Na vitrine", 100, "e"), ("sit", "Situacao", 110, "w")]
        q, tv = grade(pai, cols, altura=15, multi=True)
        q.pack(fill="both", expand=True, padx=18)
