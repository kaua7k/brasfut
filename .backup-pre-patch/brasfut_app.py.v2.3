            Ficha(self, self.G, self.G["jogadores"][int(sel[0])])

    # ---------------------------------------------------- card acontecimentos
    # ------------------------------------------------- resultados da rodada
    def _alerta_de_fase(self):
        """Tres tropecos seguidos e um problema, e o jogo nao dizia nada.

        O diagnostico existente so olha lesao, suspensao e improviso: um time
        inteiro e saudavel perdendo todo domingo aparecia como TIME PRONTO.
        """
        forma = eng.forma_recente(self.G, 5)
        if len(forma) < 3:
            return None
        ultimos = [f[0] for f in forma[-3:]]
        if ultimos == ["D", "D", "D"]:
            return ("Tres derrotas seguidas. Reveja o plano de jogo e quem esta entrando.",
                    "critico")
        if ultimos.count("D") >= 2 and "V" not in ultimos:
            return ("Sem vencer ha tres jogos. Talvez seja hora de mexer na tatica.",
                    "atencao")
        if ultimos == ["V", "V", "V"]:
            return ("Tres vitorias seguidas. O time achou o caminho.", "ok")
        return None

    def _faixa_resultados(self, pai):
        """O placar da semana no tamanho que ele merece, logo abaixo do veredito.

        Antes o resultado entrava diluido numa linha do bloco de acontecimentos,
        junto com noticia de lesao e de mercado: dava para terminar a semana sem
        saber se o time ganhou.
        """
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        faixa = tk.Frame(pai, bg=TEMA["painel"], height=self._alt_res)
        faixa.pack(fill="x", padx=18, pady=(0, 8))
        faixa.pack_propagate(False)

        dirf = tk.Frame(faixa, bg=TEMA["painel"])
        dirf.pack(side="right", fill="y", padx=14, pady=6)
        rotulo(dirf, "ULTIMOS 5", cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["painel"]).pack(anchor="e")
        chips = tk.Frame(dirf, bg=TEMA["painel"])
        chips.pack(anchor="e", pady=(2, 0))
        forma = eng.forma_recente(G, 5)
        if not forma:
            rotulo(chips, "sem historico ainda", cor=TEMA["fraco"], fonte=FONTE_P,
                   bg=TEMA["painel"]).pack(side="left")
        for letra, descricao in forma:
            cr = {"V": TEMA["ok"], "E": TEMA["av"], "D": TEMA["ruim"]}[letra]
            lb = tk.Label(chips, text=letra, bg=cr, fg=TEMA["fundo"], font=FONTE_PB,
                          width=2, pady=1, cursor="hand2")
            lb.pack(side="left", padx=1)
            # sem tooltip no tkinter: o rodape faz o papel dela
            lb.bind("<Enter>", lambda _e, t=descricao: self.status(t))
            lb.bind("<Leave>", lambda _e: self.status(*self._status_do_estado(
                self.diagnostico())))

        alerta = self._alerta_de_fase()
        if alerta:
            texto_alerta, estado = alerta
            cr = cor_estado(estado)
            linha_alerta = tk.Frame(pai, bg=TEMA["painel"])
            linha_alerta.pack(fill="x", padx=18, pady=(0, 6))
            tk.Frame(linha_alerta, bg=cr, width=4).pack(side="left", fill="y")
            rotulo(linha_alerta, texto_alerta, cor=cr, fonte=FONTE_B,
                   bg=TEMA["painel"]).pack(side="left", padx=12, pady=6)
            if estado != "ok":
                botao(linha_alerta, "Abrir plano de jogo",
                      lambda: self.mostrar("escalacao")).pack(side="right", padx=12, pady=4)

        corpo = tk.Frame(faixa, bg=TEMA["painel"])
        corpo.pack(side="left", fill="both", expand=True, padx=14, pady=6)
        cab = tk.Frame(corpo, bg=TEMA["painel"])
        cab.pack(fill="x")
        rotulo(cab, "ULTIMA RODADA", cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["painel"]).pack(side="left")
        jogos = eng.resultados_da_semana(G)
        if jogos:
            link = rotulo(cab, "   ver a partida >", cor=cor_link(), fonte=FONTE_PB,
                          bg=TEMA["painel"], cursor="hand2")
            link.pack(side="left")
            link.bind("<Button-1>", lambda _e: self.abrir_partida())
        if not jogos:
            texto = ("A temporada nao comecou. Avance para a bola rolar."
                     if G["fase"] == "entretemporada" else
                     ("Semana sem jogo: o elenco descansou."
                      if G.get("placar_hist") else "Nenhum jogo processado ainda."))
            rotulo(corpo, texto, cor=TEMA["fraco"], bg=TEMA["painel"]).pack(anchor="w")
            return faixa
        linha = tk.Frame(corpo, bg=TEMA["painel"])
        linha.pack(anchor="w", pady=(1, 0))
        for i, r in enumerate(jogos[:3]):
            if i:
                rotulo(linha, "     ", bg=TEMA["painel"]).pack(side="left")
            self._placar_chip(linha, r).pack(side="left")
        return faixa

    def _placar_chip(self, pai, r):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        em_casa = r["casa"] == c["id"]
        gm, gs = (r["gc"], r["gf"]) if em_casa else (r["gf"], r["gc"])
        adv = G["clubes"].get(r["fora"] if em_casa else r["casa"])
        cr = TEMA["ok"] if gm > gs else (TEMA["av"] if gm == gs else TEMA["ruim"])
        comp = ("Serie %s" % c["divisao"]) if r["comp"] == "liga" \
            else corta(eng.nome_competicao(G, r["comp"], G["clubes"].get(r["casa"])), 24)
        f = tk.Frame(pai, bg=TEMA["painel"])
        tk.Frame(f, bg=cr, width=3).pack(side="left", fill="y")
        cx = tk.Frame(f, bg=TEMA["painel"])
        cx.pack(side="left", padx=(7, 0))
        rotulo(cx, "%s  %s" % (comp, "em casa" if em_casa else "fora"), cor=TEMA["fraco"],
               fonte=FONTE_P, bg=TEMA["painel"]).pack(anchor="w")
        placar = tk.Frame(cx, bg=TEMA["painel"])
        placar.pack(anchor="w")
        rotulo(placar, "%d x %d" % (gm, gs), cor=cr, fonte=FONTE_M,
               bg=TEMA["painel"]).pack(side="left")
        rotulo(placar, "  " + corta(adv["nome"] if adv else "adversario", 22),
               bg=TEMA["painel"]).pack(side="left")
        # o placar e a porta da partida: clicar abre o jogo inteiro
        for w in (f, cx, placar) + tuple(placar.winfo_children()) + tuple(cx.winfo_children()):
            w.configure(cursor="hand2")
            w.bind("<Button-1>", lambda _e, rr=r: self.abrir_partida(rr))
        return f

    def abrir_partida(self, r=None):
        """A tela da partida. Sem argumento, abre o jogo mais recente."""
        if r is None:
            jogos = eng.resultados_da_semana(self.G)
            if not jogos:
                messagebox.showinfo("BRASFUT", "Nenhuma partida processada ainda.")
                return
            r = jogos[0]
        Partida(self, self.G, r).esperar()

    # ---------------------------------------------------- card ultima rodada
    def _card_acontecimentos(self, pai):
        """Como foi o jogo e o que se fala no clube.

        O motor so gera noticia em evento forte, e muita semana passa sem
        nenhuma. Por isso os gols da rodada vem primeiro: sem eles o bloco
        vivia vazio.
        """
        card = tk.Frame(pai, bg=TEMA["painel"])
        card.pack_propagate(False)
        topo = tk.Frame(card, bg=TEMA["painel"])
        topo.pack(fill="x", padx=14, pady=(8, 2))
        rotulo(topo, "COMO FOI A RODADA", cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["painel"]).pack(side="left")
        link = rotulo(topo, "ver tudo", cor=TEMA["fraco"], fonte=FONTE_P,
                      bg=TEMA["painel"], cursor="hand2")
        link.pack(side="right")
        link.bind("<Button-1>", lambda _e: self.mostrar("noticias"))

        cx = tk.Text(card, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO, relief="flat",
                     wrap="word", padx=10, pady=4, height=6, highlightthickness=0)
        cx.pack(fill="both", expand=True, padx=4)
        for nome, token in (("fraco", "fraco"), ("ok", "ok"), ("ruim", "ruim"),
                            ("av", "av")):
            cx.tag_configure(nome, foreground=TEMA[token])
        vazio = True
        for linha, tag in self._linhas_da_rodada():
            cx.insert("end", linha + "\n", tag)
            vazio = False
        for n in reversed(self.G["noticias"][-3:]):
            limpo = eng.re.sub(r"\033\[[0-9;]*m", "", n).strip().replace("\n", " ")
            cx.insert("end", corta(limpo, 150) + "\n", "fraco")
            vazio = False
        if vazio:
            cx.insert("1.0", "Nada por aqui ainda. Avance a semana para comecar a historia.",
                      "fraco")
        cx.configure(state="disabled")
        return card

    def _linhas_da_rodada(self):
        """Gols, lesoes e cartoes dos meus jogos da ultima semana."""
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        jogs = G["jogadores"]
        linhas = []
        for r in eng.resultados_da_semana(G):
            em_casa = r["casa"] == c["id"]
            gm, gs = (r["gc"], r["gf"]) if em_casa else (r["gf"], r["gc"])
            adv = G["clubes"].get(r["fora"] if em_casa else r["casa"])
            tag = "ok" if gm > gs else ("av" if gm == gs else "ruim")
            linhas.append(("%d x %d  %s" % (gm, gs, corta(adv["nome"] if adv else "-", 24)),
                           tag))
            for minuto, lado, tipo, pid, ass in r.get("eventos", []):
                j = jogs.get(pid)
                if not j:
                    continue
                meu_lado = (lado == 0) == em_casa
                if tipo == "gol":
                    quem = j["nome"] if meu_lado else j["nome"]
                    extra = ""
                    if ass and ass in jogs and meu_lado:
                        extra = " (assist. %s)" % corta(jogs[ass]["nome"], 16)
                    linhas.append(("   %2d' gol %s%s%s" % (minuto, corta(quem, 18), extra,
                                                           "" if meu_lado else "  [contra nos]"),
                                   "ok" if meu_lado else "fraco"))
                elif j["clube"] == c["id"] and tipo == "lesao":
                    linhas.append(("   %2d' lesao: %s, %d semana(s) fora"
                                   % (minuto, corta(j["nome"], 18), j["lesao"]), "ruim"))
                elif j["clube"] == c["id"] and tipo == "vermelho":
                    linhas.append(("   %2d' vermelho: %s" % (minuto, corta(j["nome"], 18)),
                                   "ruim"))
        return linhas[:14]

