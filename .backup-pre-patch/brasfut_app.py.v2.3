            rotulo(pai, "CEDIDOS POR EMPRESTIMO", cor=TEMA["fraco"]).pack(anchor="w", padx=18,
                                                                          pady=(10, 4))
            q2, tv2 = grade(pai, [("nome", "Jogador", 190, "w"), ("pos", "Pos", 45, "center"),
                                  ("ovr", "Ovr", 45, "center"), ("clube", "Esta no", 170, "w"),
                                  ("pct", "Eles pagam", 85, "center"),
                                  ("custo", "Custa pra voce", 115, "e"),
                                  ("op", "Opcao de compra", 120, "e")], altura=4, multi=True)
            q2.pack(fill="x", padx=18)
            self.tv_cedidos = tv2
            for j in cedidos:
                onde = G["clubes"][j["clube"]]["nome"]
                tv2.insert("", "end", iid=str(j["id"]),
                           values=(j["nome"], j["pos"], j["ovr"], onde, "%d%%" % j["emp_pct"],
                                   din(j["salario"] * (100 - j["emp_pct"]) // 100),
                                   din(j["emp_opcao"]) if j.get("emp_opcao") else "-"),
                           tags=(tag_ovr(j["ovr"]),))
            f2 = tk.Frame(pai, bg=TEMA["fundo"])
            f2.pack(fill="x", padx=18, pady=6)
            botao(f2, "Chamar de volta", self.chamar_de_volta).pack(side="left")
            rotulo(f2, "  so com a janela aberta" if not aberto else
                   "  ele volta ao seu elenco e a folha inteira volta pra voce",
                   cor=TEMA["fraco"], fonte=FONTE_P).pack(side="left")

    def resumo_selecao(self):
        """Conta o que esta marcado. Sem isso, acao em lote e um tiro no escuro."""
        js = self.selecionados(aviso=False)
        if not js:
            self.lb_selecao.configure(text="nenhum jogador marcado")
            return
        folha = sum(j["salario"] for j in js)
        valor = sum(j["valor"] for j in js)
        self.lb_selecao.configure(
            text="%d marcado(s)  |  folha %s por mes  |  valor de mercado somado %s"
                 % (len(js), din(folha), din(valor)))

    def selecionados(self, aviso=True):
        """Todos os jogadores marcados na tabela do elenco."""
        sel = self.tv_elenco.selection()
        if not sel:
            if aviso:
                messagebox.showinfo("Elenco", AVISO_SELECAO)
            return []
        return [self.G["jogadores"][int(i)] for i in sel]

    def selecionado(self):
        js = self.selecionados()
        return js[0] if js else None

    def ficha_selecionada(self):
        j = self.selecionado()
        if j:
            Ficha(self, self.G, j).esperar()

    def acao_jogador(self, qual):
        js = self.selecionados()
        if not js:
            return
        if qual == "opcao":
            self.exercer_opcoes(js)
        else:
            proprios = [j for j in js if not j.get("dono")]
            alheios = [j for j in js if j.get("dono")]
            if alheios and not proprios:
                messagebox.showinfo("BRASFUT", "%s esta emprestado aqui: o passe nao e seu."
                                    % ", ".join(j["nome"] for j in alheios))
                return
            if qual == "venda":
                self.log(Vitrine(self, self.G, proprios).esperar())
            elif qual == "tirar":
                for j in proprios:
                    self.log(eng.tirar_da_vitrine(self.G, j["id"])[1])
            elif qual == "emprestar":
                self.log(CederEmprestimo(self, self.G, proprios).esperar())
            elif qual == "renovar":
                for j in proprios:
                    self.log(Renovar(self, self.G, j).esperar())
            elif qual == "rescindir":
                self.rescindir(proprios)
        self.atualizar_topo()
        self.mostrar("elenco")

    def exercer_opcoes(self, js):
        """Compra em definitivo os emprestados que tem opcao combinada."""
        com = [(j, eng.opcao_disponivel(self.G, j, self.G["clube"])) for j in js]
        com = [(j, p) for j, p in com if p > 0]
        if not com:
            messagebox.showinfo("BRASFUT", "Nenhum dos marcados tem opcao de compra combinada.")
            return
        total = sum(p for _, p in com)
        detalhe = "\n".join("  %s por %s" % (j["nome"], din(p)) for j, p in com)
        if not messagebox.askyesno("Opcao de compra", "Comprar em definitivo:\n%s\n\nTotal: %s\n"
                                   "Caixa: %s" % (detalhe, din(total),
                                                  din(self.G["clubes"][self.G["clube"]]["dinheiro"]))):
            return
        for j, _ in com:
            self.log(eng.exercer_opcao(self.G, j["id"], self.G["clube"]))

    def rescindir(self, js):
        total = sum(eng.multa_rescisao(self.G, j) for j in js)
        folha = sum(j["salario"] for j in js)
        nomes = ", ".join(j["nome"] for j in js)
        if not messagebox.askyesno("Rescindir",
                                   "Dispensar %s\n\ncusta %s de multa e alivia %s por mes.\n"
                                   "Confirma?" % (nomes, din(total), din(folha))):
            return
        for j in js:
            self.log(eng.rescindir_contrato(self.G, j["id"])[1])

    def chamar_de_volta(self):
        sel = self.tv_cedidos.selection()
        if not sel:
            messagebox.showinfo("BRASFUT", "Marque na segunda tabela quem voce quer de volta.")
            return
        if not eng.mercado_aberto(self.G):
            messagebox.showinfo("BRASFUT", "Emprestimo so se interrompe com a janela aberta.")
            return
        js = [self.G["jogadores"][int(i)] for i in sel]
        folha = sum(j["salario"] * (j["emp_pct"] / 100.0) for j in js)
        if not messagebox.askyesno("Chamar de volta",
                                   "Interromper o emprestimo de %s?\n\n"
                                   "A folha deles volta inteira pra voce: %s por mes a mais."
                                   % (", ".join(j["nome"] for j in js), din(folha))):
            return
        for j in js:
            eng.devolver_emprestimo(self.G, j["id"])
            self.log("%s voltou do emprestimo." % j["nome"])
        self.atualizar_topo()
        self.mostrar("elenco")

    # -------------------------------------------------------------------- base
    def tela_base(self, pai):
        """A academia. Antes ela era so um numero na Infraestrutura: o garoto
        nascia na virada do ano e caia direto no profissional sem ninguem ver."""
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        garotos = eng.elenco_base(G, c)
        foco = eng.foco_treino(G, c)
        prontos = sum(1 for j in garotos if eng.pronto_para_subir(G, c, j))
        self.cabecalho_tela(
            pai, "Categorias de base",
            "Formar em casa e o jeito mais barato de melhorar o time.  |  "
            "academia nivel %d  |  %d de %d vagas  |  %d pronto(s) para subir  |  "
            "bolsa %s por semana" % (c["base"], len(garotos), eng.vagas_base(c), prontos,
                                     din(eng.custo_base(G, c))))
        rotulo(pai, "Garoto de base nao joga e nao entra no mercado enquanto nao subir. "
                    "Ele treina, evolui e, aos %d anos, sobe ao profissional ou e liberado."
                    % (eng.IDADE_BASE_MAX + 1),
               cor=TEMA["txt"]).pack(anchor="w", padx=18, pady=(0, 6))

        cols = [("pos", "Pos", 45, "center"), ("nome", "Jogador", 190, "w"),
                ("idade", "Idade", 50, "center"), ("ovr", "Ovr", 45, "center"),
                ("pot", "Teto", 80, "center"), ("fis", "Fisico", 55, "center"),
                ("moral", "Moral", 55, "center"), ("bolsa", "Bolsa", 90, "e"),
                ("treino", "Treino", 80, "center"), ("sit", "Situacao", 150, "w")]
        q, tv = grade(pai, cols, altura=14, multi=True)
        q.pack(fill="both", expand=True, padx=18)
        self.tv_base = tv
        for j in garotos:
            if j["idade"] > eng.IDADE_BASE_MAX:
                sit, tag = "aos %d sobe ou sai" % (eng.IDADE_BASE_MAX + 1), "ruim"
            elif eng.pronto_para_subir(G, c, j):
                sit, tag = "pronto para subir", "bom"
            elif j["idade"] >= eng.IDADE_BASE_MAX:
                sit, tag = "ultimo ano na base", "aviso"
            else:
                sit, tag = "ainda cru", ""
            tv.insert("", "end", iid=str(j["id"]),
                      values=(j["pos"], j["nome"], j["idade"], j["ovr"], eng.scout(G, j),
                              j["cond"], j["moral"], din(j["salario"]),
                              "sim" if j["id"] in foco else "-", sit),
                      tags=(tag or tag_ovr(j["ovr"]),))
        tv.bind("<Double-1>", lambda e: self.ficha_base())

        if not garotos:
            rotulo(pai, "Academia vazia. A safra nova chega na virada da temporada - "
                        "suba o nivel da base na Infraestrutura para formar mais gente.",
                   cor=TEMA["av"]).pack(anchor="w", padx=18, pady=10)

        acoes = tk.Frame(pai, bg=TEMA["fundo"])
        acoes.pack(fill="x", padx=18, pady=10)
        botao(acoes, "Subir ao profissional", self.subir_da_base,
              cor=TEMA["acao"]).pack(side="left")
        botao(acoes, "Treino individual",
              lambda: self.alternar_foco_selecao("base")).pack(side="left", padx=6)
        botao(acoes, "Ver ficha", self.ficha_base).pack(side="left", padx=6)
        botao(acoes, "Liberar da base", self.liberar_da_base).pack(side="left", padx=6)
        rotulo(acoes, "  elenco profissional: %d/32" % len(c["elenco"]),
               cor=TEMA["fraco"], fonte=FONTE_P).pack(side="left", padx=10)

    def selecionados_base(self):
        sel = self.tv_base.selection()
        if not sel:
            messagebox.showinfo("BRASFUT", "Selecione um ou mais garotos da base.")
            return []
        return [self.G["jogadores"][int(i)] for i in sel]

    def ficha_base(self):
        js = self.selecionados_base()
        if js:
            Ficha(self, self.G, js[0]).esperar()

    def subir_da_base(self):
        js = self.selecionados_base()
        if not js:
            return
        nomes = "\n".join("  %s, %s, %d anos, overall %d (teto %s)"
                          % (j["nome"], j["pos"], j["idade"], j["ovr"], eng.scout(self.G, j))
                          for j in js)
        if not messagebox.askyesno("Subir ao profissional",
                                   "Subir ao elenco profissional:\n%s\n\n"
                                   "Eles passam a receber salario cheio e podem jogar."
                                   % nomes):
            return
        for j in js:
            feito, recado = eng.promover_da_base(self.G, j["id"])
            self.log(recado)
            if not feito:
                messagebox.showwarning("BRASFUT", recado)
                break
        self.atualizar_topo()
        self.mostrar("base")

    def liberar_da_base(self):
        js = self.selecionados_base()
        if not js:
            return
        if not messagebox.askyesno("Liberar da base",
                                   "Liberar de vez:\n\n%s\n\nNao tem multa, e nao tem volta."
                                   % ", ".join(j["nome"] for j in js), default="no",
                                   icon="warning"):
            return
        for j in js:
            self.log(eng.dispensar_da_base(self.G, j["id"])[1])
        self.atualizar_topo()
        self.mostrar("base")

    # ------------------------------------------------------------------ treino
    def tela_treino(self, pai):
        """Regime da semana e trabalho individual: onde se decide quem evolui."""
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        foco = eng.foco_treino(G, c)
        vagas = eng.vagas_treino(c)
        self.cabecalho_tela(
            pai, "Treino",
            "Evoluir quem voce ja tem, sem gastar passe.  |  "
            "CT nivel %d  |  %d de %d em trabalho individual  |  custo %s por semana  |  "
            "todo regime tem preco" % (c["ct"], len(foco), vagas, din(eng.custo_treino(c))))

        grade_reg = tk.Frame(pai, bg=TEMA["fundo"])
        grade_reg.pack(fill="x", padx=18)
        for i, (nome, r) in enumerate(eng.REGIMES_TREINO.items()):
            col = tk.Frame(grade_reg, bg=TEMA["fundo"])
            col.grid(row=i // 3, column=i % 3, sticky="nsew", padx=(0, 8), pady=4)
            self._cartao_regime(col, nome, r, nome == c["treino"]).pack(fill="both", expand=True)
        for k in range(3):
            grade_reg.columnconfigure(k, weight=1, uniform="reg")

        rotulo(pai, "TRABALHO INDIVIDUAL", cor=TEMA["fraco"],
               fonte=FONTE_PB).pack(anchor="w", padx=18, pady=(12, 2))
        rotulo(pai, "Quem esta na lista evolui 50%% mais rapido e segura melhor o declinio. "
                    "O CT nivel %d sustenta %d nome(s); cada um custa %s por semana."
               % (c["ct"], vagas, din(26_000 + 3_000 * c["ct"])),
               cor=TEMA["txt"]).pack(anchor="w", padx=18, pady=(0, 6))

        cols = [("foco", "Treino", 65, "center"), ("cat", "Onde", 80, "center"),
                ("pos", "Pos", 45, "center"), ("nome", "Jogador", 190, "w"),
                ("idade", "Idade", 50, "center"), ("ovr", "Ovr", 45, "center"),
                ("pot", "Teto", 80, "center"), ("gap", "Margem", 70, "center"),
                ("evo", "Evolui", 95, "e")]
        q, tv = grade(pai, cols, altura=11, multi=True)
        q.pack(fill="both", expand=True, padx=18)
        self.tv_treino = tv
        todos = [G["jogadores"][p] for p in c["elenco"]] + eng.elenco_base(G, c)
        todos.sort(key=lambda j: (j["id"] not in foco, -(j["pot"] - j["ovr"]), j["idade"]))
        for j in todos:
            taxa = eng.taxa_evolucao(G, j)
            margem = j["pot"] - j["ovr"]
            tag = "bom" if j["id"] in foco else ("ruim" if taxa < 0 else
                                                 ("" if margem > 0 else "fraco"))
            tv.insert("", "end", iid=str(j["id"]),
                      values=("SIM" if j["id"] in foco else "-",
                              "base" if eng.da_base(j) else "profissional",
                              j["pos"], j["nome"], j["idade"], j["ovr"], eng.scout(G, j),
                              ("+%d" % margem) if margem > 0 else "no teto",
                              "%+.2f ovr/mes" % taxa),
                      tags=(tag,))
        tv.bind("<Double-1>", lambda e: self.alternar_foco_selecao("treino"))

        acoes = tk.Frame(pai, bg=TEMA["fundo"])
        acoes.pack(fill="x", padx=18, pady=10)
        self.bt_foco = botao(acoes, "Adicionar ao treino individual",
                             lambda: self.alternar_foco_selecao("treino"),
                             cor=TEMA["acao"])
        self.bt_foco.pack(side="left")
        tv.bind("<<TreeviewSelect>>", lambda e: self._rotulo_do_foco(foco))
        botao(acoes, "Limpar a lista", self.limpar_foco).pack(side="left", padx=6)
        rotulo(acoes, "  a coluna EVOLUI ja conta o regime e o trabalho individual",
               cor=TEMA["fraco"], fonte=FONTE_P).pack(side="left", padx=10)

    def _cartao_regime(self, pai, nome, r, ativo):
        """Cada regime com o preco na cara: evolucao, fisico e lesao."""
        card = tk.Frame(pai, bg=TEMA["linha"] if ativo else TEMA["painel"], padx=12, pady=10,
                        cursor="hand2", highlightthickness=2,
                        highlightbackground=TEMA["acao"] if ativo else TEMA["painel"])
        topo = tk.Frame(card, bg=card["bg"])
        topo.pack(fill="x")
        rotulo(topo, nome, fonte=FONTE_B, bg=card["bg"],
               cor=TEMA["txt"] if ativo else TEMA["txt"]).pack(side="left")
        if ativo:
            rotulo(topo, "EM USO", cor=TEMA["ok"], fonte=FONTE_PB, bg=card["bg"]).pack(side="right")
        rotulo(card, r["desc"], cor=TEMA["fraco"], fonte=FONTE_P, bg=card["bg"],
               wraplength=250, justify="left").pack(anchor="w", pady=(2, 6))
        tira = tk.Frame(card, bg=card["bg"])
        tira.pack(anchor="w")
        for texto, valor, bom_se_positivo in (
                ("evolucao", round((r["evo"] - 1) * 100), True),
                ("fisico", r["cond"], True),
                ("lesao", round((r["lesao"] - 1) * 100), False)):
            if valor == 0:
                cr = TEMA["fraco"]
            elif (valor > 0) == bom_se_positivo:
                cr = TEMA["ok"]
            else:
                cr = TEMA["ruim"]
            rotulo(tira, "%s %+d%s  " % (texto, valor, "%" if texto != "fisico" else ""),
                   cor=cr, fonte=FONTE_P, bg=card["bg"]).pack(side="left")
        for w in (card, topo, tira):
            w.bind("<Button-1>", lambda _e, n=nome: self.escolher_regime(n))
        for w in card.winfo_children() + topo.winfo_children() + tira.winfo_children():
            w.bind("<Button-1>", lambda _e, n=nome: self.escolher_regime(n))
        return card

    def escolher_regime(self, nome):
        c = self.G["clubes"][self.G["clube"]]
        feito, recado = eng.definir_regime(self.G, c, nome)
        if feito:
            self.log(recado)
            self.status(recado, TEMA["ok"])
        self.mostrar("treino")

    def _rotulo_do_foco(self, foco):
        """O botao diz o que o clique VAI fazer, nao os dois caminhos."""
        sel = [int(i) for i in self.tv_treino.selection()]
        if sel and all(p in foco for p in sel):
            self.bt_foco.configure(text="Remover do treino individual")
        else:
            self.bt_foco.configure(text="Adicionar ao treino individual")

    def alternar_foco_selecao(self, tela):
        tv = self.tv_treino if tela == "treino" else self.tv_base
        sel = tv.selection()
        if not sel:
            messagebox.showinfo("Treino", AVISO_SELECAO)
            return
        c = self.G["clubes"][self.G["clube"]]
        for i in sel:
            feito, recado = eng.alternar_foco(self.G, c, int(i))
            self.log(recado)
            if not feito:
                messagebox.showwarning("Treino individual", recado)
                break
        self.atualizar_topo()
        self.mostrar(tela)

    def limpar_foco(self):
        c = self.G["clubes"][self.G["clube"]]
        c["treino_foco"] = []
        self.log("Treino individual esvaziado.")
        self.atualizar_topo()
        self.mostrar("treino")

    # --------------------------------------------------------------- escalacao
    def tela_escalacao(self, pai):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        esc, _ = eng.escalacao_valida(G, c)
        c["escalacao"] = esc
        at, de, _ = eng.forcas(G, c)
        auto = eng.escalacao_automatica(G, c)
        self.cabecalho_tela(pai, "Escalacao",
                            "Quem joga e como joga. O plano de jogo, mais abaixo, muda o time "
                            "sem trocar ninguem.  |  ataque %.1f   defesa %.1f   "
                            "selecione um titular e um reserva para trocar" % (at, de))

        modo = tk.Frame(pai, bg=TEMA["painel"])
        modo.pack(fill="x", padx=18, pady=(0, 8))
        interno = tk.Frame(modo, bg=TEMA["painel"])
        interno.pack(fill="x", padx=14, pady=8)
        self._alavanca(interno, auto).pack(side="right")
        rotulo(interno, "ESCALACAO %s" % ("AUTOMATICA" if auto else "MANUAL"),
               cor=TEMA["ok"] if auto else TEMA["av"], fonte=FONTE_B,
               bg=TEMA["painel"]).pack(side="left")
        rotulo(interno,
               "   a maquina monta o melhor time toda semana. Mexer aqui desliga a alavanca."
               if auto else
               "   o time e seu. So repomos quem nao pode jogar, nunca reotimizamos por cima.",
               cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["painel"]).pack(side="left")

        barra = tk.Frame(pai, bg=TEMA["fundo"])
        barra.pack(fill="x", padx=18, pady=(0, 8))
        rotulo(barra, "Formacao").pack(side="left")
        cb_form = ttk.Combobox(barra, values=list(eng.FORMACOES), width=9, state="readonly")
        cb_form.set(c["formacao"])
        cb_form.pack(side="left", padx=8)
        rotulo(barra, "Tatica").pack(side="left", padx=(12, 0))
        cb_tat = ttk.Combobox(barra, values=list(eng.TATICAS), width=16, state="readonly")
        cb_tat.set(c["tatica"])
        cb_tat.pack(side="left", padx=8)

        def aplicar(_=None):
            c["formacao"] = cb_form.get()
            c["tatica"] = cb_tat.get()
            c["escalacao"] = eng.auto_escalar(G, c)
            c["esc_stamp"] = ""
            self.atualizar_topo()
            self.mostrar("escalacao")
        cb_form.bind("<<ComboboxSelected>>", aplicar)
        cb_tat.bind("<<ComboboxSelected>>", aplicar)
        botao(barra, "Montar melhor time agora", aplicar).pack(side="left", padx=12)
        botao(barra, "Trocar selecionados", self.trocar_escalacao, cor=TEMA["acao"]).pack(side="left")
        self._plano_tatico(pai)

        corpo = tk.Frame(pai, bg=TEMA["fundo"])
        corpo.pack(fill="both", expand=True, padx=18, pady=6)
        cols = [("pos", "Vaga", 80, "center"), ("nome", "Jogador", 175, "w"),
                ("ovr", "Ovr", 45, "center"), ("fis", "Fisico", 55, "center"),
                ("for", "Forma", 55, "center"), ("sit", "Situacao", 135, "w")]
        esqf = tk.Frame(corpo, bg=TEMA["fundo"])
        esqf.pack(side="left", fill="both", expand=True, padx=(0, 8))
        rotulo(esqf, "TITULARES", cor=TEMA["fraco"]).pack(anchor="w")
        q1, self.tv_xi = grade(esqf, cols, altura=13)
        q1.pack(fill="both", expand=True)
        dirf = tk.Frame(corpo, bg=TEMA["fundo"])
        dirf.pack(side="left", fill="both", expand=True)
        rotulo(dirf, "BANCO E RESERVAS", cor=TEMA["fraco"]).pack(anchor="w")
        q2, self.tv_banco = grade(dirf, cols, altura=13)
        q2.pack(fill="both", expand=True)

        _, form = eng.escalacao_valida(G, c)
        for pid, vaga in eng.atribuir_vagas(G, esc, form):
            j = G["jogadores"][pid]
            fora = vaga != j["pos"]
            rotulo_vaga = "%s > %s" % (j["pos"], vaga) if fora else j["pos"]
            obs = ("improvisado, rende %d%%" % int(eng.AFINIDADE[j["pos"]][vaga] * 100)) if fora else ""
            self.tv_xi.insert("", "end", iid=str(pid),
                              values=(rotulo_vaga, j["nome"], j["ovr"], j["cond"], round(j["forma"]), obs),
                              tags=("aviso" if fora else tag_ovr(j["ovr"]),))
        resto = [p for p in c["elenco"] if p not in esc]
        resto.sort(key=lambda p: (not eng.disponivel(G, p), eng.POS.index(G["jogadores"][p]["pos"]),
                                  -eng.rendimento(G["jogadores"][p])))
        for pid in resto:
            j = G["jogadores"][pid]
            sit = eng.re.sub(r"\033\[[0-9;]*m", "", eng.situacao(G, j))
            self.tv_banco.insert("", "end", iid=str(pid),
                                 values=(j["pos"], j["nome"], j["ovr"], j["cond"], round(j["forma"]), sit),
                                 tags=("ruim" if not eng.disponivel(G, pid) else tag_ovr(j["ovr"]),))

    def _plano_tatico(self, pai):
        """Os cinco botoes que dizem COMO o time joga, nao so quem joga.

        A mentalidade (Tatica) segue sendo o eixo. Aqui vem o resto: onde
        pressiona, onde fica a linha, em que ritmo, por onde ataca e como sai
        jogando. Cada escolha mostra o proprio preco no rodape da coluna.
        """
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        plano = eng.plano_de(c)
        ef = eng.efeitos_plano(c)
        quadro = tk.Frame(pai, bg=TEMA["painel"])
        quadro.pack(fill="x", padx=18, pady=(0, 8))
        cab = tk.Frame(quadro, bg=TEMA["painel"])
        cab.pack(fill="x", padx=14, pady=(8, 2))
        rotulo(cab, "PLANO DE JOGO", cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["painel"]).pack(side="left")
        rotulo(cab, "   posse %+.0f  .  volume de chances x%.2f  .  qualidade x%.2f  ."
                    "  entrega x%.2f  .  fadiga %+.0f"
               % (ef["posse"] * 100, ef["volume"], ef["qualidade"], ef["concede"],
                  ef["fadiga"]),
               cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["painel"]).pack(side="left")
        botao_mini(cab, "voltar ao padrao", self.plano_padrao).pack(side="right")

        grade_p = tk.Frame(quadro, bg=TEMA["painel"])
        grade_p.pack(fill="x", padx=14, pady=(2, 10))
        for i, (eixo, tabela) in enumerate(eng.EIXOS_PLANO):
            col = tk.Frame(grade_p, bg=TEMA["painel"])
            col.grid(row=0, column=i, sticky="nsew", padx=(0, 10))
            rotulo(col, eixo.upper(), cor=TEMA["fraco"], fonte=FONTE_PB,
                   bg=TEMA["painel"]).pack(anchor="w")
            cb = ttk.Combobox(col, values=list(tabela), width=13, state="readonly")
            cb.set(plano[eixo])
            cb.pack(anchor="w", pady=2)
            cb.bind("<<ComboboxSelected>>",
                    lambda _e, x=eixo, w=cb: self.mudar_plano(x, w.get()))
            rotulo(col, corta(tabela[plano[eixo]]["desc"], 34), cor=TEMA["fraco"],
                   fonte=FONTE_P, bg=TEMA["painel"], wraplength=150,
                   justify="left").pack(anchor="w")
        for k in range(len(eng.EIXOS_PLANO)):
            grade_p.columnconfigure(k, weight=1, uniform="plano")

    def mudar_plano(self, eixo, valor):
        c = self.G["clubes"][self.G["clube"]]
        feito, recado = eng.definir_plano(self.G, c, eixo, valor)
        if feito:
            self.log(recado)
            self.status(recado, TEMA["ok"])
        self.mostrar("escalacao")

    def plano_padrao(self):
        c = self.G["clubes"][self.G["clube"]]
        c["plano"] = dict(eng.PLANO_PADRAO)
        c["esc_stamp"] = ""
        self.status("plano de jogo neutro", TEMA["fraco"])
        self.mostrar("escalacao")

    def trocar_escalacao(self):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        a = self.tv_xi.selection()
        b = self.tv_banco.selection()
        if not a or not b:
            messagebox.showinfo("BRASFUT", "Selecione um titular na esquerda e um reserva na direita.")
            return
        pa, pb = int(a[0]), int(b[0])
        if not eng.disponivel(G, pb):
            messagebox.showwarning("BRASFUT", "%s nao tem condicao de jogar." % G["jogadores"][pb]["nome"])
            return
        desligou = self._assumir_o_time()
        nova = c["escalacao"][:]
        nova[nova.index(pa)] = pb
        c["escalacao"] = nova
        c["esc_stamp"] = ""
        self.atualizar_topo()
        self.mostrar("escalacao")
        if desligou:
            self.status("voce mexeu no time: a escalacao automatica foi desligada", TEMA["av"])

    def _assumir_o_time(self):
        """Mexer na escalacao e dizer que voce quer o comando. A alavanca cede.

        Alternativa seria a maquina desfazer a troca na semana seguinte sem
        avisar, que e exatamente a reclamacao que a alavanca veio resolver.
        """
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        if not eng.escalacao_automatica(G, c):
            return False
        eng.definir_escalacao_automatica(G, False)
        return True

    # ------------------------------------------------------------------ tabela
    def tela_tabela(self, pai):
        """Series A a D e, no mesmo seletor, os estaduais do ano."""
        G = self.G
        meu_est = eng.meu_estadual(G)
        opcoes = ["Serie " + d for d in "ABCD"]
        self._torneios = {}
        for chave, est in sorted(eng.estaduais(G).items(),
                                 key=lambda kv: (-len(kv[1]["times"]), kv[1]["nome"])):
            opcoes.append(est["nome"])
            self._torneios[est["nome"]] = est
        inicial = (meu_est["nome"] if (meu_est and G["fase"] == "estadual")
                   else "Serie " + G["clubes"][G["clube"]]["divisao"])
        f = self.cabecalho_tela(pai, "Classificacao",
                                "o seletor tem as quatro series e os %d estaduais do ano"
                                % len(self._torneios))
        cb = ttk.Combobox(f, values=opcoes, width=26, state="readonly")
        cb.set(inicial)
        cb.pack(anchor="w", pady=4)
        corpo = tk.Frame(pai, bg=TEMA["fundo"])
        corpo.pack(fill="both", expand=True, padx=18, pady=6)

        def desenhar(_=None):
            for w in corpo.winfo_children():
                w.destroy()
            escolha = cb.get()
            if escolha in self._torneios:
                liga = self._torneios[escolha]
            else:
                liga = G["ligas"][escolha.replace("Serie ", "").strip()]
            q, tv = grade(corpo, [("pos", "", 35, "center"), ("clube", "Clube", 200, "w"),
                                  ("p", "P", 40, "center"), ("j", "J", 40, "center"),
                                  ("v", "V", 40, "center"), ("e", "E", 40, "center"),
                                  ("d", "D", 40, "center"), ("gp", "GP", 45, "center"),
                                  ("gc", "GC", 45, "center"), ("sg", "SG", 45, "center")],
                          altura=20)
            q.pack(fill="both", expand=True)
            ordem = eng.classificacao(G, liga)
            e_estadual = "campeao" in liga
            if e_estadual:
                titulo = ("%s - campeao: %s" % (liga["nome"], G["clubes"][liga["campeao"]]["nome"])
                          if liga["campeao"] else
                          "%s - rodada %d de %d" % (liga["nome"], liga["rodada"],
                                                    len(liga["rodadas"])))
                rotulo(corpo, titulo, cor=TEMA["top"] if liga["campeao"] else TEMA["fraco"],
                       fonte=FONTE_B).pack(anchor="w", pady=(0, 4))
            for i, cid in enumerate(ordem, 1):
                t = liga["tabela"][str(cid)]
                if e_estadual:
                    tag = "top" if i == 1 else ""
                else:
                    tag = "bom" if i <= 4 else ("ruim" if i > len(ordem) - 4 else "")
                if cid == G["clube"]:
                    tag = "meu"
                tv.insert("", "end", values=(i, G["clubes"][cid]["nome"], t["p"], t["j"], t["v"],
                                             t["e"], t["d"], t["gp"], t["gc"], t["gp"] - t["gc"]),
                          tags=(tag,))
        cb.bind("<<ComboboxSelected>>", desenhar)
        desenhar()


    # ------------------------------------------------------------------- copas
    def tela_copas(self, pai):
        G = self.G
        self.cabecalho_tela(pai, "Copas")
        for cp in G["copas"].values():
            card = tk.Frame(pai, bg=TEMA["painel"], padx=14, pady=10)
            card.pack(fill="x", padx=18, pady=4)
            rotulo(card, cp["nome"], fonte=FONTE_B, bg=TEMA["painel"]).pack(anchor="w")
