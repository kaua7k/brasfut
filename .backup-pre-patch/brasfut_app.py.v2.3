class NovoJogo(Dialogo):
    def __init__(self, pai, G):
        super().__init__(pai, "Comecar carreira", 700, 560)
        self.G = G
        rotulo(self.corpo, "Escolha o clube", fonte=FONTE_T).pack(anchor="w")
        rotulo(self.corpo, "REP e a reputacao do clube, de 12 a 99: ela define o dinheiro em "
                           "caixa, o publico no estadio e a forca do elenco que voce herda.",
               cor=TEMA["fraco"], wraplength=650, justify="left").pack(anchor="w")
        rotulo(self.corpo, "Se e a sua primeira vez, comece por um clube de reputacao alta na "
                           "Serie B: elenco bom, cobranca baixa e dinheiro para errar.",
               cor=TEMA["ok"], wraplength=650, justify="left").pack(anchor="w", pady=(2, 8))
        barra = tk.Frame(self.corpo, bg=TEMA["fundo"])
        barra.pack(fill="x", pady=4)
        rotulo(barra, "Divisao").pack(side="left")
        self.cb = ttk.Combobox(barra, values=["A", "B", "C", "D"], width=4, state="readonly")
        self.cb.set("B")
        self.cb.pack(side="left", padx=8)
        self.cb.bind("<<ComboboxSelected>>", lambda e: self.listar())
        q, self.tv = grade(self.corpo, [("nome", "Clube", 170, "w"), ("uf", "UF", 40, "center"),
                                        ("est", "Estadio", 170, "w"), ("cap", "Capacidade", 85, "e"),
                                        ("rep", "Rep", 45, "center"), ("cx", "Caixa", 95, "e"),
                                        ("el", "Elenco", 55, "center")], altura=14)
        q.pack(fill="both", expand=True, pady=8)
        self.tv.bind("<Double-1>", lambda e: self.confirmar())
        self.tv.bind("<<TreeviewSelect>>", lambda e: self.conferir_selecao())
        pe = tk.Frame(self.corpo, bg=TEMA["fundo"])
        pe.pack(fill="x")
        self.bt_ok = botao(pe, "Assumir este clube", self.confirmar, cor=TEMA["acao"])
        self.bt_ok.pack(side="right")
        self.lb_dica = rotulo(pe, "", cor=TEMA["av"])
        self.lb_dica.pack(side="left")
        self.listar()
        self.conferir_selecao()

    def listar(self):
        self.tv.delete(*self.tv.get_children())
        times = sorted([c for c in self.G["clubes"].values() if c["divisao"] == self.cb.get()],
                       key=lambda c: -c["reputacao"])
        for i, c in enumerate(times):
            # o primeiro da Serie B e a sugestao para quem nunca jogou
            sugerido = (self.cb.get() == "B" and i == 0)
            self.tv.insert("", "end", iid=str(c["id"]),
                           values=((c["nome"] + "   (sugerido)") if sugerido else c["nome"],
                                   c["uf"], c["estadio"],
                                   f"{c['capacidade']:,}".replace(",", "."), c["reputacao"],
                                   din(c["dinheiro"]), len(c["elenco"])),
                           tags=("bom",) if sugerido else ())
            if sugerido:
                self.tv.selection_set(str(c["id"]))

    def conferir_selecao(self):
        """O botao nao pode ficar clicavel sem nada marcado e nao fazer nada."""
        tem = bool(self.tv.selection())
        self.bt_ok.configure(state="normal" if tem else "disabled")
        self.lb_dica.configure(text="" if tem else "Marque um clube na lista para continuar.")

    def confirmar(self):
        sel = self.tv.selection()
        if not sel:
            self.lb_dica.configure(text="Marque um clube na lista para continuar.")
            return
        self.resultado = int(sel[0])
        self.destroy()


