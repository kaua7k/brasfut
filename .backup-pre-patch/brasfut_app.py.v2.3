                              # o ! avisa o ultimo ano: sem renovar ele sai de graca
                              "%d ano(s)%s" % (j["contrato"],
                                               " !" if j["contrato"] <= 1 and not j.get("dono")
                                               else ""),
                              din(j["listado"]) if j["listado"] else "-", sit), tags=(tag,))
        tv.bind("<Double-1>", lambda e: self.ficha_selecionada())
        tv.bind("<<TreeviewSelect>>", lambda e: self.resumo_selecao())

        self.lb_selecao = rotulo(pai, "nenhum jogador marcado", cor=TEMA["fraco"], fonte=FONTE_P)
        self.lb_selecao.pack(anchor="w", padx=18, pady=(6, 0))

        acoes = tk.Frame(pai, bg=TEMA["fundo"])
        acoes.pack(fill="x", padx=18, pady=8)
        botao(acoes, "Ver ficha", self.ficha_selecionada).pack(side="left", padx=(0, 6))
        botao(acoes, "Por a venda", lambda: self.acao_jogador("venda"),
              cor=TEMA["acao"]).pack(side="left", padx=6)
        botao(acoes, "Tirar da vitrine", lambda: self.acao_jogador("tirar")).pack(side="left", padx=6)
        botao(acoes, "Ceder emprestimo", lambda: self.acao_jogador("emprestar")).pack(side="left", padx=6)
        botao(acoes, "Renovar", lambda: self.acao_jogador("renovar")).pack(side="left", padx=6)
        botao(acoes, "Rescindir", lambda: self.acao_jogador("rescindir")).pack(side="left", padx=6)
        botao(acoes, "Comprar em definitivo",
              lambda: self.acao_jogador("opcao")).pack(side="left", padx=6)
        if not aberto:
            rotulo(pai, "Janela fechada: da para renovar e rescindir, nao para vender ou emprestar.",
                   cor=TEMA["av"], fonte=FONTE_P).pack(anchor="w", padx=18)

        # Quem eu cedi sai do elenco e antes simplesmente desaparecia da tela.
