        tk.Frame(faixa, bg=cr, width=4).pack(side="left", fill="y")
        glifo = {"critico": "X", "atencao": "!", "ok": "OK", "neutro": "-"}[d["estado"]]
        tk.Label(faixa, text=glifo, bg=TEMA["linha"], fg=cr, width=3, pady=2,
                 font=(FONTE[0], 12, "bold")).pack(side="left", padx=12, pady=14)
        if d["estado"] in ("critico", "atencao"):
            botao(faixa, "Abrir escalacao" if d["estado"] == "critico" else "Revisar escalacao",
                  lambda: self.mostrar("escalacao"), cor=TEMA["acao"]).pack(side="right", padx=16)
        elif d["estado"] == "neutro" and eng.mercado_aberto(self.G):
            botao(faixa, "Abrir mercado", lambda: self.mostrar("mercado"),
                  cor=TEMA["acao"]).pack(side="right", padx=16)
        texto = tk.Frame(faixa, bg=TEMA["painel"])
        texto.pack(side="left", fill="both", expand=True)
        rotulo(texto, d["titulo"], cor=cr, fonte=FONTE_M,
               bg=TEMA["painel"]).pack(anchor="w", pady=(8, 0))
        rotulo(texto, corta(d["detalhe"], 120), cor=TEMA["fraco"],
               bg=TEMA["painel"]).pack(anchor="w")

    # -------------------------------------------------------- card escalacao
    def _card_escalacao(self, pai, d):
        card = tk.Frame(pai, bg=TEMA["painel"])
        cab = tk.Frame(card, bg=TEMA["linha"], height=52)
        cab.pack(fill="x")
        cab.pack_propagate(False)

        alto = tk.Frame(cab, bg=TEMA["linha"])
        alto.pack(fill="x", padx=14, pady=(7, 0))
        rotulo(alto, "ESCALACAO", cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["linha"]).pack(side="left")
        marca = {"ok": "PRONTO", "atencao": "RESSALVA",
                 "critico": "QUEBRADO", "neutro": "SEM JOGO"}[d["estado"]]
        tk.Label(alto, text=marca, bg=TEMA["linha"], fg=cor_estado(d["estado"]),
                 font=FONTE_B, padx=10, highlightthickness=1,
                 highlightbackground=cor_estado(d["estado"])).pack(side="right")

        baixo = tk.Frame(cab, bg=TEMA["linha"])
        baixo.pack(fill="x", padx=14, pady=(2, 0))
        self._alavanca(baixo, d["auto"]).pack(side="right")
        rotulo(baixo, "AUTOMATICO" if d["auto"] else "MANUAL", fonte=FONTE_B,
               bg=TEMA["linha"]).pack(side="left")
        rotulo(baixo, "  o time se monta sozinho antes de cada jogo" if d["auto"]
               else "  o seu XI e soberano, so repomos quem nao pode jogar",
               cor=TEMA["fraco"], fonte=FONTE_P, bg=TEMA["linha"]).pack(side="left")

        tira = tk.Frame(card, bg=TEMA["painel"], height=28)
        tira.pack(fill="x", padx=14)
        tira.pack_propagate(False)
        for i, (txt, token) in enumerate(self._pastilhas(d)):
            if i:
                rotulo(tira, "|", cor=TEMA["borda"], fonte=FONTE_PB,
                       bg=TEMA["painel"]).pack(side="left", padx=7)
            rotulo(tira, txt, cor=TEMA[token], fonte=FONTE_PB,
                   bg=TEMA["painel"]).pack(side="left")

        cx = tk.Text(card, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO, relief="flat",
                     wrap="none", padx=10, pady=2, height=11, highlightthickness=0,
                     cursor="hand2")
        cx.pack(fill="both", expand=True)
        for nome, token in (("txt", "txt"), ("fraco", "fraco"), ("bom", "ok"),
                            ("ok", "ok"), ("av", "av"), ("ruim", "ruim"), ("top", "top")):
            cx.tag_configure(nome, foreground=TEMA[token])
        if not d["escalacao"]:
            cx.insert("end", "\n   Nenhum jogador apto. Contrate no Mercado antes de avancar.",
                      "fraco")
        for linha in self._linhas_xi(d):
            for trecho, tag in linha:
                cx.insert("end", trecho, tag)
            cx.insert("end", "\n")
        cx.configure(state="disabled")
        cx.bind("<Double-Button-1>", lambda _e: self.mostrar("escalacao"))
        return card

    def _alavanca(self, pai, ligada):
        """Nao existe switch no tkinter: sao dois rotulos que se revezam."""
        cx = tk.Frame(pai, bg=TEMA["borda"])
        for texto, valor in (("AUTO", True), ("MANUAL", False)):
            ativo = (valor == ligada)
            lb = tk.Label(cx, text=texto, width=8, pady=2, cursor="hand2",
                          bg=TEMA["acao"] if ativo else TEMA["borda"],
                          fg="white" if ativo else TEMA["fraco"],
                          font=FONTE_PB if ativo else FONTE_P)
            lb.pack(side="left", padx=2, pady=2)
            lb.bind("<Button-1>", lambda _e, v=valor: self.alternar_auto_escalacao(v))
            if not ativo:
                lb.bind("<Enter>", lambda e: e.widget.configure(bg=TEMA["linha"]))
                lb.bind("<Leave>", lambda e: e.widget.configure(bg=TEMA["borda"]))
        return cx

    def alternar_auto_escalacao(self, ligada):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        if eng.escalacao_automatica(G, c) == ligada:
            return
        eng.definir_escalacao_automatica(G, ligada)
        self.atualizar_topo()
        self.mostrar(self.view)
        self.status("escalacao automatica ligada - o XI foi remontado" if ligada
                    else "escalacao manual ligada - voce responde pelo XI",
                    TEMA["ok"] if ligada else TEMA["av"])

    def _pastilhas(self, d):
        """Ordem fixa. Posicao estavel e o que ensina o olho a varrer."""
        esc = d["escalacao"]
        fora = [p for p, v in d["improvisados"]]
        n_desf = len(d["desfalques"])
        graves = bool(d["graves"])
        curto = not self._painel_largo
        gol_ok = d["afinidade_minima"] >= 0.60
        return [
            ("%d/11" % len(esc) if curto else "%d/11 EM CAMPO" % len(esc),
             "ok" if len(esc) >= 11 else "ruim"),
            (("GOL OK" if gol_ok else "GOL IMPROV") if curto else
             ("GOLEIRO OK" if gol_ok else "GOL IMPROVISADO"),
             "ok" if gol_ok else "ruim"),
            (("%d IMPROV" % len(fora) if curto else "%d IMPROVISADO(S)" % len(fora))
             if fora else ("SEM IMPROV" if curto else "SEM IMPROVISO"),
             "ok" if not fora else ("ruim" if graves else "av")),
            (("%d DESF" % n_desf if curto else "%d DESFALQUE(S)" % n_desf)
             if n_desf else ("SEM DESF" if curto else "SEM DESFALQUE"),
             "ok" if not n_desf else ("ruim" if n_desf >= 4 or d["aptos"] < 14 else "av")),
        ]

    def _linhas_xi(self, d):
        """Cada titular em uma linha, com a vaga real e o preco do improviso."""
        jogs = self.G["jogadores"]
        linhas = []
        for pid, vaga in d["vagas"]:
            j = jogs[pid]
            improvisado = vaga != j["pos"]
            afin = eng.AFINIDADE[j["pos"]][vaga]
            tag_vaga = "txt"
            if improvisado:
                tag_vaga = "ruim" if afin < 0.60 else "av"
            obs, tag_obs = "", "fraco"
            if improvisado:
                obs, tag_obs = "rende %d%%" % int(afin * 100), tag_vaga
            elif j["cond"] < 45:
                obs, tag_obs = "desgastado", "ruim"
            elif j.get("amar", {}).get("liga", 0) >= 2:
                obs, tag_obs = "pendurado", "av"
            tag_fis = "ruim" if j["cond"] < 45 else ("av" if j["cond"] < 65 else "txt")
            tag_nome = tag_ovr(j["ovr"]) or "txt"
            linhas.append([
                ("%-11s" % ("%s > %s" % (j["pos"], vaga) if improvisado else j["pos"]), tag_vaga),
                ("%-23s" % corta(j["nome"], 22), tag_nome),
                ("%3d" % j["ovr"], tag_nome),
                ("  fis %3d  " % j["cond"], tag_fis),
                (obs, tag_obs)])
        for _ in range(11 - len(d["vagas"])):
            linhas.append([("%-11s" % "---", "ruim"), ("%-23s" % "VAGA ABERTA", "ruim"),
                           (" --", "ruim"), ("  fis  --  ", "ruim"),
                           ("sem jogador apto", "ruim")])
        return linhas

    # ------------------------------------------------------- card proximo jogo
    def _faixa_pretemporada(self, pai):
        """Pre-temporada tem que ser inconfundivel: e a unica fase em que
        avancar nao joga semana nenhuma e em que tudo ainda esta em aberto."""
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        faixa = tk.Frame(pai, bg=TEMA["painel"], height=self._alt_faixa)
        faixa.pack(fill="x", padx=18, pady=(6, 8))
        faixa.pack_propagate(False)
        tk.Frame(faixa, bg=TEMA["ok"], width=4).pack(side="left", fill="y")
        tk.Label(faixa, text="OK", bg=TEMA["linha"], fg=TEMA["ok"], width=3, pady=2,
                 font=(FONTE[0], 12, "bold")).pack(side="left", padx=12, pady=14)
        acoes = tk.Frame(faixa, bg=TEMA["painel"])
        acoes.pack(side="right", padx=16)
        if G.get("ultimo_resumo"):
            botao(acoes, "Ver resumo da temporada %d" % G["ultimo_resumo"]["temporada"],
                  self.ver_resumo_temporada).pack(side="right", padx=(6, 0))
        botao(acoes, "Comecar o ano %d" % G["temporada"], self.avancar,
              cor=TEMA["ok"]).pack(side="right")
        texto = tk.Frame(faixa, bg=TEMA["painel"])
        texto.pack(side="left", fill="both", expand=True)
        rotulo(texto, "PRE-TEMPORADA %d" % G["temporada"], cor=TEMA["ok"], fonte=FONTE_M,
               bg=TEMA["painel"]).pack(anchor="w", pady=(8, 0))
        pend = []
        est = eng.meu_estadual(G)
        if est:
            pend.append("o ano abre com o %s (%d rodadas)" % (est["nome"], len(est["rodadas"])))
        vencidos = sum(1 for p in c["elenco"] if G["jogadores"][p]["contrato"] <= 0
                       and not G["jogadores"][p].get("dono"))
        if vencidos:
            pend.append("%d contrato(s) vencido(s) para renovar" % vencidos)
        prontos = sum(1 for j in eng.elenco_base(G, c) if eng.pronto_para_subir(G, c, j))
        if prontos:
            pend.append("%d garoto(s) da base pronto(s) para subir" % prontos)
        if len(c["elenco"]) < 18:
            pend.append("elenco com so %d jogadores" % len(c["elenco"]))
        rotulo(texto, ("Antes de comecar: " + ", ".join(pend)) if pend else
               "Mercado aberto, elenco em ordem. Comece quando quiser.",
               cor=TEMA["av"] if pend else TEMA["fraco"], bg=TEMA["painel"]).pack(anchor="w")
        return faixa

    def _card_proximo(self, pai, d):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        card = tk.Frame(pai, bg=TEMA["painel"], height=170 if self._painel_alto else 148)
        card.pack_propagate(False)
        corpo = tk.Frame(card, bg=TEMA["painel"])
        corpo.pack(fill="both", expand=True, padx=14, pady=(10, 4))
        rotulo(corpo, "PROXIMO JOGO", cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["painel"]).pack(anchor="w")

        comp, adv, em_casa, extras = self._proximo_confronto()
        if G["fase"] == "entretemporada":
            rotulo(corpo, "Pre-temporada", fonte=FONTE_M, bg=TEMA["painel"]).pack(anchor="w")
            rotulo(corpo, "o calendario comeca quando voce avancar", cor=TEMA["fraco"],
                   bg=TEMA["painel"]).pack(anchor="w")
            return card
        if comp is None:
            rotulo(corpo, "Semana livre", fonte=FONTE_M, bg=TEMA["painel"]).pack(anchor="w")
            rotulo(corpo, "sem jogo nesta rodada", cor=TEMA["fraco"],
                   bg=TEMA["painel"]).pack(anchor="w")
            rotulo(corpo, "Bom momento para descansar o elenco\ne mexer no mercado.",
                   cor=TEMA["fraco"], bg=TEMA["painel"], justify="left").pack(anchor="w", pady=(8, 0))
            return card

        if adv is not None:
            nome_adv = G["clubes"][adv]["nome"]
            forte = G["clubes"][adv]["reputacao"] > c["reputacao"]
            rotulo(corpo, corta(nome_adv, 28), fonte=FONTE_M,
                   cor=TEMA["top"] if forte else TEMA["txt"], bg=TEMA["painel"]).pack(anchor="w")
            onde = "em casa" if em_casa else "fora"
            sub = tk.Frame(corpo, bg=TEMA["painel"])
            sub.pack(anchor="w")
            rotulo(sub, onde, cor=TEMA["ok"] if em_casa else TEMA["av"], fonte=FONTE_P,
                   bg=TEMA["painel"]).pack(side="left")
            if comp == "estadual":
                est = eng.meu_estadual(G)
                legenda = " . %s . rodada %d" % (corta(est["nome"], 22) if est else "Estadual",
                                                 int(G.get("semana_est", 1)))
            else:
                legenda = " . Serie %s . rodada %d" % (c["divisao"],
                                                       G["ligas"][c["divisao"]]["rodada"] + 1)
            rotulo(sub, legenda, cor=TEMA["fraco"], fonte=FONTE_P,
                   bg=TEMA["painel"]).pack(side="left")
            if extras:
                rotulo(sub, "  +%d jogo(s) na semana" % extras, cor=TEMA["av"],
                       fonte=FONTE_P, bg=TEMA["painel"]).pack(side="left")
            at_adv, de_adv, _ = eng.forcas(G, G["clubes"][adv])
        else:
            copa = G["copas"].get(comp)
            rotulo(corpo, corta(copa["nome"] if copa else "Jogo do calendario", 28),
                   fonte=FONTE_M, bg=TEMA["painel"]).pack(anchor="w")
            rotulo(corpo, "adversario definido no sorteio", cor=TEMA["fraco"], fonte=FONTE_P,
                   bg=TEMA["painel"]).pack(anchor="w")
            at_adv = de_adv = None
        cab = tk.Frame(corpo, bg=TEMA["painel"])
        if self._painel_alto:
            cab.pack(fill="x", pady=(6, 0))
        rotulo(cab, "", bg=TEMA["painel"], width=8, fonte=FONTE_PB).pack(side="left")
        rotulo(cab, "EU", cor=TEMA["fraco"], fonte=FONTE_PB, bg=TEMA["painel"],
               width=7, anchor="e").pack(side="left")
        rotulo(cab, "", bg=TEMA["painel"], width=3).pack(side="left")
        rotulo(cab, "ELES", cor=TEMA["fraco"], fonte=FONTE_PB, bg=TEMA["painel"],
               width=7, anchor="e").pack(side="left")
        self._linha_forca(corpo, "ATAQUE", d["ataque"], at_adv)
        self._linha_forca(corpo, "DEFESA", d["defesa"], de_adv)
        return card

    def _linha_forca(self, pai, nome, meu, dele):
        """O operador repete o que a cor diz: quem nao ve cor continua lendo."""
        f = tk.Frame(pai, bg=TEMA["painel"])
        f.pack(fill="x")
        if dele is None:
            razao, sinal, cr = 1.0, " ", TEMA["txt"]
        else:
            razao = meu / max(dele, 0.1)
            sinal = ">" if meu > dele else ("<" if meu < dele else "=")
            cr = TEMA["ok"] if razao >= 1.05 else (TEMA["txt"] if razao >= 0.92 else TEMA["ruim"])
        rotulo(f, nome, cor=TEMA["fraco"], bg=TEMA["painel"], width=8).pack(side="left")
        rotulo(f, "%.1f" % meu, cor=cr, fonte=FONTE_N, bg=TEMA["painel"],
               width=5, anchor="e").pack(side="left")
        rotulo(f, sinal, cor=cr, fonte=FONTE_B, bg=TEMA["painel"],
               width=3, anchor="center").pack(side="left")
        rotulo(f, "--" if dele is None else "%.1f" % dele, cor=TEMA["fraco"], fonte=FONTE_N,
               bg=TEMA["painel"], width=5, anchor="e").pack(side="left")

    def _proximo_confronto(self):
        """(competicao, adversario, em_casa, quantos outros jogos na semana)."""
        G = self.G
        jogos = eng.jogos_da_semana(G, G["clube"])
        if not jogos:
            return None, None, None, 0
        for comp, casa, fora in jogos:
            # liga e estadual tem mando definido; copa so depois do sorteio
            if comp in ("liga", "estadual") and casa is not None:
                adv = fora if casa == G["clube"] else casa
                return comp, adv, casa == G["clube"], len(jogos) - 1
        return jogos[0][0], None, None, len(jogos) - 1

    # ---------------------------------------------------------- card objetivo
    def _card_objetivo(self, pai):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        card = tk.Frame(pai, bg=TEMA["painel"], height=116 if self._painel_alto else 96)
        card.pack_propagate(False)
        corpo = tk.Frame(card, bg=TEMA["painel"])
        corpo.pack(fill="both", expand=True, padx=14, pady=10)
        rotulo(corpo, "OBJETIVO DA TEMPORADA", cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["painel"]).pack(anchor="w")
        rotulo(corpo, corta(G["objetivo"], 46), fonte=FONTE_B, bg=TEMA["painel"],
               wraplength=336, justify="left").pack(anchor="w")

        liga = G["ligas"][c["divisao"]]
        total = max(1, len(liga["times"]))
        alvo = G.get("objetivo_alvo", 16)
        comecou = liga["rodada"] > 0
        pos = eng.posicao_na_liga(G, c["id"]) if comecou else total
        estado, fala = self._pressao_diretoria(pos, alvo, comecou)
        cr = cor_estado(estado)

        largura = 336
        barra = tk.Canvas(corpo, height=10, width=largura, bg=TEMA["linha"],
                          highlightthickness=0)
        barra.pack(anchor="w", pady=(6, 4))
        if comecou:
            cheio = int(largura * (total - pos + 1) / float(total))
            barra.create_rectangle(0, 0, cheio, 10, fill=cr, width=0)
        marca = int(largura * (total - alvo + 1) / float(total))
        barra.create_rectangle(marca - 1, 0, marca + 1, 10, fill=TEMA["txt"], width=0)

        if not comecou:
            rotulo(corpo, "temporada nao comecou . meta: top %d" % alvo, cor=TEMA["fraco"],
                   bg=TEMA["painel"]).pack(anchor="w")
            return card
        folga = alvo - pos
        sufixo = (" . %d de folga" % folga) if folga >= 0 else (" . faltam %d" % -folga)
        rotulo(corpo, "%do de %d . meta top %d%s"
               % (pos, total, alvo, sufixo if self._painel_largo else ""),
               cor=cr, bg=TEMA["painel"]).pack(anchor="w")
        if self._painel_alto:
            rotulo(corpo, "Diretoria: %s" % fala, cor=cr, fonte=FONTE_P,
                   bg=TEMA["painel"]).pack(anchor="w")
        return card

    def _pressao_diretoria(self, pos, alvo, comecou):
        if not comecou:
            return "neutro", "aguardando a bola rolar"
        if pos > 16:
            return "critico", "rebaixamento demite na hora"
        if pos <= alvo:
            return "ok", "tranquila"
        if pos <= alvo + 2:
            return "atencao", "cobrando resultado"
        if self.G["semana"] <= 22:
            return "atencao", "fora da meta, ainda da tempo"
        return "critico", "risco real de demissao"

    # ------------------------------------------------------------ card tabela
    def _card_tabela(self, pai):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        card = tk.Frame(pai, bg=TEMA["painel"])
        card.pack_propagate(False)
        est = eng.meu_estadual(G) if G["fase"] == "estadual" else None
        rotulo(card, ("%s" % est["nome"].upper()) if est else ("TABELA . SERIE %s" % c["divisao"]),
               cor=TEMA["fraco"], fonte=FONTE_PB,
               bg=TEMA["painel"]).pack(anchor="w", padx=14, pady=(8, 2))
        liga = est or G["ligas"][c["divisao"]]
        altura = self._linhas_grade
        q, tv = grade(card, [("pos", "", 34, "center"), ("clube", "Clube", 140, "w"),
                             ("p", "P", 32, "center"), ("j", "J", 32, "center"),
                             ("sg", "SG", 36, "center")], altura=altura)
        q.configure(bg=TEMA["painel"])
        q.pack(fill="both", expand=True, padx=10)
        if liga["rodada"] <= 0 or c["id"] not in liga["times"]:
            tv.insert("", "end", values=("", "Ainda nao comecou." if liga["rodada"] <= 0
                                         else "Seu clube nao esta neste torneio.", "", "", ""),
                      tags=("fraco",))
            return card
        ordem = eng.classificacao(G, liga)
        meu = ordem.index(c["id"])
        raio = altura // 2
        ini = max(0, min(meu - raio, len(ordem) - altura))
        tv.tag_configure("eu", background=TEMA["linha"], foreground=TEMA["txt"])
        for i in range(ini, min(len(ordem), ini + altura)):
            cid = ordem[i]
            t = liga["tabela"][str(cid)]
            tag = "bom" if i < 4 else ("ruim" if i >= len(ordem) - 4 else "")
            marca = "%d" % (i + 1)
            if cid == c["id"]:
                tag, marca = "eu", "> %d" % (i + 1)
            tv.insert("", "end", values=(marca, corta(G["clubes"][cid]["nome"], 18),
                                         t["p"], t["j"], t["gp"] - t["gc"]), tags=(tag,))
        tv.bind("<Double-Button-1>", lambda _e: self.mostrar("tabela"))
        return card

