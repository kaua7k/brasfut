                            ("sal", "Salario mensal", 120, "e"), ("obs", "Observacao", 220, "w")],
                      altura=6)
        q.pack(fill="x", padx=18)
        for j in sorted([G["jogadores"][p] for p in c["elenco"]], key=lambda x: -x["salario"])[:6]:
            obs = "" if not j.get("dono") else "emprestado, pagamos %d%%" % j["emp_pct"]
            tv.insert("", "end", values=(j["nome"], j["pos"], din(j["salario"]), obs))

    # ----------------------------------------------------------------- estadio
    def tela_estadio(self, pai):
