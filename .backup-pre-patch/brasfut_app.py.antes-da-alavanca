    def confirmar(self):
        try:
            v = int(self.entrada.get().replace(".", "").replace(",", ""))
        except ValueError:
            return
        self.j["listado"] = max(0, v)
        self.resultado = "%s esta na vitrine por %s." % (self.j["nome"], din(v))
        self.destroy()


class Renovar(Dialogo):
    def __init__(self, pai, G, j):
        super().__init__(pai, "Renovar " + j["nome"], 500, 320)
        self.G, self.j = G, j
        self.pedido = int(j["salario"] * eng.rng.uniform(1.05, 1.45))
        if j["idade"] <= 23 and j["pot"] - j["ovr"] > 8:
            self.pedido = int(self.pedido * 1.15)
        self.rodada = 0
        rotulo(self.corpo, j["nome"], fonte=FONTE_T).pack(anchor="w")
        rotulo(self.corpo, "Contrato atual: %d ano(s), %s por mes" % (j["contrato"], din(j["salario"])),
               cor=TEMA["fraco"]).pack(anchor="w", pady=(0, 8))
        rotulo(self.corpo, "Ele pede algo perto de %s por mes." % din(self.pedido),
               cor=TEMA["av"]).pack(anchor="w")
        rotulo(self.corpo, "\nSalario oferecido", fonte=FONTE_B).pack(anchor="w")
        self.e_sal = tk.Entry(self.corpo, width=14, bg=TEMA["painel"], fg=TEMA["txt"], relief="flat",
                              font=MONO, insertbackground=TEMA["txt"])
        self.e_sal.pack(anchor="w", pady=4)
        rotulo(self.corpo, "Anos (1 a 5)").pack(anchor="w")
        self.e_anos = tk.Entry(self.corpo, width=6, bg=TEMA["painel"], fg=TEMA["txt"], relief="flat",
                               font=MONO, insertbackground=TEMA["txt"])
        self.e_anos.insert(0, "3")
        self.e_anos.pack(anchor="w", pady=4)
        botao(self.corpo, "Propor renovacao", self.confirmar, cor=TEMA["acao"]).pack(anchor="w", pady=8)
        self.lb = rotulo(self.corpo, "", cor=TEMA["fraco"])
        self.lb.pack(anchor="w")

    def confirmar(self):
        try:
            sal = int(self.e_sal.get().replace(".", "").replace(",", ""))
            anos = int(eng.clamp(int(self.e_anos.get()), 1, 5))
        except ValueError:
            return
        if sal >= self.pedido:
            self.j["salario"] = sal
            self.j["contrato"] = anos
            self.j["moral"] = eng.clamp(self.j["moral"] + 12, 5, 100)
            self.resultado = "%s renovou por %d ano(s), %s por mes." % (self.j["nome"], anos, din(sal))
            messagebox.showinfo("Renovacao", self.resultado)
            self.destroy()
            return
        self.rodada += 1
        if self.rodada >= 3:
            self.j["moral"] = eng.clamp(self.j["moral"] - 8, 5, 100)
            self.resultado = "%s recusou renovar e vai ouvir o mercado." % self.j["nome"]
            messagebox.showinfo("Renovacao", self.resultado)
            self.destroy()
            return
        self.lb.configure(text="Recusado. O empresario insiste nos %s." % din(self.pedido))


