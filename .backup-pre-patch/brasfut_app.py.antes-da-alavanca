                                relief="flat", font=MONO, insertbackground=TEMA["txt"])
        self.entrada.pack(anchor="w", pady=4)
        self.entrada.bind("<Return>", lambda e: self.enviar())
        botao(self.corpo, "Enviar proposta", self.enviar, cor=TEMA["acao"]).pack(anchor="w", pady=6)
        self.dialogo = tk.Text(self.corpo, bg=TEMA["painel"], fg=TEMA["txt"], font=MONO,
                               relief="flat", wrap="word", padx=10, pady=8, height=8)
        self.dialogo.pack(fill="both", expand=True, pady=8)
        self.atualiza_etapa()
        self.entrada.focus_set()

    def fala(self, txt):
        self.dialogo.configure(state="normal")
        self.dialogo.insert("end", txt + "\n")
        self.dialogo.see("end")
        self.dialogo.configure(state="disabled")

    def atualiza_etapa(self):
        textos = {"passe": "Quanto voce oferece pelo passe? (em reais)",
                  "anos": "Anos de contrato (1 a 5)",
                  "salario": "Salario mensal oferecido ao jogador? (em reais)"}
        self.lb_etapa.configure(text=textos[self.etapa])

    def _prop(self, **kw):
        base = dict(jogador=self.j["id"], comprador=self.c["id"], valor=self.passe_fechado,
                    salario=self.salario, anos=self.anos)
        base.update(kw)
        return eng.Proposta(**base)

    def encerra(self, texto):
        self.resultado = texto
        self.fala(texto)
        self.after(900, self.destroy)

    def enviar(self):
        try:
            v = int(self.entrada.get().replace(".", "").replace(",", ""))
        except ValueError:
            return
        self.entrada.delete(0, "end")
        if self.etapa == "passe":
            r = eng.avaliar_clube(self.G, self._prop(valor=v))
            self.fala(r.motivo)
            if r.aceita:
                self.passe_fechado = v
                self.etapa = "anos"
                self.rodada = 0
            elif r.encerrada:
                self.encerra("Negociacao por %s encerrada." % self.j["nome"])
                return
            else:
                self.rodada += 1
                if self.rodada >= 3:
                    self.encerra("Sem acordo pelo passe de %s." % self.j["nome"])
                    return
        elif self.etapa == "anos":
            self.anos = int(eng.clamp(v, 1, 5))
            self.etapa = "salario"
            self.fala("Contrato de %d ano(s). Agora o salario." % self.anos)
        else:
            prop = self._prop(salario=v)
            r = eng.avaliar_jogador(self.G, prop)
            self.fala(r.motivo)
            if r.aceita:
                self.encerra(eng.fechar_compra(self.G, prop))
                return
            if r.encerrada:
                self.encerra("%s recusou a proposta." % self.j["nome"])
                return
            self.rodada += 1
            if self.rodada >= 3:
                self.encerra("%s nao chegou a um acordo salarial." % self.j["nome"])
                return
        self.atualiza_etapa()


