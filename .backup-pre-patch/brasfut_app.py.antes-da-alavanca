        sel = self.tv_mercado.selection()
        if not sel:
            messagebox.showinfo("BRASFUT", "Selecione um jogador na lista.")
            return None
        return self.G["jogadores"][int(sel[0])]

    def ficha_mercado(self):
        j = self.alvo_mercado()
        if j:
            Ficha(self, self.G, j).esperar()

    def negociar(self):
        j = self.alvo_mercado()
        if not j:
            return
        if not eng.mercado_aberto(self.G):
            messagebox.showinfo("BRASFUT", "A janela de transferencias esta fechada.")
            return
        tipo = self.tipo_mercado.get()
        if tipo == "Emprestimo":
            texto = PegarEmprestado(self, self.G, j).esperar()
        else:
            texto = Negociar(self, self.G, j).esperar()
        if texto:
            self.log(texto)
        self.atualizar_topo()
        self.mostrar("mercado")

    def ver_propostas(self):
        G, c = self.G, self.G["clubes"][self.G["clube"]]
        alvos = [G["jogadores"][p] for p in c["elenco"]
                 if G["jogadores"][p]["listado"] and not G["jogadores"][p].get("dono")]
        if not alvos:
            messagebox.showinfo("BRASFUT", "Nenhum jogador seu esta a venda.\nUse o Elenco para por alguem na vitrine.")
            return
        ofertas = []
        for j in alvos:
            agressivo = eng.clamp(1.6 - j["listado"] / max(1.0, j["valor"] * 1.4), 0.05, 0.95)
            compradores = [cl for cl in G["clubes"].values()
                           if cl["divisao"] != "EX" and cl["id"] != c["id"]
                           and cl["dinheiro"] > j["listado"] * 1.2
                           and cl["reputacao"] > j["ovr"] - 24]
            if compradores and eng.rng.random() < agressivo:
                cl = eng.rng.choice(compradores)
                ofertas.append((j, cl, int(j["listado"] * eng.rng.uniform(0.72, 1.10))))
        if not ofertas:
            messagebox.showinfo("BRASFUT", "Nenhuma proposta chegou nesta semana.\nTalvez o preco esteja alto.")
            return
        texto = Propostas(self, self.G, ofertas).esperar()
        if texto:
            self.log(texto)
        self.atualizar_topo()
        self.mostrar("mercado")

